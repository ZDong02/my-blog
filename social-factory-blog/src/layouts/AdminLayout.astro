---
import Navbar from "../components/Navbar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import AuthProvider from "../components/AuthProvider.astro";
import Toast from "../components/Toast.astro";
import "../styles/global.css";

const { title = "管理面板", description = "博客管理" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-neutral-100 dark:bg-neutral-900 text-neutral-900 dark:text-white font-sans antialiased">
    <AuthProvider />
    <Toast />

    <div class="flex min-h-screen">
      <!-- Sidebar -->
      <aside class="w-72 glass-strong border-r-2 border-neutral-900/10 dark:border-white/10 fixed h-full flex flex-col">

        <!-- Logo -->
        <div class="p-6 border-b-2 border-neutral-900/10 dark:border-white/10">
          <a href="/" class="flex items-center gap-3">
            <span class="text-2xl font-black text-neutral-900 dark:text-white">社会工厂</span>
          </a>
          <p class="text-xs font-bold uppercase tracking-widest text-neutral-500 mt-2">管理后台</p>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 p-4 space-y-2">
          <a href="/admin" class="admin-nav-link flex items-center gap-4 px-5 py-4 text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:bg-brand-red hover:text-white transition-colors cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            仪表盘
          </a>
          <a href="/admin/posts" class="admin-nav-link flex items-center gap-4 px-5 py-4 text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:bg-brand-red hover:text-white transition-colors cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
            文章管理
          </a>
          <a href="/admin/categories" class="admin-nav-link flex items-center gap-4 px-5 py-4 text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:bg-brand-red hover:text-white transition-colors cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
            分类管理
          </a>
          <a href="/admin/music" class="admin-nav-link flex items-center gap-4 px-5 py-4 text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:bg-brand-red hover:text-white transition-colors cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
            </svg>
            音乐管理
          </a>
          <a href="/admin/users" class="admin-nav-link flex items-center gap-4 px-5 py-4 text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:bg-brand-red hover:text-white transition-colors cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
            用户管理
          </a>
          <a href="/dashboard" class="admin-nav-link flex items-center gap-4 px-5 py-4 text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:bg-brand-red hover:text-white transition-colors cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            个人资料
          </a>
        </nav>

        <!-- Footer -->
        <div class="p-4 border-t-2 border-neutral-900/10 dark:border-white/10">
          <a href="/" class="flex items-center gap-4 px-5 py-4 text-sm font-bold uppercase tracking-widest text-neutral-500 hover:text-brand-red transition-colors cursor-pointer">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            返回网站
          </a>
        </div>
      </aside>

      <!-- Main content -->
      <main class="flex-1 ml-72">
        <slot />
      </main>
    </div>

    <ThemeToggle />

    <script>
      // Highlight current nav link
      document.addEventListener('DOMContentLoaded', () => {
        const currentPath = window.location.pathname;
        document.querySelectorAll('.admin-nav-link').forEach(link => {
          if (link.getAttribute('href') === currentPath) {
            link.classList.add('bg-brand-red', 'text-white');
          }
        });
      });

      // Auth guard - redirect if not authenticated or not admin
      (async function() {
        const publicAdminPaths = ['/admin/login', '/admin/register'];
        const currentPath = window.location.pathname;

        if (publicAdminPaths.includes(currentPath)) return;

        const token = localStorage.getItem('auth_token');
        const refreshToken = localStorage.getItem('refresh_token');

        if (!token || !refreshToken) {
          window.location.href = '/admin/login';
          return;
        }

        // Directly call profile API to verify admin role
        const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:8080/api';

        try {
          const response = await fetch(`${API_BASE_URL}/users/profile`, {
            headers: {
              'Authorization': `Bearer ${token}`
            }
          });

          if (!response.ok) {
            window.location.href = '/admin/login';
            return;
          }

          const data = await response.json();
          if (!data.success || !data.data || data.data.role !== 'ADMIN') {
            window.location.href = '/';
          }
        } catch (error) {
          console.error('Auth guard error:', error);
          window.location.href = '/admin/login';
        }
      })();
    </script>
  </body>
</html>
