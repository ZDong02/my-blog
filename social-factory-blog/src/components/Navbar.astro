  <script>
    // @ts-nocheck
    // Setup user dropdown menu - runs once on DOMContentLoaded
    function setupUserDropdown() {
      const userMenuButton = document.getElementById('user-menu-button');
      const userDropdown = document.getElementById('user-dropdown');

      if (!userMenuButton || !userDropdown) return;

      // Toggle dropdown on button click
      userMenuButton.onclick = (e) => {
        e.stopPropagation();
        userDropdown.classList.toggle('hidden');
      };

      // Close dropdown when clicking outside
      document.addEventListener('click', (e) => {
        if (!userDropdown.contains(e.target) && e.target !== userMenuButton) {
          userDropdown.classList.add('hidden');
        }
      });
    }

    // Auth state management
    function updateAuthUI(user, isAuthenticated) {
      const desktopAuthLinks = document.getElementById('desktop-auth-links');
      const desktopUserInfo = document.getElementById('desktop-user-info');
      const desktopAdminLink = document.getElementById('desktop-admin-link');
      const desktopLogoutBtn = document.getElementById('desktop-logout-btn');
      const desktopUsername = document.getElementById('desktop-username');
      const desktopUserAvatar = document.getElementById('desktop-user-avatar');

      const mobileAuthLinks = document.getElementById('mobile-auth-links');
      const mobileUserInfo = document.getElementById('mobile-user-info');
      const mobileUsernameLink = document.getElementById('mobile-username-link');
      const mobileUserAvatar = document.getElementById('mobile-user-avatar');
      const mobileAdminLink = document.getElementById('mobile-admin-link');
      const mobileLogoutBtn = document.getElementById('mobile-logout-btn');

      if (isAuthenticated && user) {
        // Show user info
        desktopAuthLinks.classList.add('hidden');
        desktopUserInfo.classList.remove('hidden');
        mobileAuthLinks.classList.add('hidden');
        mobileUserInfo.classList.remove('hidden');

        // Set username and avatar
        const displayName = user.nickname || user.username;
        const defaultAvatar = '/images/default-avatar.svg';
        const avatar = user.avatar || defaultAvatar;

        desktopUsername.textContent = displayName;
        desktopUserAvatar.src = avatar;
        desktopUserAvatar.onerror = () => { desktopUserAvatar.src = defaultAvatar; };

        mobileUsernameLink.textContent = displayName;
        mobileUserAvatar.src = avatar;
        mobileUserAvatar.onerror = () => { mobileUserAvatar.src = defaultAvatar; };

        // Show admin link if admin
        const isAdmin = user.role === 'ADMIN';
        desktopAdminLink.classList.toggle('hidden', !isAdmin);
        mobileAdminLink.classList.toggle('hidden', !isAdmin);

        // Logout handlers
        desktopLogoutBtn.onclick = handleLogout;
        mobileLogoutBtn.onclick = handleLogout;
      } else {
        // Show auth links
        desktopAuthLinks.classList.remove('hidden');
        desktopUserInfo.classList.add('hidden');
        mobileAuthLinks.classList.remove('hidden');
        mobileUserInfo.classList.add('hidden');
      }
    }

    async function handleLogout() {
      if (window.authManager) {
        await window.authManager.logout();
        window.location.href = '/';
      }
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
      // Setup dropdown menu (always runs once)
      setupUserDropdown();

      // Setup auth state listeners
      if (window.authManager) {
        window.authManager.addListener(({ user, isAuthenticated }) => {
          updateAuthUI(user, isAuthenticated);
        });

        // Initial auth state
        const authState = window.authManager.getAuthState();
        updateAuthUI(authState.user, authState.isAuthenticated);
      }
    });

    // Also update immediately if auth is already loaded
    if (window.authManager) {
      const authState = window.authManager.getAuthState();
      if (!authState.isLoading) {
        updateAuthUI(authState.user, authState.isAuthenticated);
      }
    }
  </script>
