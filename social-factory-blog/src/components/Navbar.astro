---
const { transparent = false } = Astro.props;
---

<nav
  id="navbar"
  class="fixed top-4 left-4 right-4 z-50 glass-strong rounded-none lg:rounded-2xl transition-all duration-500"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-4 group">
        <div class="relative">
          <span class="text-2xl lg:text-3xl font-black tracking-tighter text-neutral-900 dark:text-white transition-transform duration-300 group-hover:scale-105">
            社会工厂
          </span>
          <div class="absolute -bottom-1 left-0 w-0 h-1 bg-brand-red transition-all duration-300 group-hover:w-full"></div>
        </div>
        <img
          src="/images/V1.jpg"
          alt="Social Factory Blog"
          class="h-10 w-auto border-2 border-neutral-900 dark:border-white transition-transform duration-300 group-hover:rotate-3"
        />
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-8">
        <a href="/blog" class="nav-link">博客</a>
        <a href="/about" class="nav-link">关于</a>
        <a href="/roadmap" class="nav-link">路线</a>
        <a href="/music" class="nav-link">音乐</a>
        <a href="/faq" class="nav-link">问答</a>
        <a href="/contact" class="nav-link">联系</a>
      </div>

      <!-- Search Box -->
      <div class="hidden lg:block">
        <form action="/search" method="GET" class="relative group">
          <input
            type="text"
            name="q"
            placeholder="搜索..."
            class="w-48 pl-4 pr-12 py-2.5 bg-transparent border-2 border-neutral-900 dark:border-white rounded-none text-sm focus:outline-none focus:border-brand-red transition-colors duration-200 placeholder:text-neutral-500"
          />
          <button
            type="submit"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-neutral-900 dark:text-white group-hover:text-brand-red transition-colors duration-200"
            aria-label="搜索"
          >
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </button>
        </form>
      </div>

      <!-- Desktop Auth Section -->
      <div class="hidden lg:flex items-center gap-6">
        <!-- Auth links - shown when not logged in -->
        <div id="desktop-auth-links" class="flex items-center gap-4">
          <a href="/login" class="text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:text-brand-red transition-colors duration-200">登录</a>
          <a href="/register" class="btn-primary text-sm py-2 px-6">注册</a>
        </div>

        <!-- User info - shown when logged in -->
        <div id="desktop-user-info" class="hidden items-center gap-4">
          <a id="desktop-admin-link" href="/admin" class="hidden text-sm font-bold uppercase tracking-widest text-brand-red hover:text-brand-red-dark transition-colors">管理后台</a>

          <!-- User dropdown -->
          <div class="relative">
            <button
              id="user-menu-button"
              aria-label="打开用户菜单"
              aria-expanded="false"
              aria-haspopup="true"
              class="flex items-center gap-3 group cursor-pointer focus:outline-none"
            >
              <img id="desktop-user-avatar" src="" alt="用户头像" class="h-10 w-10 rounded-full object-cover border-2 border-neutral-900 dark:border-white transition-transform duration-300 group-hover:scale-105" />
              <span id="desktop-username" class="text-sm font-bold text-neutral-900 dark:text-white hidden lg:block"></span>
              <svg class="h-4 w-4 text-neutral-500 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Dropdown menu -->
            <div id="user-dropdown" class="hidden absolute right-0 mt-4 w-56 glass-card rounded-xl py-3 z-50">
              <a href="/dashboard" class="flex items-center gap-3 px-5 py-3 text-sm font-medium text-neutral-900 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                </svg>
                仪表盘
              </a>
              <a href="/profile" class="flex items-center gap-3 px-5 py-3 text-sm font-medium text-neutral-900 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                个人设置
              </a>
              <a href="/my-likes" class="flex items-center gap-3 px-5 py-3 text-sm font-medium text-neutral-900 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                我的点赞
              </a>
              <a href="/my-bookmarks" class="flex items-center gap-3 px-5 py-3 text-sm font-medium text-neutral-900 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
                我的收藏
              </a>
              <a href="/my-comments" class="flex items-center gap-3 px-5 py-3 text-sm font-medium text-neutral-900 dark:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
                我的评论
              </a>
              <div class="border-t border-neutral-200 dark:border-neutral-700 my-2"></div>
              <button id="desktop-logout-btn" class="w-full flex items-center gap-3 px-5 py-3 text-sm font-medium text-brand-red hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors cursor-pointer">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                退出登录
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden flex items-center gap-3">
        <!-- Theme Toggle -->
        <button
          onclick="document.documentElement.classList.toggle('dark')"
          aria-label="切换暗色模式"
          class="w-11 h-11 flex items-center justify-center glass rounded-xl hover:bg-white/90 dark:hover:bg-neutral-900/90 transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-red"
        >
          <svg class="h-5 w-5 hidden dark:block text-neutral-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <svg class="h-5 w-5 block dark:hidden text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>

        <!-- Menu Toggle -->
        <button
          id="mobile-menu-btn"
          onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
          aria-label="打开菜单"
          class="w-11 h-11 flex items-center justify-center glass rounded-xl hover:bg-white/90 dark:hover:bg-neutral-900/90 transition-all duration-300 cursor-pointer focus:outline-none focus:ring-2 focus:ring-brand-red"
        >
          <svg class="h-5 w-5 text-neutral-900 dark:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Navigation -->
<div
  id="mobile-menu"
  class="hidden fixed inset-0 z-40 lg:hidden"
>
  <div class="absolute inset-0 bg-neutral-900/80 backdrop-blur-sm" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"></div>
  <div class="absolute right-0 top-0 h-full w-80 max-w-full glass-strong">
    <div class="p-8">
      <div class="flex justify-between items-center mb-12">
        <span class="text-xl font-black text-neutral-900 dark:text-white">菜单</span>
        <button
          onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
          class="w-10 h-10 flex items-center justify-center"
          aria-label="关闭菜单"
        >
          <svg class="h-6 w-6 text-neutral-900 dark:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <nav class="space-y-6">
        <a href="/blog" class="block text-2xl font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">博客</a>
        <a href="/about" class="block text-2xl font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">关于</a>
        <a href="/roadmap" class="block text-2xl font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">路线</a>
        <a href="/music" class="block text-2xl font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">音乐</a>
        <a href="/faq" class="block text-2xl font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">问答</a>
        <a href="/contact" class="block text-2xl font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">联系</a>
      </nav>

      <div class="border-t-2 border-neutral-900 dark:border-white mt-8 pt-8">
        <!-- Mobile Auth links -->
        <div id="mobile-auth-links" class="space-y-4">
          <a href="/login" class="block text-lg font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">登录</a>
          <a href="/register" class="btn-primary text-center">注册</a>
        </div>

        <!-- Mobile User info -->
        <div id="mobile-user-info" class="hidden space-y-4">
          <div class="flex items-center gap-4 pb-4 border-b border-neutral-200 dark:border-neutral-700">
            <img id="mobile-user-avatar" src="" alt="用户头像" class="h-14 w-14 rounded-full object-cover border-2 border-neutral-900 dark:border-white" />
            <div>
              <a id="mobile-username-link" href="/profile" class="text-lg font-bold text-brand-red hover:text-brand-red-dark transition-colors"></a>
              <p class="text-sm text-neutral-500">点击编辑个人资料</p>
            </div>
          </div>
          <a href="/dashboard" class="block text-lg font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">仪表盘</a>
          <a id="mobile-admin-link" href="/admin/posts" class="hidden block text-lg font-bold text-brand-red hover:text-brand-red-dark transition-colors">管理后台</a>
          <a href="/my-likes" class="block text-lg font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">我的点赞</a>
          <a href="/my-bookmarks" class="block text-lg font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">我的收藏</a>
          <a href="/my-comments" class="block text-lg font-bold text-neutral-900 dark:text-white hover:text-brand-red transition-colors">我的评论</a>
          <button id="mobile-logout-btn" class="w-full text-left text-lg font-bold text-brand-red hover:text-brand-red-dark transition-colors">退出登录</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Navbar scroll effect
  let lastScroll = 0;
  const navbar = document.getElementById('navbar');

  window.addEventListener('scroll', () => {
    const currentScroll = window.pageYOffset;

    if (currentScroll > 100) {
      navbar.classList.add('shadow-soft');
    } else {
      navbar.classList.remove('shadow-soft');
    }

    lastScroll = currentScroll;
  });

  // User dropdown menu
  function setupUserDropdown() {
    const userMenuButton = document.getElementById('user-menu-button');
    const userDropdown = document.getElementById('user-dropdown');

    if (!userMenuButton || !userDropdown) return;

    userMenuButton.onclick = (e) => {
      e.stopPropagation();
      userDropdown.classList.toggle('hidden');
      const isExpanded = !userDropdown.classList.contains('hidden');
      userMenuButton.setAttribute('aria-expanded', isExpanded.toString());
    };

    document.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof Node)) return;

      if (!userDropdown.contains(target) && target !== userMenuButton) {
        userDropdown.classList.add('hidden');
        userMenuButton.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Auth state management
  function updateAuthUI(user, isAuthenticated) {
    const desktopAuthLinks = document.getElementById('desktop-auth-links');
    const desktopUserInfo = document.getElementById('desktop-user-info');
    const desktopAdminLink = document.getElementById('desktop-admin-link');
    const desktopLogoutBtn = document.getElementById('desktop-logout-btn');
    const desktopUsername = document.getElementById('desktop-username');
    const desktopUserAvatar = document.getElementById('desktop-user-avatar');

    const mobileAuthLinks = document.getElementById('mobile-auth-links');
    const mobileUserInfo = document.getElementById('mobile-user-info');
    const mobileUsernameLink = document.getElementById('mobile-username-link');
    const mobileUserAvatar = document.getElementById('mobile-user-avatar');
    const mobileAdminLink = document.getElementById('mobile-admin-link');
    const mobileLogoutBtn = document.getElementById('mobile-logout-btn');

    if (isAuthenticated && user) {
      desktopAuthLinks.classList.add('hidden');
      desktopUserInfo.classList.remove('hidden');
      desktopUserInfo.classList.add('flex');
      mobileAuthLinks.classList.add('hidden');
      mobileUserInfo.classList.remove('hidden');

      const displayName = user.nickname || user.username;
      const defaultAvatar = '/images/default-avatar.svg';
      const avatar = user.avatar || defaultAvatar;

      desktopUsername.textContent = displayName;
      desktopUserAvatar.src = avatar;
      desktopUserAvatar.onerror = () => { desktopUserAvatar.src = defaultAvatar; };

      mobileUsernameLink.textContent = displayName;
      mobileUserAvatar.src = avatar;
      mobileUserAvatar.onerror = () => { mobileUserAvatar.src = defaultAvatar; };

      const isAdmin = user.role === 'ADMIN';
      desktopAdminLink.classList.toggle('hidden', !isAdmin);
      mobileAdminLink.classList.toggle('hidden', !isAdmin);

      desktopLogoutBtn.onclick = handleLogout;
      mobileLogoutBtn.onclick = handleLogout;
    } else {
      desktopAuthLinks.classList.remove('hidden');
      desktopUserInfo.classList.add('hidden');
      desktopUserInfo.classList.remove('flex');
      mobileAuthLinks.classList.remove('hidden');
      mobileUserInfo.classList.add('hidden');
    }
  }

  async function handleLogout() {
    if (window.authManager) {
      await window.authManager.logout();
      window.location.href = '/';
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    setupUserDropdown();

    if (window.authManager) {
      window.authManager.addListener(({ user, isAuthenticated }) => {
        updateAuthUI(user, isAuthenticated);
      });
      const authState = window.authManager.getAuthState();
      updateAuthUI(authState.user, authState.isAuthenticated);
    }
  });

  if (window.authManager) {
    const authState = window.authManager.getAuthState();
    if (!authState.isLoading) {
      updateAuthUI(authState.user, authState.isAuthenticated);
    }
  }
</script>
