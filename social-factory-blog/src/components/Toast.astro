---
---

<div id="toast-container" class="fixed top-20 right-4 z-50 space-y-2"></div>

<script>
  // Toast notification system
  const toastContainer = document.getElementById('toast-container');

  type ToastType = 'success' | 'error' | 'warning' | 'info';

  const toastTypes = {
    success: {
      bg: 'bg-green-50 dark:bg-green-900/20',
      border: 'border-green-200 dark:border-green-800',
      text: 'text-green-800 dark:text-green-200',
      icon: `<svg class="h-5 w-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
    },
    error: {
      bg: 'bg-red-50 dark:bg-red-900/20',
      border: 'border-red-200 dark:border-red-800',
      text: 'text-red-800 dark:text-red-200',
      icon: `<svg class="h-5 w-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
    },
    warning: {
      bg: 'bg-yellow-50 dark:bg-yellow-900/20',
      border: 'border-yellow-200 dark:border-yellow-800',
      text: 'text-yellow-800 dark:text-yellow-200',
      icon: `<svg class="h-5 w-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>`
    },
    info: {
      bg: 'bg-blue-50 dark:bg-blue-900/20',
      border: 'border-blue-200 dark:border-blue-800',
      text: 'text-blue-800 dark:text-blue-200',
      icon: `<svg class="h-5 w-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`
    }
  };

  function showToast(message: string, type: ToastType = 'info', duration = 3000) {
    if (!toastContainer) return;

    const toast = document.createElement('div');
    const config = toastTypes[type as ToastType] || toastTypes.info;

    toast.className = `
      flex items-center gap-3 px-4 py-3 rounded-lg shadow-lg border
      ${config.bg} ${config.border} ${config.text}
      transform transition-all duration-300 ease-out
      translate-x-full opacity-0
      min-w-[300px] max-w-md
    `;

    toast.innerHTML = `
      ${config.icon}
      <span class="flex-1 text-sm font-medium">${message}</span>
      <button onclick="this.parentElement.remove()" class="opacity-60 hover:opacity-100 transition">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    `;

    toastContainer.appendChild(toast);

    // Animate in
    requestAnimationFrame(() => {
      toast.classList.remove('translate-x-full', 'opacity-0');
    });

    // Auto remove
    if (duration > 0) {
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-full');
        setTimeout(() => toast.remove(), 300);
      }, duration);
    }
  }

  // Expose to window
  // @ts-ignore - extending window object
  window.showToast = showToast;

  // Expose specific helpers
  // @ts-ignore - extending window object
  window.showSuccess = (msg: string) => showToast(msg, 'success');
  // @ts-ignore - extending window object
  window.showError = (msg: string) => showToast(msg, 'error');
  // @ts-ignore - extending window object
  window.showWarning = (msg: string) => showToast(msg, 'warning');
  // @ts-ignore - extending window object
  window.showInfo = (msg: string) => showToast(msg, 'info');
</script>
