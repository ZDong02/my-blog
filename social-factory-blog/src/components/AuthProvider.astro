---
// This component will be used to provide authentication context
// Note: Astro doesn't have built-in context like React, so we'll use a different approach
---

<script>
  // @ts-nocheck
  import { apiClient } from '../lib/api.js';

  // Set apiClient globally before initializing authManager
  if (typeof window !== 'undefined') {
    window.apiClient = apiClient;
  }

  // Client-side authentication utilities
  class AuthManager {
    constructor() {
      this.currentUser = null;
      this.isAuthenticated = false;
      this.isLoading = true;
      this.listeners = [];
      this.apiClient = apiClient;
    }

    async init() {
      try {
        const client = this.apiClient;
        if (client && client.token) {
          const response = await client.getProfile();
          if (response.success && response.data) {
            this.currentUser = {
              ...response.data,
              avatar: client.resolveMediaUrl(response.data.avatar || ''),
            };
            this.isAuthenticated = true;
          } else {
            // API returned but no valid data - clear tokens
            client.clearTokens();
            this.currentUser = null;
            this.isAuthenticated = false;
          }
        }
      } catch (error) {
        console.error('Auth initialization failed:', error);
        // Network error or other exception - assume not authenticated
        this.currentUser = null;
        this.isAuthenticated = false;
      } finally {
        this.isLoading = false;
        this.notifyListeners();
      }
    }

    async login(credentials) {
      try {
        if (!this.apiClient) return { success: false, message: 'API client not available' };
        const response = await this.apiClient.login(credentials);
        if (response.success && response.data) {
          await this.init();
          return { success: true };
        }
        return response;
      } catch (error) {
        return { success: false, message: error.message };
      }
    }

    async register(userData) {
      try {
        if (!this.apiClient) return { success: false, message: 'API client not available' };
        const response = await this.apiClient.register(userData);
        if (response.success && response.data) {
          await this.init();
          return { success: true };
        }
        return response;
      } catch (error) {
        return { success: false, message: error.message };
      }
    }

    async logout() {
      if (this.apiClient) {
        this.apiClient.logout();
      }
      this.currentUser = null;
      this.isAuthenticated = false;
      this.notifyListeners();
    }

    async updateProfile(profileData) {
      try {
        if (!this.apiClient) return { success: false, message: 'API client not available' };
        const response = await this.apiClient.updateProfile(profileData);
        if (response.success && response.data) {
          this.currentUser = {
            ...response.data,
            avatar: this.apiClient.resolveMediaUrl(response.data.avatar || ''),
          };
          this.notifyListeners();
        }
        return response;
      } catch (error) {
        return { success: false, message: error.message };
      }
    }

    hasRole(role) {
      return this.currentUser && this.currentUser.role === role;
    }

    isAdmin() {
      return this.hasRole('ADMIN');
    }

    addListener(listener) {
      this.listeners.push(listener);
    }

    removeListener(listener) {
      this.listeners = this.listeners.filter(l => l !== listener);
    }

    notifyListeners() {
      const state = {
        user: this.currentUser,
        isAuthenticated: this.isAuthenticated,
        isLoading: this.isLoading
      };
      this.listeners.forEach(listener => listener(state));
    }

    getAuthState() {
      return {
        user: this.currentUser,
        isAuthenticated: this.isAuthenticated,
        isLoading: this.isLoading
      };
    }
  }

  // Create global auth manager
  window.authManager = new AuthManager();

  // Initialize auth on page load
  document.addEventListener('DOMContentLoaded', () => {
    window.authManager.init();
  });
</script>
