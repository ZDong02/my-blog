---
import Layout from '../layouts/Layout.astro';

const title = '注册 - 社会工厂';
const description = '创建新账户';
---

<Layout title={title} description={description}>
  <main class="min-h-screen flex items-center justify-center py-20 relative overflow-hidden">

    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-5 pointer-events-none">
      <div class="absolute inset-0" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 60px, currentColor 60px, currentColor 61px);"></div>
    </div>

    <div class="relative z-10 max-w-lg w-full mx-4">
      <!-- Header -->
      <div class="text-center mb-12">
        <a href="/" class="inline-block mb-8">
          <span class="text-3xl font-black text-neutral-900 dark:text-white">社会工厂</span>
        </a>
        <h1 class="text-headline text-neutral-900 dark:text-white mb-4">加入我们</h1>
        <p class="text-neutral-500">创建账户，开始您的博客之旅</p>
      </div>

      <!-- Register Card -->
      <div class="card p-8 lg:p-10">
        <form id="registerForm" class="space-y-6">
          <!-- Username -->
          <div>
            <label for="username" class="input-label">用户名 <span class="text-brand-red">*</span></label>
            <input
              id="username"
              name="username"
              type="text"
              required
              minlength="3"
              maxlength="50"
              class="input-field"
              placeholder="3-50个字符"
            />
          </div>

          <!-- Email -->
          <div>
            <label for="email" class="input-label">邮箱 <span class="text-brand-red">*</span></label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="input-field"
              placeholder="输入您的邮箱"
            />
          </div>

          <!-- Nickname -->
          <div>
            <label for="nickname" class="input-label">显示名称</label>
            <input
              id="nickname"
              name="nickname"
              type="text"
              maxlength="50"
              class="input-field"
              placeholder="您希望如何显示您的名字？（可选）"
            />
          </div>

          <!-- Password -->
          <div>
            <label for="password" class="input-label">密码 <span class="text-brand-red">*</span></label>
            <input
              id="password"
              name="password"
              type="password"
              required
              minlength="8"
              maxlength="100"
              class="input-field"
              placeholder="8-100个字符"
            />
          </div>

          <!-- Confirm Password -->
          <div>
            <label for="confirmPassword" class="input-label">确认密码 <span class="text-brand-red">*</span></label>
            <input
              id="confirmPassword"
              name="confirmPassword"
              type="password"
              required
              minlength="8"
              maxlength="100"
              class="input-field"
              placeholder="再次输入密码"
            />
          </div>

          <!-- Captcha -->
          <div>
            <label for="captchaCode" class="input-label">验证码 <span class="text-brand-red">*</span></label>
            <div class="flex gap-3">
              <input
                id="captchaCode"
                name="captchaCode"
                type="text"
                required
                maxlength="4"
                class="input-field flex-1"
                placeholder="输入右侧验证码"
                autocomplete="off"
              />
              <button
                type="button"
                id="refreshCaptchaBtn"
                class="flex-shrink-0"
              >
                <img
                  id="captchaImage"
                  src=""
                  alt="验证码"
                  class="h-12 w-28 border-2 border-neutral-200 dark:border-neutral-700 cursor-pointer hover:border-brand-red transition-colors"
                  title="点击刷新验证码"
                />
              </button>
            </div>
            <input type="hidden" id="captchaId" name="captchaId" />
            <p class="mt-1 text-xs text-neutral-500">点击图片刷新验证码</p>
          </div>

          <div>
            <button
              type="submit"
              id="registerBtn"
              class="btn-primary w-full flex items-center justify-center gap-3"
            >
              <span id="registerBtnText">立即注册</span>
              <span id="registerLoading" class="hidden">
                <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
              </span>
            </button>
          </div>

          <div class="text-center">
            <p class="text-sm text-neutral-500">
              已有账户？
              <a href="/login" class="font-bold text-brand-red hover:underline">立即登录</a>
            </p>
          </div>

          <div id="errorMessage" class="hidden p-4 border-2 border-red-500 bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-sm font-bold text-center"></div>
        </form>
      </div>

      <!-- Back to home -->
      <div class="text-center mt-8">
        <a href="/" class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-neutral-500 hover:text-brand-red transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          返回首页
        </a>
      </div>
    </div>

  </main>

  <script>
    import { apiClient } from '../lib/api.js';

    const API_BASE_URL = import.meta.env.PUBLIC_API_BASE_URL || 'http://localhost:8080/api';

    const registerBtn = document.getElementById('registerBtn');
    const registerBtnText = document.getElementById('registerBtnText');
    const registerLoading = document.getElementById('registerLoading');
    const errorDiv = document.getElementById('errorMessage');
    const captchaImage = document.getElementById('captchaImage');
    const captchaIdInput = document.getElementById('captchaId');
    const refreshCaptchaBtn = document.getElementById('refreshCaptchaBtn');

    // Load captcha on page load
    async function loadCaptcha() {
      try {
        const response = await fetch(`${API_BASE_URL}/captcha/generate`);
        const data = await response.json();
        if (data.success && data.data) {
          captchaImage.src = data.data.image;
          captchaIdInput.value = data.data.captchaId;
        }
      } catch (error) {
        console.error('Failed to load captcha:', error);
      }
    }

    // Refresh captcha
    refreshCaptchaBtn.addEventListener('click', loadCaptcha);
    captchaImage.addEventListener('click', loadCaptcha);

    document.getElementById('registerForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const username = e.target.username.value;
      const email = e.target.email.value;
      const nickname = e.target.nickname.value;
      const password = e.target.password.value;
      const confirmPassword = e.target.confirmPassword.value;
      const captchaId = e.target.captchaId.value;
      const captchaCode = e.target.captchaCode.value;

      // Validate password match
      if (password !== confirmPassword) {
        errorDiv.textContent = '两次输入的密码不一致';
        errorDiv.classList.remove('hidden');
        return;
      }

      // Validate captcha
      if (!captchaCode || captchaCode.length !== 4) {
        errorDiv.textContent = '请输入4位验证码';
        errorDiv.classList.remove('hidden');
        return;
      }

      registerBtn.disabled = true;
      registerBtnText.classList.add('hidden');
      registerLoading.classList.remove('hidden');
      errorDiv.classList.add('hidden');

      try {
        const response = await apiClient.request('/auth/register', {
          method: 'POST',
          body: JSON.stringify({
            username,
            email,
            nickname,
            password,
            captchaId,
            captchaCode
          })
        });

        if (response.success && response.data) {
          // Auto login after registration
          apiClient.setTokens(response.data.token, response.data.refreshToken);
          if (window.authManager) {
            await window.authManager.init();
          }
          window.location.href = '/dashboard';
        } else {
          errorDiv.textContent = response.message || '注册失败';
          errorDiv.classList.remove('hidden');
          // Refresh captcha on error
          loadCaptcha();
        }
      } catch (error) {
        console.error('Registration error:', error);
        errorDiv.textContent = error.message || '注册时发生错误';
        errorDiv.classList.remove('hidden');
        // Refresh captcha on error
        loadCaptcha();
      } finally {
        registerBtn.disabled = false;
        registerBtnText.classList.remove('hidden');
        registerLoading.classList.add('hidden');
      }
    });

    // Load captcha on page load
    loadCaptcha();
  </script>
</Layout>