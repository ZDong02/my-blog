---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About - Social Factory">
  <div class="min-h-screen bg-white dark:bg-zinc-950 pt-24 pb-16">
    <!-- Hero Section -->
    <div class="max-w-6xl mx-auto px-4 sm:px-8 py-16">
      <div class="text-center mb-20">
        <h1 class="text-5xl md:text-7xl font-black text-zinc-900 dark:text-white mb-6 tracking-tight">
          ABOUT US
        </h1>
        <div class="w-24 h-1 bg-red-600 mx-auto mb-8"></div>
        <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
          Building a platform where compassion meets action. We believe in creating
          a more humane society through technology and community.
        </p>
      </div>

      <!-- Mission & Vision -->
      <div class="grid md:grid-cols-2 gap-8 mb-20">
        <div class="bg-zinc-50 dark:bg-zinc-900 p-8 md:p-10 border-l-4 border-red-600">
          <div class="text-red-600 text-sm uppercase tracking-widest mb-4">Mission</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">
            No Favouritism
          </h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            We stand for equality and justice. Our platform is designed to amplify
            voices that deserve to be heard, without bias or preference. Everyone
            deserves a fair chance to share their story.
          </p>
        </div>

        <div class="bg-zinc-50 dark:bg-zinc-900 p-8 md:p-10 border-r-4 border-red-600 md:border-r-4 md:border-l-0">
          <div class="text-red-600 text-sm uppercase tracking-widest mb-4">Vision</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-4">
            Social Change Through Technology
          </h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            We envision a world where technology serves humanity's highest ideals.
            By connecting compassionate individuals, we create ripples of positive
            change that extend far beyond the digital realm.
          </p>
        </div>
      </div>

      <!-- Story Section -->
      <div class="mb-20">
        <div class="grid md:grid-cols-3 gap-8 items-start">
          <div class="md:col-span-1">
            <div class="text-8xl font-black text-red-600/20 dark:text-red-600/30 leading-none">
              ZD
            </div>
          </div>
          <div class="md:col-span-2">
            <h2 class="text-3xl md:text-4xl font-bold text-zinc-900 dark:text-white mb-6">
              Our Story
            </h2>
            <div class="space-y-4 text-zinc-600 dark:text-zinc-400 leading-relaxed">
              <p>
                Social Factory was born from a simple yet powerful belief: that great compassion
                can transform society. In a world often divided by differences, we chose to
                focus on what unites us all – our shared humanity and our capacity for kindness.
              </p>
              <p>
                Founded in 2026, we've dedicated ourselves to supporting those who suffer
                physically or face injustice. Our platform serves as a bridge between those
                who need help and those who want to make a difference.
              </p>
              <p>
                Every feature we build, every story we share, and every connection we facilitate
                is guided by our core principle: <span class="font-semibold text-red-600">No Favouritism</span>.
                We believe in treating every voice with equal respect and every cause with genuine care.
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Values Section -->
      <div class="mb-20">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold text-zinc-900 dark:text-white mb-4">
            Core Values
          </h2>
          <div class="w-16 h-1 bg-red-600 mx-auto"></div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Value 1 -->
          <div class="text-center p-6 border border-zinc-200 dark:border-zinc-800 hover:border-red-600 transition-colors duration-300">
            <div class="text-4xl mb-4">🤝</div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2 uppercase tracking-wider">
              Compassion
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              We lead with empathy and understanding in every interaction.
            </p>
          </div>

          <!-- Value 2 -->
          <div class="text-center p-6 border border-zinc-200 dark:border-zinc-800 hover:border-red-600 transition-colors duration-300">
            <div class="text-4xl mb-4">⚖️</div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2 uppercase tracking-wider">
              Equality
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              Every voice matters. Every story deserves to be heard.
            </p>
          </div>

          <!-- Value 3 -->
          <div class="text-center p-6 border border-zinc-200 dark:border-zinc-800 hover:border-red-600 transition-colors duration-300">
            <div class="text-4xl mb-4">🔥</div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2 uppercase tracking-wider">
              Passion
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              We pursue social change with relentless dedication.
            </p>
          </div>

          <!-- Value 4 -->
          <div class="text-center p-6 border border-zinc-200 dark:border-zinc-800 hover:border-red-600 transition-colors duration-300">
            <div class="text-4xl mb-4">🌱</div>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-white mb-2 uppercase tracking-wider">
              Growth
            </h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400">
              We continuously learn and improve to serve better.
            </p>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="text-center py-12 bg-zinc-50 dark:bg-zinc-900 rounded-lg">
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white mb-4">
          Join Our Mission
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 mb-8 max-w-2xl mx-auto">
          Be part of a community that cares. Share your story, support others,
          or simply spread awareness.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/register" class="px-8 py-3 bg-red-600 text-white uppercase tracking-widest hover:bg-red-700 transition font-semibold">
            Get Started
          </a>
          <a href="/contact" class="px-8 py-3 border border-zinc-300 dark:border-zinc-700 text-zinc-900 dark:text-white uppercase tracking-widest hover:border-red-600 hover:text-red-600 transition font-semibold">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>
