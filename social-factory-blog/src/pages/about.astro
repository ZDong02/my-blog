---
import Layout from "../layouts/Layout.astro";
---

<Layout title="关于 - 社会工厂">
  <main class="min-h-screen">

    <!-- Hero Section -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-12 gap-8 items-center">
          <div class="col-span-12 lg:col-span-6">
            <p class="section-subtitle mb-4">About Us</p>
            <h1 class="text-display text-neutral-900 dark:text-white mb-8">
              关于<br/><span class="gradient-text">我们</span>
            </h1>
            <div class="w-16 h-1 bg-brand-red mb-8"></div>
            <p class="text-subtitle text-neutral-600 dark:text-neutral-400 leading-relaxed">
              构建一个让同情心付诸行动的平台。我们相信通过技术和社区创造更人道的社会。
            </p>
          </div>
          <div class="col-span-12 lg:col-span-6">
            <div class="relative">
              <div class="aspect-[4/3] bg-gradient-to-br from-neutral-200 to-neutral-300 dark:from-neutral-800 dark:to-neutral-900 flex items-center justify-center">
                <span class="text-[120px] font-black text-neutral-300 dark:text-neutral-700 leading-none">SF</span>
              </div>
              <div class="absolute -bottom-4 -right-4 w-32 h-32 bg-brand-red"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Mission & Vision -->
    <section class="py-20 lg:py-32 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-12 gap-8">
          <!-- Mission -->
          <div class="col-span-12 lg:col-span-6">
            <div class="card p-8 lg:p-10 h-full">
              <div class="text-xs font-bold uppercase tracking-widest text-brand-red mb-4">Mission</div>
              <h2 class="text-title text-neutral-900 dark:text-white mb-6">不偏不倚</h2>
              <p class="text-body text-neutral-600 dark:text-neutral-400 leading-relaxed">
                我们倡导平等与正义。我们的平台旨在放大那些值得被听到的声音，
                不带偏见或偏好。每个人都应享有分享自己故事的公平机会。
              </p>
            </div>
          </div>
          <!-- Vision -->
          <div class="col-span-12 lg:col-span-6">
            <div class="card p-8 lg:p-10 h-full">
              <div class="text-xs font-bold uppercase tracking-widest text-brand-red mb-4">Vision</div>
              <h2 class="text-title text-neutral-900 dark:text-white mb-6">科技推动社会变革</h2>
              <p class="text-body text-neutral-600 dark:text-neutral-400 leading-relaxed">
                我们设想一个技术服务于人类最高理想的世界。通过连接有爱心的个人，
                我们创造积极的涟漪，其影响远超数字领域。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Story Section -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-12 gap-8 items-start">
          <div class="col-span-12 lg:col-span-3">
            <div class="text-[100px] lg:text-[140px] font-black text-brand-red/10 dark:text-brand-red/20 leading-none select-none">
              ZD
            </div>
          </div>
          <div class="col-span-12 lg:col-span-9">
            <p class="section-subtitle mb-4">Our Story</p>
            <h2 class="section-title mb-8">我们的故事</h2>
            <div class="space-y-6 text-body text-neutral-600 dark:text-neutral-400 leading-relaxed">
              <p>
                Social Factory 源于一个简单而强大的信念：伟大的同情心可以改变社会。
                在一个常被分歧撕裂的世界里，我们选择关注将我们联系在一起的东西——
                我们共同的人性和善良的能力。
              </p>
              <p>
                我们成立于 2026 年，致力于支持那些遭受身体痛苦或不公正对待的人。
                我们的平台是那些需要帮助的人与那些希望带来改变的人之间的桥梁。
              </p>
              <p>
                我们构建的每一个功能、分享的每一个故事、促进的每一个连接，
                都由我们的核心原则指导：<span class="font-bold text-brand-red">不偏不倚</span>。
                我们相信以平等的尊重对待每一个声音，以真诚的关怀对待每一个事业。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Values Section -->
    <section class="py-20 lg:py-32 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <p class="section-subtitle mb-4">Core Values</p>
          <h2 class="section-title">核心价值观</h2>
        </div>

        <div class="grid grid-cols-12 gap-6">
          <!-- Value 1 -->
          <div class="col-span-12 sm:col-span-6 lg:col-span-3">
            <div class="card p-8 h-full text-center">
              <div class="w-16 h-16 mx-auto mb-6 bg-brand-red/10 flex items-center justify-center">
                <svg class="w-8 h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3 uppercase tracking-wider">同情心</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                我们在每次互动中都以同理心和理解为先。
              </p>
            </div>
          </div>

          <!-- Value 2 -->
          <div class="col-span-12 sm:col-span-6 lg:col-span-3">
            <div class="card p-8 h-full text-center">
              <div class="w-16 h-16 mx-auto mb-6 bg-brand-red/10 flex items-center justify-center">
                <svg class="w-8 h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3 uppercase tracking-wider">平等</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                每个声音都很重要，每个故事都值得被倾听。
              </p>
            </div>
          </div>

          <!-- Value 3 -->
          <div class="col-span-12 sm:col-span-6 lg:col-span-3">
            <div class="card p-8 h-full text-center">
              <div class="w-16 h-16 mx-auto mb-6 bg-brand-red/10 flex items-center justify-center">
                <svg class="w-8 h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"/>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3 uppercase tracking-wider">热情</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                我们以不懈的追求推动社会变革。
              </p>
            </div>
          </div>

          <!-- Value 4 -->
          <div class="col-span-12 sm:col-span-6 lg:col-span-3">
            <div class="card p-8 h-full text-center">
              <div class="w-16 h-16 mx-auto mb-6 bg-brand-red/10 flex items-center justify-center">
                <svg class="w-8 h-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                </svg>
              </div>
              <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-3 uppercase tracking-wider">成长</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                我们不断学习改进，以提供更好的服务。
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 lg:py-32 bg-brand-red relative overflow-hidden">
      <!-- Film grain -->
      <div class="absolute inset-0 opacity-10 pointer-events-none">
        <svg class="w-full h-full">
          <filter id="grain4">
            <feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3"/>
            <feColorMatrix type="saturate" values="0"/>
          </filter>
          <rect width="100%" height="100%" filter="url(#grain4)"/>
        </svg>
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <h2 class="text-headline text-white mb-6">加入我们的使命</h2>
        <p class="text-lg text-red-100 mb-12 max-w-2xl mx-auto">
          成为一个有爱的社区的一员。分享你的故事，支持他人，或只是传播意识。
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/contact" class="px-8 py-4 bg-white text-brand-red font-bold uppercase tracking-widest hover:bg-neutral-100 transition-colors rounded-none">联系我们</a>
          <a href="/blog" class="px-8 py-4 border-2 border-white text-white font-bold uppercase tracking-widest hover:bg-white hover:text-brand-red transition-colors rounded-none">浏览博客</a>
        </div>
      </div>
    </section>

  </main>
</Layout>
