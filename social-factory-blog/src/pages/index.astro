---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Social Factory | No Favouritism">
  <main class="min-h-screen">

    <!-- Hero Section - Split Screen Magazine Style -->
    <section class="grid grid-cols-1 lg:grid-cols-12 min-h-[90vh]">
      <!-- Left Panel -->
      <div class="lg:col-span-4 xl:col-span-3 bg-neutral-900 text-white p-8 lg:p-12 flex flex-col justify-between relative overflow-hidden">
        <!-- Issue Number (Magazine Style) -->
        <div class="absolute -left-8 -top-8 text-[200px] font-black text-neutral-800/50 leading-none select-none pointer-events-none">
          01
        </div>

        <!-- Top Section -->
        <div class="relative z-10">
          <div class="text-xs font-bold uppercase tracking-[0.3em] text-neutral-500 mb-4">Issue 2026</div>
          <h1 class="text-5xl lg:text-6xl font-black tracking-tighter leading-[0.9]">
            社会<br/>工厂
          </h1>
        </div>

        <!-- Middle Section - Rotated Text -->
        <div class="relative z-10">
          <div class="text-sm font-bold uppercase tracking-[0.2em] text-neutral-400 [writing-mode:vertical-rl] rotate-180 h-40">
            No Favouritism · 不偏不倚
          </div>
        </div>

        <!-- Bottom Section -->
        <div class="relative z-10 space-y-6">
          <p class="text-neutral-400 text-sm leading-relaxed max-w-xs">
            你拥有伟大的同情心，并致力于创造更人道的社会。你支持那些遭受身体痛苦或不公正对待的人。
          </p>
          <div class="flex items-center gap-4">
            <div class="w-12 h-[2px] bg-brand-red"></div>
            <span class="text-xs font-bold uppercase tracking-widest text-brand-red">性格 / 社会工厂</span>
          </div>
        </div>
      </div>

      <!-- Center Panel - Featured Image -->
      <div class="lg:col-span-5 xl:col-span-6 relative bg-brand-red overflow-hidden group">
        <!-- Film grain overlay -->
        <div class="absolute inset-0 opacity-20 pointer-events-none">
          <svg class="w-full h-full">
            <filter id="grain2">
              <feTurbulence type="fractalNoise" baseFrequency="0.6" numOctaves="3"/>
              <feColorMatrix type="saturate" values="0"/>
            </filter>
            <rect width="100%" height="100%" filter="url(#grain2)"/>
          </svg>
        </div>

        <!-- Image -->
        <img
          src="/images/hero.jpg"
          alt="Hero"
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 ease-out"
        />

        <!-- Overlay Gradient -->
        <div class="absolute inset-0 bg-gradient-to-t from-neutral-900/60 via-transparent to-transparent"></div>
      </div>

      <!-- Right Panel -->
      <div class="lg:col-span-3 xl:col-span-3 bg-neutral-50 dark:bg-neutral-900 p-8 lg:p-12 flex flex-col justify-between relative">
        <!-- Issue Number -->
        <div class="absolute -right-4 -bottom-8 text-[180px] font-black text-neutral-200 dark:text-neutral-800/30 leading-none select-none pointer-events-none">
          ZDong
        </div>

        <!-- Auth Section (shown when not logged in) -->
        <div id="home-auth-buttons" class="relative z-10 space-y-6 mt-auto">
          <div class="space-y-2">
            <p class="text-xs font-bold uppercase tracking-widest text-neutral-500">Welcome</p>
            <p class="text-3xl font-black text-neutral-900 dark:text-white tracking-tight">探索无限可能</p>
          </div>
          <a href="/blog" class="btn-primary block text-center">开始探索</a>
          <a href="/register" class="btn-secondary block text-center">加入我们</a>
        </div>

        <!-- User Info (shown when logged in) -->
        <div id="home-user-info" class="hidden relative z-10 space-y-6 mt-auto">
          <div class="space-y-2">
            <p class="text-xs font-bold uppercase tracking-widest text-neutral-500">Welcome Back</p>
            <p id="home-username" class="text-2xl font-black text-brand-red tracking-tight"></p>
          </div>
          <a href="/dashboard" class="btn-primary block text-center">进入仪表盘</a>
          <a href="/blog" class="btn-secondary block text-center">浏览博客</a>
          <button id="home-logout-btn" class="w-full py-3 text-sm font-bold uppercase tracking-widest text-neutral-500 hover:text-brand-red transition-colors">退出登录</button>
        </div>

        <!-- Navigation Links -->
        <div class="relative z-10 space-y-4">
          <div class="border-t-2 border-neutral-900 dark:border-white pt-6">
            <nav class="space-y-3">
              <a href="/about" class="block text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:text-brand-red transition-colors hover:translate-x-2">关于 →</a>
              <a href="/roadmap" class="block text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:text-brand-red transition-colors hover:translate-x-2">路线 →</a>
              <a href="/faq" class="block text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:text-brand-red transition-colors hover:translate-x-2">问答 →</a>
            </nav>
          </div>
        </div>
      </div>
    </section>

    <!-- Magazine Rule -->
    <div class="h-1 bg-neutral-900 dark:bg-white"></div>

    <!-- Latest Posts Section - Magazine Grid -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="grid grid-cols-12 gap-8 mb-16 items-end">
          <div class="col-span-12 lg:col-span-6">
            <p class="section-subtitle mb-4">探索与发现</p>
            <h2 class="section-title">
              最新<br/><span class="gradient-text">文章</span>
            </h2>
          </div>
          <div class="col-span-12 lg:col-span-6 lg:text-right">
            <a href="/blog" class="inline-flex items-center gap-3 text-sm font-bold uppercase tracking-widest text-neutral-900 dark:text-white hover:text-brand-red transition-colors group">
              查看全部
              <svg class="w-5 h-5 transition-transform group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Loading State -->
        <div id="loading" class="text-center py-20">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">加载中...</p>
        </div>

        <!-- Empty State -->
        <div id="noPosts" class="hidden text-center py-20">
          <div class="w-32 h-32 bg-neutral-200 dark:bg-neutral-800 mx-auto mb-8 flex items-center justify-center">
            <svg class="w-16 h-16 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-neutral-900 dark:text-white mb-4">暂无文章</h3>
          <p class="text-neutral-500 mb-8">精彩内容即将上线，敬请期待</p>
          <a href="/admin/posts/create" class="btn-primary">立即创建</a>
        </div>

        <!-- Posts Grid - Asymmetric Magazine Layout -->
        <div id="postsContainer" class="hidden">
          <div class="grid grid-cols-12 gap-6 lg:gap-8" id="postsGrid">
            <!-- Posts will be loaded here -->
          </div>
        </div>

        <!-- CTA -->
        <div class="text-center mt-16">
          <a href="/blog" class="btn-primary text-sm py-4 px-12">探索更多内容</a>
        </div>
      </div>
    </section>

    <!-- Magazine Rule Double -->
    <div class="relative h-16 bg-neutral-900 dark:bg-white overflow-hidden">
      <div class="absolute inset-0 flex items-center justify-center">
        <span class="text-white dark:text-neutral-900 text-xs font-bold uppercase tracking-[0.5em]">Social Factory Blog</span>
      </div>
      <div class="absolute bottom-0 left-0 right-0 h-1 bg-brand-red"></div>
    </div>

    <!-- Features Section -->
    <section class="py-20 lg:py-32 bg-neutral-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-12 gap-8">
          <div class="col-span-12 lg:col-span-4 reveal">
            <div class="text-[120px] font-black leading-none text-neutral-800 select-none mb-4">01</div>
            <h3 class="text-2xl font-black mb-4">真实的声音</h3>
            <p class="text-neutral-400 leading-relaxed">每一篇文章都经过深思熟虑，为您呈现最有价值的内容。</p>
          </div>
          <div class="col-span-12 lg:col-span-4 reveal" style="animation-delay: 0.1s">
            <div class="text-[120px] font-black leading-none text-neutral-800 select-none mb-4">02</div>
            <h3 class="text-2xl font-black mb-4">深度思考</h3>
            <p class="text-neutral-400 leading-relaxed">不偏不倚，我们关注社会问题的每一个角度。</p>
          </div>
          <div class="col-span-12 lg:col-span-4 reveal" style="animation-delay: 0.2s">
            <div class="text-[120px] font-black leading-none text-neutral-800 select-none mb-4">03</div>
            <h3 class="text-2xl font-black mb-4">共同成长</h3>
            <p class="text-neutral-400 leading-relaxed">与社区一起，探索无限可能。</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Newsletter Section -->
    <section class="py-20 lg:py-32 bg-brand-red relative overflow-hidden">
      <!-- Film grain -->
      <div class="absolute inset-0 opacity-10 pointer-events-none">
        <svg class="w-full h-full">
          <filter id="grain3">
            <feTurbulence type="fractalNoise" baseFrequency="0.7" numOctaves="3"/>
            <feColorMatrix type="saturate" values="0"/>
          </filter>
          <rect width="100%" height="100%" filter="url(#grain3)"/>
        </svg>
      </div>

      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
        <h2 class="text-4xl lg:text-5xl font-black text-white mb-6 tracking-tight">
          加入我们
        </h2>
        <p class="text-red-100 text-lg mb-12 max-w-2xl mx-auto">
          订阅更新，获取最新文章和深度思考，与我们一起成长。
        </p>

        <form class="flex flex-col sm:flex-row gap-4 max-w-lg mx-auto">
          <input
            type="email"
            placeholder="输入您的邮箱"
            class="flex-1 px-6 py-4 bg-white/20 border-2 border-white/30 text-white placeholder:text-red-200 focus:outline-none focus:border-white rounded-none transition-colors"
          />
          <button type="submit" class="px-8 py-4 bg-neutral-900 text-white font-bold uppercase tracking-widest hover:bg-neutral-800 transition-colors rounded-none">
            订阅
          </button>
        </form>
      </div>
    </section>

  </main>

  <script>
    import { apiClient } from '../lib/api.js';

    // Home page auth state management
    function updateHomeAuthUI(user: { nickname: any; username: any; }, isAuthenticated: any) {
      const authButtons = document.getElementById('home-auth-buttons');
      const userInfo = document.getElementById('home-user-info');
      const username = document.getElementById('home-username');
      const logoutBtn = document.getElementById('home-logout-btn');

      if (isAuthenticated && user) {
        authButtons.classList.add('hidden');
        userInfo.classList.remove('hidden');

        const displayName = user.nickname || user.username;
        username.textContent = displayName;

        logoutBtn.onclick = async () => {
          if (window.authManager) {
            await window.authManager.logout();
            window.location.href = '/';
          }
        };
      } else {
        authButtons.classList.remove('hidden');
        userInfo.classList.add('hidden');
      }
    }

    // Load latest posts with magazine layout
    const loadPosts = async () => {
      try {
        const response = await apiClient.getPosts(1, 6);

        if (response.success && response.data && response.data.content) {
          const posts = response.data.content;
          const container = document.getElementById('postsContainer');
          const loading = document.getElementById('loading');
          const grid = document.getElementById('postsGrid');

          loading.classList.add('hidden');
          container.classList.remove('hidden');

          let html = '';

          // Magazine-style layout: First post is large, then alternating
          posts.forEach((post: any, index: number) => {
            const postDate = new Date(post.createdAt).toLocaleDateString('zh-TW');
            const readingTime = Math.ceil((post.content?.length || 0) / 200);

            if (index === 0) {
              // Featured post - large
              html += `
                <div class="col-span-12 lg:col-span-8 reveal" style="animation-delay: ${index * 0.1}s">
                  <a href="/blog/${post.id}" class="group block relative overflow-hidden">
                    <div class="aspect-[16/9] bg-gradient-to-br from-neutral-200 to-neutral-300 dark:from-neutral-800 dark:to-neutral-900 relative">
                      ${post.featuredImage ? `
                        <img src="${post.featuredImage}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                      ` : `
                        <div class="w-full h-full bg-gradient-to-br from-brand-red to-brand-red-dark flex items-center justify-center">
                          <span class="text-white/30 text-6xl font-black">${post.category?.name?.charAt(0) || 'B'}</span>
                        </div>
                      `}
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-t from-neutral-900 via-neutral-900/50 to-transparent opacity-80 group-hover:opacity-70 transition-opacity"></div>
                    <div class="absolute bottom-0 left-0 right-0 p-8">
                      <span class="badge-red mb-4 inline-block">${post.category?.name || '未分类'}</span>
                      <h3 class="text-3xl lg:text-4xl font-black text-white mb-3 group-hover:text-brand-red transition-colors leading-tight">
                        ${post.title}
                      </h3>
                      <p class="text-neutral-300 line-clamp-2 mb-4 max-w-2xl">${post.summary || post.content?.substring(0, 200) || ''}</p>
                      <div class="flex items-center gap-4 text-sm text-neutral-400">
                        <span>${postDate}</span>
                        <span>·</span>
                        <span>${readingTime} 分钟阅读</span>
                      </div>
                    </div>
                  </a>
                </div>
              `;
            } else if (index < 4) {
              // Secondary posts
              html += `
                <div class="col-span-12 sm:col-span-6 lg:col-span-4 reveal" style="animation-delay: ${index * 0.1}s">
                  <a href="/blog/${post.id}" class="group block">
                    <div class="aspect-[4/3] bg-gradient-to-br from-neutral-200 to-neutral-300 dark:from-neutral-800 dark:to-neutral-900 relative overflow-hidden mb-4">
                      ${post.featuredImage ? `
                        <img src="${post.featuredImage}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                      ` : `
                        <div class="w-full h-full bg-gradient-to-br from-brand-red to-brand-red-dark flex items-center justify-center">
                          <span class="text-white/30 text-4xl font-black">${post.category?.name?.charAt(0) || 'B'}</span>
                        </div>
                      `}
                    </div>
                    <span class="badge-outline mb-2 inline-block">${post.category?.name || '未分类'}</span>
                    <h3 class="text-xl font-bold text-neutral-900 dark:text-white group-hover:text-brand-red transition-colors line-clamp-2 mb-2">
                      ${post.title}
                    </h3>
                    <p class="text-sm text-neutral-500 line-clamp-2">${post.summary || ''}</p>
                  </a>
                </div>
              `;
            } else {
              // Tertiary posts - smaller cards
              html += `
                <div class="col-span-12 sm:col-span-6 lg:col-span-3 reveal" style="animation-delay: ${index * 0.1}s">
                  <a href="/blog/${post.id}" class="group flex gap-4">
                    <div class="w-24 h-24 bg-gradient-to-br from-neutral-200 to-neutral-300 dark:from-neutral-800 dark:to-neutral-900 flex-shrink-0 overflow-hidden">
                      ${post.featuredImage ? `
                        <img src="${post.featuredImage}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" />
                      ` : `
                        <div class="w-full h-full bg-gradient-to-br from-brand-red to-brand-red-dark flex items-center justify-center">
                          <span class="text-white/30 text-2xl font-black">${post.category?.name?.charAt(0) || 'B'}</span>
                        </div>
                      `}
                    </div>
                    <div class="flex-1 min-w-0">
                      <h3 class="text-sm font-bold text-neutral-900 dark:text-white group-hover:text-brand-red transition-colors line-clamp-2 mb-1">
                        ${post.title}
                      </h3>
                      <span class="text-xs text-neutral-500">${postDate}</span>
                    </div>
                  </a>
                </div>
              `;
            }
          });

          grid.innerHTML = html;

          // Trigger reveal animations
          setTimeout(() => {
            document.querySelectorAll('.reveal').forEach(el => {
              el.classList.add('visible');
            });
          }, 100);
        }
      } catch (error) {
        console.error('Failed to load posts:', error);
      }
    };

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      if (window.authManager) {
        window.authManager.addListener(({ user, isAuthenticated }) => {
          updateHomeAuthUI(user, isAuthenticated);
        });
        const authState = window.authManager.getAuthState();
        updateHomeAuthUI(authState.user, authState.isAuthenticated);
      }

      loadPosts();
    });

    if (window.authManager) {
      const authState = window.authManager.getAuthState();
      if (!authState.isLoading) {
        updateHomeAuthUI(authState.user, authState.isAuthenticated);
      }
    }
  </script>
</Layout>
