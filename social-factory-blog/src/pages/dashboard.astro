---
import Layout from '../layouts/Layout.astro';

const title = '仪表盘 - 博客';
const description = '您的个人仪表盘';
---

<Layout title={title} description={description}>
  <main class="min-h-screen pt-24 pb-12">
    <!-- Page header -->
    <section class="py-8 bg-neutral-50 dark:bg-neutral-900 border-b border-neutral-200 dark:border-neutral-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-black text-neutral-900 dark:text-white">仪表盘</h1>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">欢迎回来，查看您的博客数据</p>
          </div>
          <a href="/profile" class="text-sm font-bold text-brand-red hover:text-brand-red-dark flex items-center gap-1 transition">
            编辑资料
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </section>

    <section class="py-12 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <!-- Loading state - Skeleton -->
        <div id="loading" class="hidden">
          <div class="card p-8 mb-8">
            <div class="flex items-center gap-6">
              <div class="skeleton-avatar h-24 w-24"></div>
              <div class="flex-1 space-y-3">
                <div class="skeleton-title w-48"></div>
                <div class="skeleton-text w-64"></div>
                <div class="skeleton-text w-24"></div>
              </div>
            </div>
          </div>
          <div class="grid grid-cols-12 gap-6 mb-8">
            <div class="col-span-6 lg:col-span-3"><div class="card p-6"><div class="flex items-center gap-4"><div class="skeleton-avatar h-12 w-12"></div><div class="space-y-2"><div class="skeleton-text w-20"></div><div class="skeleton-title w-16"></div></div></div></div></div>
            <div class="col-span-6 lg:col-span-3"><div class="card p-6"><div class="flex items-center gap-4"><div class="skeleton-avatar h-12 w-12"></div><div class="space-y-2"><div class="skeleton-text w-20"></div><div class="skeleton-title w-16"></div></div></div></div></div>
            <div class="col-span-6 lg:col-span-3"><div class="card p-6"><div class="flex items-center gap-4"><div class="skeleton-avatar h-12 w-12"></div><div class="space-y-2"><div class="skeleton-text w-20"></div><div class="skeleton-title w-16"></div></div></div></div></div>
            <div class="col-span-6 lg:col-span-3"><div class="card p-6"><div class="flex items-center gap-4"><div class="skeleton-avatar h-12 w-12"></div><div class="space-y-2"><div class="skeleton-text w-20"></div><div class="skeleton-title w-16"></div></div></div></div></div>
          </div>
          <div class="card p-8">
            <div class="skeleton-title w-48 mb-6"></div>
            <div class="space-y-4">
              <div class="flex items-center gap-4 p-4 border border-neutral-200 dark:border-neutral-700"><div class="skeleton-avatar h-10 w-10"></div><div class="space-y-2 flex-1"><div class="skeleton-text w-3/4"></div><div class="skeleton-text w-1/4"></div></div></div>
              <div class="flex items-center gap-4 p-4 border border-neutral-200 dark:border-neutral-700"><div class="skeleton-avatar h-10 w-10"></div><div class="space-y-2 flex-1"><div class="skeleton-text w-3/4"></div><div class="skeleton-text w-1/4"></div></div></div>
            </div>
          </div>
        </div>

        <!-- Not authenticated -->
        <div id="notAuthenticated" class="hidden card p-12 text-center">
          <p class="text-neutral-600 dark:text-neutral-400 mb-6">请登录以查看您的仪表盘。</p>
          <a href="/login" class="btn-primary">登录</a>
        </div>

        <!-- Dashboard content -->
        <div id="dashboardContent" class="hidden space-y-8">
          <!-- User info card -->
          <div class="card p-8">
            <div class="flex items-center gap-6">
              <img id="userAvatar" class="h-24 w-24 rounded-full object-cover border-4 border-white dark:border-neutral-700 shadow-lg" src="" alt="User avatar" />
              <div class="flex-1">
                <h2 id="userDisplayName" class="text-2xl font-black text-neutral-900 dark:text-white"></h2>
                <p id="userEmail" class="text-neutral-600 dark:text-neutral-400 mt-1"></p>
                <span id="userRole" class="inline-flex items-center px-4 py-1.5 rounded-none text-sm font-bold bg-brand-red/10 text-brand-red mt-3"></span>
              </div>
              <button id="logoutBtn" class="btn-primary">
                退出登录
              </button>
            </div>
          </div>

          <!-- Stats section -->
          <div class="grid grid-cols-12 gap-6">
            <div class="col-span-6 lg:col-span-3">
              <div class="card p-6">
                <div class="flex items-center gap-4">
                  <div class="p-4 bg-brand-red/10">
                    <svg class="h-6 w-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-neutral-500">文章总数</p>
                    <p id="postsCount" class="text-3xl font-black text-neutral-900 dark:text-white">0</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-span-6 lg:col-span-3">
              <div class="card p-6">
                <div class="flex items-center gap-4">
                  <div class="p-4 bg-brand-red/10">
                    <svg class="h-6 w-6 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-neutral-500">点赞数</p>
                    <p id="likesCount" class="text-3xl font-black text-neutral-900 dark:text-white">0</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-span-6 lg:col-span-3">
              <div class="card p-6">
                <div class="flex items-center gap-4">
                  <div class="p-4 bg-brand-red/10">
                    <svg class="h-6 w-6 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-neutral-500">收藏数</p>
                    <p id="bookmarksCount" class="text-3xl font-black text-neutral-900 dark:text-white">0</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-span-6 lg:col-span-3">
              <div class="card p-6">
                <div class="flex items-center gap-4">
                  <div class="p-4 bg-brand-red/10">
                    <svg class="h-6 w-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                  </div>
                  <div>
                    <p class="text-sm text-neutral-500">评论数</p>
                    <p id="commentsCount" class="text-3xl font-black text-neutral-900 dark:text-white">0</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Quick links -->
          <div class="card p-8">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white mb-6 flex items-center gap-2">
              <svg class="h-5 w-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
              </svg>
              快捷链接
            </h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
              <a href="/my-likes" class="group flex flex-col items-center p-6 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer card">
                <div class="p-3 bg-brand-red/10 mb-3 group-hover:bg-brand-red/20 transition">
                  <svg class="h-8 w-8 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                  </svg>
                </div>
                <span class="text-sm font-bold text-neutral-700 dark:text-neutral-300 group-hover:text-brand-red transition-colors">我的点赞</span>
              </a>
              <a href="/my-bookmarks" class="group flex flex-col items-center p-6 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer card">
                <div class="p-3 bg-brand-red/10 mb-3 group-hover:bg-brand-red/20 transition">
                  <svg class="h-8 w-8 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                  </svg>
                </div>
                <span class="text-sm font-bold text-neutral-700 dark:text-neutral-300 group-hover:text-brand-red transition-colors">我的收藏</span>
              </a>
              <a href="/my-comments" class="group flex flex-col items-center p-6 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer card">
                <div class="p-3 bg-brand-red/10 mb-3 group-hover:bg-brand-red/20 transition">
                  <svg class="h-8 w-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                  </svg>
                </div>
                <span class="text-sm font-bold text-neutral-700 dark:text-neutral-300 group-hover:text-brand-red transition-colors">我的评论</span>
              </a>
              <a href="/profile" class="group flex flex-col items-center p-6 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer card">
                <div class="p-3 bg-brand-red/10 mb-3 group-hover:bg-brand-red/20 transition">
                  <svg class="h-8 w-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                </div>
                <span class="text-sm font-bold text-neutral-700 dark:text-neutral-300 group-hover:text-brand-red transition-colors">个人设置</span>
              </a>
            </div>
          </div>

          <!-- Recent activity section -->
          <div class="card overflow-hidden p-0">
            <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50">
              <h3 class="text-lg font-bold text-neutral-900 dark:text-white flex items-center gap-2">
                <svg class="h-5 w-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                最近活动
              </h3>
            </div>
            <div class="p-6">
              <div id="recentActivity" class="space-y-3">
                <!-- Activity items will be loaded here -->
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { apiClient } from '../lib/api.js';

    const checkAuth = async () => {
      const loading = document.getElementById('loading');
      const dashboardContent = document.getElementById('dashboardContent');
      const notAuthenticated = document.getElementById('notAuthenticated');

      if (!loading || !dashboardContent || !notAuthenticated) return;

      if (window.authManager?.isLoading) {
        setTimeout(checkAuth, 100);
        return;
      }

      if (!window.authManager?.isAuthenticated || !window.authManager?.currentUser) {
        loading.classList.add('hidden');
        dashboardContent.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      dashboardContent.classList.remove('hidden');
      notAuthenticated.classList.add('hidden');

      const user = window.authManager.currentUser;
      const userDisplayName = document.getElementById('userDisplayName');
      const userEmail = document.getElementById('userEmail');
      const userRole = document.getElementById('userRole');
      const userAvatar = document.getElementById('userAvatar');

      if (userDisplayName) userDisplayName.textContent = user.nickname || user.username;
      if (userEmail) userEmail.textContent = user.email;
      if (userRole) userRole.textContent = user.role;
      if (userAvatar) userAvatar.src = user.avatar || '/images/default-avatar.png';

      try {
        const statsResponse = await apiClient.getDashboardStats();
        if (statsResponse.success) {
          const stats = statsResponse.data;
          const postsCount = document.getElementById('postsCount');
          const likesCount = document.getElementById('likesCount');
          const bookmarksCount = document.getElementById('bookmarksCount');
          const commentsCount = document.getElementById('commentsCount');

          if (postsCount) postsCount.textContent = String(stats?.postsCount ?? 0);
          if (likesCount) likesCount.textContent = String(stats?.likesCount ?? 0);
          if (bookmarksCount) bookmarksCount.textContent = String(stats?.bookmarksCount ?? 0);
          if (commentsCount) commentsCount.textContent = String(stats?.commentsCount ?? 0);
        }

        const activityResponse = await apiClient.getRecentActivity();
        if (activityResponse.success) {
          renderRecentActivity(activityResponse.data);
        }
      } catch (error) {
        console.error('Failed to load dashboard data:', error);
      }

      const logoutBtn = document.getElementById('logoutBtn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          await window.authManager.logout();
          window.location.href = '/';
        });
      }
    };

    const renderRecentActivity = (data) => {
      const container = document.getElementById('recentActivity');
      if (!container) return;

      let html = '';

      if (data.recentLikes && data.recentLikes.length > 0) {
        data.recentLikes.slice(0, 5).forEach((like) => {
          html += `
            <div class="flex items-start gap-3 p-4 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red/50 transition">
              <div class="p-2 bg-brand-red/10 flex-shrink-0">
                <svg class="h-5 w-5 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-neutral-900 dark:text-white truncate">点赞了文章：<strong class="text-brand-red">${like.post?.title || '未知文章'}</strong></p>
                <p class="text-xs text-neutral-500 mt-1">${new Date(like.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      if (data.recentBookmarks && data.recentBookmarks.length > 0) {
        data.recentBookmarks.slice(0, 5).forEach((bookmark) => {
          html += `
            <div class="flex items-start gap-3 p-4 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red/50 transition">
              <div class="p-2 bg-brand-red/10 flex-shrink-0">
                <svg class="h-5 w-5 text-brand-red" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-neutral-900 dark:text-white truncate">收藏了：<strong class="text-brand-red">${bookmark.post?.title || '未知文章'}</strong></p>
                <p class="text-xs text-neutral-500 mt-1">${new Date(bookmark.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      if (data.recentComments && data.recentComments.length > 0) {
        data.recentComments.slice(0, 5).forEach((comment) => {
          html += `
            <div class="flex items-start gap-3 p-4 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red/50 transition">
              <div class="p-2 bg-brand-red/10 flex-shrink-0">
                <svg class="h-5 w-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-neutral-900 dark:text-white line-clamp-1">评论了：<em class="text-brand-red">${comment.content}</em></p>
                <p class="text-xs text-neutral-500 mt-1">${new Date(comment.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      if (!html) {
        html = '<p class="text-neutral-500 text-center py-8">暂无最近活动</p>';
      }

      container.innerHTML = html;
    };

    document.addEventListener('DOMContentLoaded', checkAuth);
  </script>
</Layout>
