---
import Layout from '../layouts/Layout.astro';

const title = '仪表盘 - 博客';
const description = '您的个人仪表盘';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-zinc-950 dark:to-zinc-900 pt-24 pb-12">
    <!-- Page header -->
    <div class="bg-white dark:bg-zinc-900 border-b border-gray-200 dark:border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-gray-900 dark:text-white">仪表盘</h1>
            <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">欢迎回来，查看您的博客数据</p>
          </div>
          <a href="/profile" class="text-sm text-red-600 hover:text-red-700 flex items-center gap-1 transition">
            编辑资料
            <svg class="h-4 w-4 transition-transform hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
      <div id="loading" class="text-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
        <p class="mt-4 text-gray-600 dark:text-gray-400">正在加载仪表盘...</p>
      </div>

      <!-- Not authenticated -->
      <div id="notAuthenticated" class="hidden bg-white dark:bg-zinc-900 shadow-xl rounded-2xl p-12 text-center border border-gray-100 dark:border-zinc-800">
        <p class="text-gray-600 dark:text-gray-400 mb-4">请登录以查看您的仪表盘。</p>
        <a href="/login" class="inline-block bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg transition font-medium shadow-lg shadow-red-600/20 hover:shadow-red-600/30">登录</a>
      </div>

      <!-- Dashboard content -->
      <div id="dashboardContent" class="hidden space-y-6">
        <!-- User info card -->
        <div class="bg-gradient-to-r from-white to-gray-50 dark:from-zinc-900 dark:to-zinc-900/50 shadow-lg rounded-2xl p-8 border border-gray-100 dark:border-zinc-800">
          <div class="flex items-center gap-6">
            <img id="userAvatar" class="h-24 w-24 rounded-full object-cover border-4 border-white dark:border-zinc-700 shadow-lg" src="" alt="User avatar" />
            <div class="flex-1">
              <h2 id="userDisplayName" class="text-2xl font-bold text-gray-900 dark:text-white"></h2>
              <p id="userEmail" class="text-gray-600 dark:text-gray-400 mt-1"></p>
              <span id="userRole" class="inline-flex items-center px-4 py-1.5 rounded-full text-sm font-medium bg-blue-100 text-blue-800 dark:bg-blue-900/50 dark:text-blue-200 mt-3 shadow-sm"></span>
            </div>
            <button id="logoutBtn" class="bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-xl transition shadow-lg shadow-red-600/20 hover:shadow-red-600/30 font-medium">
              退出登录
            </button>
          </div>
        </div>

        <!-- Stats section -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white dark:bg-zinc-900 shadow-lg rounded-2xl p-6 border border-gray-100 dark:border-zinc-800 hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-4">
              <div class="p-4 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl shadow-lg shadow-blue-500/30">
                <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">文章总数</p>
                <p id="postsCount" class="text-3xl font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-zinc-900 shadow-lg rounded-2xl p-6 border border-gray-100 dark:border-zinc-800 hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-4">
              <div class="p-4 bg-gradient-to-br from-red-500 to-red-600 rounded-xl shadow-lg shadow-red-500/30">
                <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">点赞数</p>
                <p id="likesCount" class="text-3xl font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-zinc-900 shadow-lg rounded-2xl p-6 border border-gray-100 dark:border-zinc-800 hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-4">
              <div class="p-4 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-xl shadow-lg shadow-yellow-500/30">
                <svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">收藏数</p>
                <p id="bookmarksCount" class="text-3xl font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-zinc-900 shadow-lg rounded-2xl p-6 border border-gray-100 dark:border-zinc-800 hover:shadow-xl transition-shadow duration-300">
            <div class="flex items-center gap-4">
              <div class="p-4 bg-gradient-to-br from-green-500 to-green-600 rounded-xl shadow-lg shadow-green-500/30">
                <svg class="h-6 w-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">评论数</p>
                <p id="commentsCount" class="text-3xl font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick links -->
        <div class="bg-white dark:bg-zinc-900 shadow-lg rounded-2xl p-8 border border-gray-100 dark:border-zinc-800">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
            <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
            </svg>
            快捷链接
          </h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <a href="/my-likes" class="group flex flex-col items-center p-6 bg-gradient-to-br from-red-50 to-white dark:from-zinc-800 dark:to-zinc-800/50 rounded-2xl border border-red-100 dark:border-zinc-700 hover:border-red-300 dark:hover:border-red-800 hover:shadow-lg hover:shadow-red-500/10 transition-all duration-300">
              <div class="p-3 bg-red-100 dark:bg-red-900/30 rounded-xl mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="h-8 w-8 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-red-600 dark:group-hover:text-red-400 transition-colors">我的点赞</span>
            </a>
            <a href="/my-bookmarks" class="group flex flex-col items-center p-6 bg-gradient-to-br from-yellow-50 to-white dark:from-zinc-800 dark:to-zinc-800/50 rounded-2xl border border-yellow-100 dark:border-zinc-700 hover:border-yellow-300 dark:hover:border-yellow-800 hover:shadow-lg hover:shadow-yellow-500/10 transition-all duration-300">
              <div class="p-3 bg-yellow-100 dark:bg-yellow-900/30 rounded-xl mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="h-8 w-8 text-yellow-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
              </div>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-yellow-600 dark:group-hover:text-yellow-400 transition-colors">我的收藏</span>
            </a>
            <a href="/my-comments" class="group flex flex-col items-center p-6 bg-gradient-to-br from-green-50 to-white dark:from-zinc-800 dark:to-zinc-800/50 rounded-2xl border border-green-100 dark:border-zinc-700 hover:border-green-300 dark:hover:border-green-800 hover:shadow-lg hover:shadow-green-500/10 transition-all duration-300">
              <div class="p-3 bg-green-100 dark:bg-green-900/30 rounded-xl mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-green-600 dark:group-hover:text-green-400 transition-colors">我的评论</span>
            </a>
            <a href="/profile" class="group flex flex-col items-center p-6 bg-gradient-to-br from-blue-50 to-white dark:from-zinc-800 dark:to-zinc-800/50 rounded-2xl border border-blue-100 dark:border-zinc-700 hover:border-blue-300 dark:hover:border-blue-800 hover:shadow-lg hover:shadow-blue-500/10 transition-all duration-300">
              <div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-xl mb-3 group-hover:scale-110 transition-transform duration-300">
                <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <span class="text-sm font-medium text-gray-700 dark:text-gray-300 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">个人设置</span>
            </a>
          </div>
        </div>

        <!-- Recent activity section -->
        <div class="bg-white dark:bg-zinc-900 shadow-lg rounded-2xl border border-gray-100 dark:border-zinc-800 overflow-hidden">
          <div class="px-6 py-5 border-b border-gray-200 dark:border-zinc-800 bg-gradient-to-r from-gray-50 to-white dark:from-zinc-900/50 dark:to-zinc-900">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
              <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              最近活动
            </h3>
          </div>
          <div class="p-6">
            <div id="recentActivity" class="space-y-3">
              <!-- Activity items will be loaded here -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    /** @typedef {{ id: string; username: string; email: string; nickname?: string; avatar?: string; role: string }} User */
    /** @typedef {{ isLoading: boolean; isAuthenticated: boolean; currentUser: User | null; logout: () => Promise<void> }} AuthManager */
    /** @typedef {{ postsCount: number; likesCount: number; bookmarksCount: number; commentsCount: number }} DashboardStats */
    /** @typedef {{ recentLikes?: Array<{ id: string; post?: { title: string }; createdAt: string }>; recentBookmarks?: Array<{ id: string; post?: { title: string }; createdAt: string }>; recentComments?: Array<{ id: string; content: string; createdAt: string }>; }} RecentActivityData */

    // Wait for auth to initialize
    const checkAuth = async () => {
      const loading = document.getElementById('loading');
      const dashboardContent = document.getElementById('dashboardContent');
      const notAuthenticated = document.getElementById('notAuthenticated');

      if (!loading || !dashboardContent || !notAuthenticated) return;

      // @ts-ignore - authManager is attached to window by auth initialization
      if (window.authManager?.isLoading) {
        setTimeout(checkAuth, 100);
        return;
      }

      // @ts-ignore - authManager is attached to window by auth initialization
      if (!window.authManager?.isAuthenticated || !window.authManager?.currentUser) {
        // Show not authenticated view
        loading.classList.add('hidden');
        dashboardContent.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      // User is authenticated, load dashboard data
      loading.classList.add('hidden');
      dashboardContent.classList.remove('hidden');
      notAuthenticated.classList.add('hidden');

      // Populate user info
      // @ts-ignore - authManager is attached to window by auth initialization
      const user = window.authManager.currentUser;
      const userDisplayName = document.getElementById('userDisplayName');
      const userEmail = document.getElementById('userEmail');
      const userRole = document.getElementById('userRole');
      const userAvatar = document.getElementById('userAvatar');

      if (userDisplayName) userDisplayName.textContent = user.nickname || user.username;
      if (userEmail) userEmail.textContent = user.email;
      if (userRole) userRole.textContent = user.role;
      if (userAvatar) (userAvatar as HTMLImageElement).src = user.avatar || '/images/default-avatar.png';

      // Load dashboard stats
      try {
        const statsResponse = await fetch('/api/dashboard/stats').then(res => res.json());
        if (statsResponse.success) {
          const stats = statsResponse.data;
          const postsCount = document.getElementById('postsCount');
          const likesCount = document.getElementById('likesCount');
          const bookmarksCount = document.getElementById('bookmarksCount');
          const commentsCount = document.getElementById('commentsCount');

          if (postsCount) postsCount.textContent = stats.postsCount || 0;
          if (likesCount) likesCount.textContent = stats.likesCount || 0;
          if (bookmarksCount) bookmarksCount.textContent = stats.bookmarksCount || 0;
          if (commentsCount) commentsCount.textContent = stats.commentsCount || 0;
        }

        const activityResponse = await fetch('/api/dashboard/activity').then(res => res.json());
        if (activityResponse.success) {
          renderRecentActivity(activityResponse.data);
        }
      } catch (error) {
        console.error('Failed to load dashboard data:', error);
      }

      // Setup logout button
      const logoutBtn = document.getElementById('logoutBtn');
      if (logoutBtn) {
        logoutBtn.addEventListener('click', async () => {
          // @ts-ignore - authManager is attached to window by auth initialization
          await window.authManager.logout();
          window.location.href = '/';
        });
      }
    };

    // @ts-ignore - JSDoc types for Astro client scripts
    const renderRecentActivity = (data) => {
      const container = document.getElementById('recentActivity');
      if (!container) return;

      let html = '';

      // Recent likes
      if (data.recentLikes && data.recentLikes.length > 0) {
        // @ts-ignore - forEach callback
        data.recentLikes.slice(0, 5).forEach((like) => {
          html += `
            <div class="flex items-start gap-3 p-4 bg-gradient-to-r from-red-50 to-transparent dark:from-zinc-800 rounded-xl border border-red-100 dark:border-zinc-700 hover:border-red-200 dark:hover:border-red-900 transition-all">
              <div class="p-2 bg-red-100 dark:bg-red-900/30 rounded-lg flex-shrink-0">
                <svg class="h-5 w-5 text-red-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-900 dark:text-white truncate">点赞了文章：<strong class="text-red-600 dark:text-red-400">${like.post?.title || '未知文章'}</strong></p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">${new Date(like.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      // Recent bookmarks
      if (data.recentBookmarks && data.recentBookmarks.length > 0) {
        // @ts-ignore - forEach callback
        data.recentBookmarks.slice(0, 5).forEach((bookmark) => {
          html += `
            <div class="flex items-start gap-3 p-4 bg-gradient-to-r from-yellow-50 to-transparent dark:from-zinc-800 rounded-xl border border-yellow-100 dark:border-zinc-700 hover:border-yellow-200 dark:hover:border-yellow-900 transition-all">
              <div class="p-2 bg-yellow-100 dark:bg-yellow-900/30 rounded-lg flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-900 dark:text-white truncate">收藏了：<strong class="text-yellow-600 dark:text-yellow-400">${bookmark.post?.title || '未知文章'}</strong></p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">${new Date(bookmark.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      // Recent comments
      if (data.recentComments && data.recentComments.length > 0) {
        // @ts-ignore - forEach callback
        data.recentComments.slice(0, 5).forEach((comment) => {
          html += `
            <div class="flex items-start gap-3 p-4 bg-gradient-to-r from-green-50 to-transparent dark:from-zinc-800 rounded-xl border border-green-100 dark:border-zinc-700 hover:border-green-200 dark:hover:border-green-900 transition-all">
              <div class="p-2 bg-green-100 dark:bg-green-900/30 rounded-lg flex-shrink-0">
                <svg class="h-5 w-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-900 dark:text-white line-clamp-1">评论了：<em class="text-green-600 dark:text-green-400">${comment.content}</em></p>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">${new Date(comment.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      if (!html) {
        html = '<p class="text-gray-500 dark:text-gray-400 text-center py-8">暂无最近活动</p>';
      }

      container.innerHTML = html;
    };

    // Initialize dashboard when DOM is ready
    document.addEventListener('DOMContentLoaded', checkAuth);
  </script>
</Layout>
