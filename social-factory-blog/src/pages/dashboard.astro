---
import Layout from '../layouts/Layout.astro';
import { apiClient } from '../lib/api.js';

const title = 'Dashboard - Blog';
const description = 'Your personal dashboard';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gray-50 dark:bg-zinc-950">
    <!-- Page header -->
    <div class="bg-white dark:bg-zinc-900 border-b border-gray-200 dark:border-zinc-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex items-center justify-between">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Dashboard</h1>
          <a href="/profile" class="text-sm text-red-600 hover:text-red-700 flex items-center gap-1">
            Edit Profile
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div id="loading" class="text-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
        <p class="mt-4 text-gray-600 dark:text-gray-400">Loading dashboard...</p>
      </div>

      <!-- Not authenticated -->
      <div id="notAuthenticated" class="hidden bg-white dark:bg-zinc-900 shadow rounded-lg p-12 text-center">
        <p class="text-gray-600 dark:text-gray-400 mb-4">Please log in to view your dashboard.</p>
        <a href="/login" class="inline-block bg-red-600 hover:bg-red-700 text-white px-6 py-3 rounded-lg transition font-medium">Login</a>
      </div>

      <!-- Dashboard content -->
      <div id="dashboardContent" class="hidden space-y-8">
        <!-- User info card -->
        <div class="bg-white dark:bg-zinc-900 shadow rounded-lg p-6">
          <div class="flex items-center gap-6">
            <img id="userAvatar" class="h-20 w-20 rounded-full object-cover border-2 border-gray-200 dark:border-zinc-700" src="" alt="User avatar" />
            <div class="flex-1">
              <h2 id="userDisplayName" class="text-xl font-bold text-gray-900 dark:text-white"></h2>
              <p id="userEmail" class="text-gray-600 dark:text-gray-400"></p>
              <span id="userRole" class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200 mt-2"></span>
            </div>
            <button id="logoutBtn" class="bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg transition">
              Logout
            </button>
          </div>
        </div>

        <!-- Stats section -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <div class="bg-white dark:bg-zinc-900 shadow rounded-lg p-6">
            <div class="flex items-center gap-4">
              <div class="p-3 bg-blue-100 dark:bg-blue-900 rounded-lg">
                <svg class="h-6 w-6 text-blue-600 dark:text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Posts</p>
                <p id="postsCount" class="text-2xl font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-zinc-900 shadow rounded-lg p-6">
            <div class="flex items-center gap-4">
              <div class="p-3 bg-red-100 dark:bg-red-900 rounded-lg">
                <svg class="h-6 w-6 text-red-600 dark:text-red-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Likes Given</p>
                <p id="likesCount" class="text-2xl font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-zinc-900 shadow rounded-lg p-6">
            <div class="flex items-center gap-4">
              <div class="p-3 bg-yellow-100 dark:bg-yellow-900 rounded-lg">
                <svg class="h-6 w-6 text-yellow-600 dark:text-yellow-400" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Bookmarks</p>
                <p id="bookmarksCount" class="text-2xl font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>

          <div class="bg-white dark:bg-zinc-900 shadow rounded-lg p-6">
            <div class="flex items-center gap-4">
              <div class="p-3 bg-green-100 dark:bg-green-900 rounded-lg">
                <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-500 dark:text-gray-400">Comments</p>
                <p id="commentsCount" class="text-2xl font-bold text-gray-900 dark:text-white">0</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick links -->
        <div class="bg-white dark:bg-zinc-900 shadow rounded-lg p-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Quick Links</h3>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <a href="/my-likes" class="flex flex-col items-center p-4 bg-gray-50 dark:bg-zinc-800 rounded-lg hover:bg-red-50 dark:hover:bg-zinc-700 transition group">
              <svg class="h-8 w-8 text-red-600 mb-2 group-hover:scale-110 transition" fill="currentColor" viewBox="0 0 24 24">
                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
              <span class="text-sm text-gray-700 dark:text-gray-300">My Likes</span>
            </a>
            <a href="/my-bookmarks" class="flex flex-col items-center p-4 bg-gray-50 dark:bg-zinc-800 rounded-lg hover:bg-yellow-50 dark:hover:bg-zinc-700 transition group">
              <svg class="h-8 w-8 text-yellow-600 mb-2 group-hover:scale-110 transition" fill="currentColor" viewBox="0 0 24 24">
                <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
              </svg>
              <span class="text-sm text-gray-700 dark:text-gray-300">Bookmarks</span>
            </a>
            <a href="/my-comments" class="flex flex-col items-center p-4 bg-gray-50 dark:bg-zinc-800 rounded-lg hover:bg-green-50 dark:hover:bg-zinc-700 transition group">
              <svg class="h-8 w-8 text-green-600 mb-2 group-hover:scale-110 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              <span class="text-sm text-gray-700 dark:text-gray-300">Comments</span>
            </a>
            <a href="/profile" class="flex flex-col items-center p-4 bg-gray-50 dark:bg-zinc-800 rounded-lg hover:bg-blue-50 dark:hover:bg-zinc-700 transition group">
              <svg class="h-8 w-8 text-blue-600 mb-2 group-hover:scale-110 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              <span class="text-sm text-gray-700 dark:text-gray-300">Profile</span>
            </a>
          </div>
        </div>

        <!-- Recent activity section -->
        <div class="bg-white dark:bg-zinc-900 shadow rounded-lg">
          <div class="px-6 py-4 border-b border-gray-200 dark:border-zinc-800">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Recent Activity</h3>
          </div>
          <div class="p-6">
            <div id="recentActivity" class="space-y-3">
              <!-- Activity items will be loaded here -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Wait for auth to initialize
    const checkAuth = async () => {
      const loading = document.getElementById('loading');
      const dashboardContent = document.getElementById('dashboardContent');
      const notAuthenticated = document.getElementById('notAuthenticated');

      if (window.authManager.isLoading) {
        setTimeout(checkAuth, 100);
        return;
      }

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      // User is authenticated, load dashboard data
      loading.classList.add('hidden');
      dashboardContent.classList.remove('hidden');

      // Populate user info
      const user = window.authManager.currentUser;
      document.getElementById('userDisplayName').textContent = user.nickname || user.username;
      document.getElementById('userEmail').textContent = user.email;
      document.getElementById('userRole').textContent = user.role;
      document.getElementById('userAvatar').src = user.avatar || '/images/default-avatar.png';

      // Load dashboard stats
      try {
        const statsResponse = await apiClient.getDashboardStats();
        if (statsResponse.success) {
          const stats = statsResponse.data;
          document.getElementById('postsCount').textContent = stats.postsCount || 0;
          document.getElementById('likesCount').textContent = stats.likesCount || 0;
          document.getElementById('bookmarksCount').textContent = stats.bookmarksCount || 0;
          document.getElementById('commentsCount').textContent = stats.commentsCount || 0;
        }

        const activityResponse = await apiClient.getRecentActivity();
        if (activityResponse.success) {
          renderRecentActivity(activityResponse.data);
        }
      } catch (error) {
        console.error('Failed to load dashboard data:', error);
      }

      // Setup logout button
      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await window.authManager.logout();
        window.location.href = '/';
      });
    };

    const renderRecentActivity = (data) => {
      const container = document.getElementById('recentActivity');
      let html = '';

      // Recent likes
      if (data.recentLikes && data.recentLikes.length > 0) {
        data.recentLikes.slice(0, 5).forEach(like => {
          html += `
            <div class="flex items-start gap-3 p-3 bg-gray-50 dark:bg-zinc-800 rounded-lg">
              <svg class="h-5 w-5 text-red-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
              </svg>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-900 dark:text-white truncate">Liked post: <strong>${like.post?.title || 'Unknown Post'}</strong></p>
                <p class="text-xs text-gray-500 dark:text-gray-400">${new Date(like.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      // Recent bookmarks
      if (data.recentBookmarks && data.recentBookmarks.length > 0) {
        data.recentBookmarks.slice(0, 5).forEach(bookmark => {
          html += `
            <div class="flex items-start gap-3 p-3 bg-gray-50 dark:bg-zinc-800 rounded-lg">
              <svg class="h-5 w-5 text-yellow-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
                <path d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"/>
              </svg>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-900 dark:text-white truncate">Bookmarked: <strong>${bookmark.post?.title || 'Unknown Post'}</strong></p>
                <p class="text-xs text-gray-500 dark:text-gray-400">${new Date(bookmark.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      // Recent comments
      if (data.recentComments && data.recentComments.length > 0) {
        data.recentComments.slice(0, 5).forEach(comment => {
          html += `
            <div class="flex items-start gap-3 p-3 bg-gray-50 dark:bg-zinc-800 rounded-lg">
              <svg class="h-5 w-5 text-green-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-gray-900 dark:text-white truncate">Commented: <em class="line-clamp-1">${comment.content}</em></p>
                <p class="text-xs text-gray-500 dark:text-gray-400">${new Date(comment.createdAt).toLocaleDateString()}</p>
              </div>
            </div>
          `;
        });
      }

      if (!html) {
        html = '<p class="text-gray-500 dark:text-gray-400 text-center py-4">No recent activity yet</p>';
      }

      container.innerHTML = html;
    };

    // Initialize dashboard when DOM is ready
    document.addEventListener('DOMContentLoaded', checkAuth);
  </script>
</Layout>
