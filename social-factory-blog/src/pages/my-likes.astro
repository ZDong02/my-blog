---
import Layout from '../layouts/Layout.astro';

const title = '我的点赞';
const description = '您点赞过的文章';
---

<Layout title={title} description={description}>
  <main class="min-h-screen pt-24 pb-12">
    <!-- Hero Section -->
    <section class="py-12 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-4">
          <a href="/dashboard" class="p-2 text-neutral-600 dark:text-neutral-400 hover:text-white hover:bg-brand-red transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <span class="text-neutral-500">仪表盘</span>
        </div>
        <h1 class="text-3xl font-black text-neutral-900 dark:text-white">我的点赞</h1>
        <p class="text-neutral-600 dark:text-neutral-400 mt-2">您点赞过的文章会保存在这里</p>
      </div>
    </section>

    <section class="py-12 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Loading -->
        <div id="loading" class="text-center py-16">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">正在加载...</p>
        </div>

        <!-- Not authenticated -->
        <div id="notAuthenticated" class="hidden card p-12 text-center">
          <div class="w-20 h-20 mx-auto mb-6 bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center">
            <svg class="h-10 w-10 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <p class="text-neutral-600 dark:text-neutral-400 mb-6">请登录以查看您的点赞。</p>
          <a href="/login" class="btn-primary">登录</a>
        </div>

        <!-- No likes -->
        <div id="noLikes" class="hidden card p-12 text-center">
          <div class="w-20 h-20 mx-auto mb-6 bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center">
            <svg class="h-10 w-10 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
          </div>
          <p class="text-neutral-600 dark:text-neutral-400 mb-6">您还没有点赞任何文章。</p>
          <a href="/blog" class="btn-primary">浏览文章</a>
        </div>

        <!-- Likes list -->
        <div id="likesList" class="hidden space-y-4"></div>

        <!-- Pagination -->
        <div id="pagination" class="hidden mt-8 flex items-center justify-center gap-4">
          <button id="prevBtn" class="btn-secondary px-6 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
            上一页
          </button>
          <span id="pageInfo" class="text-sm font-bold text-neutral-500 px-4">第 1 页</span>
          <button id="nextBtn" class="btn-secondary px-6 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
            下一页
          </button>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { apiClient } from '../lib/api.js';

    let currentPage = 1;
    let totalPages = 1;

    const checkAuthAndLoad = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAuthAndLoad, 100);
        return;
      }

      const loading = document.getElementById('loading');
      const notAuthenticated = document.getElementById('notAuthenticated');

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      loadLikes();
    };

    const loadLikes = async () => {
      const likesList = document.getElementById('likesList');
      const noLikes = document.getElementById('noLikes');
      const pagination = document.getElementById('pagination');

      try {
        const response = await apiClient.getMyLikes(currentPage, 10);

        if (response.success && response.data) {
          const { content, total, size, number } = response.data;
          currentPage = number;
          totalPages = Math.ceil(total / size);

          if (!content || content.length === 0) {
            likesList.classList.add('hidden');
            pagination.classList.add('hidden');
            noLikes.classList.remove('hidden');
            return;
          }

          noLikes.classList.add('hidden');
          likesList.classList.remove('hidden');
          pagination.classList.remove('hidden');

          let html = '';
          content.forEach(like => {
            const post = like.post;
            if (!post) return;

            html += `
              <a href="/blog/${post.id}" class="group block card p-0 overflow-hidden hover:border-brand-red transition cursor-pointer">
                <div class="flex">
                  ${post.featuredImage ? `
                    <div class="w-48 h-36 flex-shrink-0 overflow-hidden">
                      <img src="${post.featuredImage}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                    </div>
                  ` : ''}
                  <div class="flex-1 p-6">
                    <div class="flex items-center gap-2 mb-3">
                      <span class="badge-red">${post.category?.name || '未分类'}</span>
                    </div>
                    <h3 class="text-lg font-bold text-neutral-900 dark:text-white group-hover:text-brand-red transition-colors line-clamp-1 mb-2">${post.title}</h3>
                    <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2">${post.summary || post.content?.substring(0, 150) || ''}</p>
                    <div class="flex items-center gap-5 mt-4 text-xs text-neutral-500">
                      <span class="flex items-center gap-1.5">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        </svg>
                        ${post.likeCount || 0}
                      </span>
                      <span class="flex items-center gap-1.5">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        ${post.commentCount || 0}
                      </span>
                      <span class="ml-auto">${new Date(post.createdAt).toLocaleDateString()}</span>
                    </div>
                  </div>
                </div>
              </a>
            `;
          });

          likesList.innerHTML = html;
          document.getElementById('pageInfo').textContent = `第 ${currentPage} 页，共 ${totalPages} 页`;
          document.getElementById('prevBtn').disabled = currentPage <= 1;
          document.getElementById('nextBtn').disabled = currentPage >= totalPages;
        }
      } catch (error) {
        console.error('Failed to load likes:', error);
      }
    };

    document.getElementById('prevBtn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        loadLikes();
      }
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        loadLikes();
      }
    });

    document.addEventListener('DOMContentLoaded', checkAuthAndLoad);
  </script>
</Layout>
