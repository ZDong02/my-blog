---
import Layout from '../layouts/Layout.astro';

const title = '我的点赞';
const description = '您点赞过的文章';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-zinc-950 dark:to-zinc-900 pt-24 pb-12 px-4">
    <div class="max-w-6xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <a href="/dashboard" class="p-2 text-gray-600 dark:text-gray-400 hover:text-white hover:bg-red-600 rounded-lg transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">我的点赞</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-1">您点赞过的文章会保存在这里</p>
          </div>
        </div>
      </div>

      <!-- Loading -->
      <div id="loading" class="text-center py-16">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
        <p class="mt-4 text-gray-600 dark:text-gray-400">正在加载您的点赞...</p>
      </div>

      <!-- Not authenticated -->
      <div id="notAuthenticated" class="hidden bg-white dark:bg-zinc-900 shadow-xl rounded-2xl p-12 text-center border border-gray-100 dark:border-zinc-800">
        <svg class="h-16 w-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <p class="text-gray-600 dark:text-gray-400 mb-4">请登录以查看您的点赞。</p>
        <a href="/login" class="inline-block bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg transition shadow-lg shadow-red-600/20">登录</a>
      </div>

      <!-- No likes -->
      <div id="noLikes" class="hidden bg-white dark:bg-zinc-900 shadow-xl rounded-2xl p-12 text-center border border-gray-100 dark:border-zinc-800">
        <svg class="h-16 w-16 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
        </svg>
        <p class="mt-4 text-gray-600 dark:text-gray-400">您还没有点赞任何文章。</p>
        <a href="/blog" class="inline-block mt-4 text-red-600 hover:text-red-700 font-medium">浏览文章 →</a>
      </div>

      <!-- Likes list -->
      <div id="likesList" class="hidden space-y-4">
        <!-- Posts will be loaded here -->
      </div>

      <!-- Pagination -->
      <div id="pagination" class="hidden mt-8 flex items-center justify-center gap-4">
        <button id="prevBtn" class="px-5 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed font-medium">
          上一页
        </button>
        <span id="pageInfo" class="text-sm font-medium text-gray-600 dark:text-gray-400 px-4">第 1 页</span>
        <button id="nextBtn" class="px-5 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed font-medium">
          下一页
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../lib/api.js';

    let currentPage = 1;
    let totalPages = 1;

    const checkAuthAndLoad = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAuthAndLoad, 100);
        return;
      }

      const loading = document.getElementById('loading');
      const notAuthenticated = document.getElementById('notAuthenticated');

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      loadLikes();
    };

    const loadLikes = async () => {
      const likesList = document.getElementById('likesList');
      const noLikes = document.getElementById('noLikes');
      const pagination = document.getElementById('pagination');

      try {
        const response = await apiClient.getMyLikes(currentPage, 10);

        if (response.success && response.data) {
          const { content, total, size, number } = response.data;
          currentPage = number;
          totalPages = Math.ceil(total / size);

          if (content.length === 0) {
            likesList.classList.add('hidden');
            pagination.classList.add('hidden');
            noLikes.classList.remove('hidden');
            return;
          }

          noLikes.classList.add('hidden');
          likesList.classList.remove('hidden');
          pagination.classList.remove('hidden');

          let html = '';
          content.forEach(like => {
            const post = like.post;
            if (!post) return;

            html += `
              <a href="/blog/${post.id}" class="group block bg-white dark:bg-zinc-900 shadow-lg rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-zinc-800">
                <div class="flex">
                  ${post.featuredImage ? `
                    <div class="w-48 h-36 flex-shrink-0 overflow-hidden">
                      <img src="${post.featuredImage}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
                    </div>
                  ` : ''}
                  <div class="flex-1 p-5">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="px-2.5 py-0.5 bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 text-xs font-medium rounded-full uppercase">
                        ${post.category?.name || '未分类'}
                      </span>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-red-600 transition-colors line-clamp-1">${post.title}</h3>
                    <p class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2 mt-2">${post.summary || post.content?.substring(0, 150) || ''}</p>
                    <div class="flex items-center gap-5 mt-4 text-xs text-gray-500 dark:text-gray-400">
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                          <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        </svg>
                        ${post.likeCount || 0}
                      </span>
                      <span class="flex items-center gap-1">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                        </svg>
                        ${post.commentCount || 0}
                      </span>
                      <span class="ml-auto text-gray-400">${new Date(post.createdAt).toLocaleDateString()}</span>
                    </div>
                  </div>
                </div>
              </a>
            `;
          });

          likesList.innerHTML = html;
          document.getElementById('pageInfo').textContent = `第 ${currentPage} 页，共 ${totalPages} 页`;
          document.getElementById('prevBtn').disabled = currentPage <= 1;
          document.getElementById('nextBtn').disabled = currentPage >= totalPages;
        }
      } catch (error) {
        console.error('Failed to load likes:', error);
        showError('加载点赞文章失败');
      }
    };

    // Pagination
    document.getElementById('prevBtn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        loadLikes();
      }
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        loadLikes();
      }
    });

    document.addEventListener('DOMContentLoaded', checkAuthAndLoad);
  </script>
</Layout>
