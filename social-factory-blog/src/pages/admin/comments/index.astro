---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const title = '评论管理 - 管理员';
const description = '管理博客评论';
---

<AdminLayout title={title} description={description}>
  <div class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-8 flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-black text-neutral-900 dark:text-white">评论管理</h1>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">审核和管理所有评论</p>
        </div>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-12 gap-6 mb-8">
        <div class="col-span-6 lg:col-span-3">
          <div class="card p-6">
            <div class="flex items-center gap-4">
              <div class="p-4 bg-blue-500/10">
                <svg class="h-6 w-6 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-neutral-500">全部评论</p>
                <p id="statTotal" class="text-3xl font-black text-neutral-900 dark:text-white">-</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-span-6 lg:col-span-3">
          <div class="card p-6">
            <div class="flex items-center gap-4">
              <div class="p-4 bg-green-500/10">
                <svg class="h-6 w-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-neutral-500">已通过</p>
                <p id="statApproved" class="text-3xl font-black text-neutral-900 dark:text-white">-</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-span-6 lg:col-span-3">
          <div class="card p-6">
            <div class="flex items-center gap-4">
              <div class="p-4 bg-yellow-500/10">
                <svg class="h-6 w-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-neutral-500">待审核</p>
                <p id="statPending" class="text-3xl font-black text-neutral-900 dark:text-white">-</p>
              </div>
            </div>
          </div>
        </div>
        <div class="col-span-6 lg:col-span-3">
          <div class="card p-6">
            <div class="flex items-center gap-4">
              <div class="p-4 bg-red-500/10">
                <svg class="h-6 w-6 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="text-sm text-neutral-500">已拒绝</p>
                <p id="statRejected" class="text-3xl font-black text-neutral-900 dark:text-white">-</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Filters & Batch Actions -->
      <div class="card p-0 mb-6">
        <div class="p-4 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <select id="filterStatus" class="px-3 py-2 text-sm border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white rounded-none focus:outline-none focus:border-brand-red">
              <option value="">全部状态</option>
              <option value="1">已通过</option>
              <option value="0">待审核</option>
              <option value="2">已拒绝</option>
            </select>
            <button onclick="loadComments()" class="btn-primary px-4 py-2 text-xs">筛选</button>
          </div>
          <div id="batchActions" class="hidden flex items-center gap-3">
            <span id="selectedCount" class="text-sm text-neutral-500">已选 0 条</span>
            <button onclick="batchAction('approve')" class="px-3 py-2 text-xs font-bold border border-green-500 text-green-600 hover:bg-green-50 dark:hover:bg-green-500/10 transition">批量通过</button>
            <button onclick="batchAction('reject')" class="px-3 py-2 text-xs font-bold border border-yellow-500 text-yellow-600 hover:bg-yellow-50 dark:hover:bg-yellow-500/10 transition">批量拒绝</button>
            <button onclick="batchAction('delete')" class="px-3 py-2 text-xs font-bold border border-red-500 text-red-500 hover:bg-red-50 dark:hover:bg-red-500/10 transition">批量删除</button>
          </div>
        </div>
      </div>

      <!-- Comments Table -->
      <div class="card p-0 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead>
              <tr class="border-b border-neutral-200 dark:border-neutral-700">
                <th class="px-4 py-3 text-left">
                  <input type="checkbox" id="selectAll" onchange="toggleSelectAll()" class="rounded-none" />
                </th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-neutral-500">评论者</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-neutral-500">内容</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-neutral-500">文章</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-neutral-500">状态</th>
                <th class="px-4 py-3 text-left text-xs font-bold uppercase tracking-wider text-neutral-500">时间</th>
                <th class="px-4 py-3 text-right text-xs font-bold uppercase tracking-wider text-neutral-500">操作</th>
              </tr>
            </thead>
            <tbody id="commentsTableBody">
              <tr><td colspan="7" class="px-4 py-10 text-center text-neutral-500">加载中...</td></tr>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="px-4 py-4 border-t border-neutral-200 dark:border-neutral-700 flex items-center justify-between">
          <p id="paginationInfo" class="text-sm text-neutral-500"></p>
          <div class="flex items-center gap-2">
            <button id="prevPage" onclick="changePage(-1)" class="px-4 py-2 text-xs font-bold border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:border-brand-red transition disabled:opacity-50" disabled>上一页</button>
            <span id="pageInfo" class="text-sm text-neutral-500 px-3"></span>
            <button id="nextPage" onclick="changePage(1)" class="px-4 py-2 text-xs font-bold border border-neutral-200 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 hover:border-brand-red transition disabled:opacity-50" disabled>下一页</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../../../lib/api.js';

    let currentPage = 1;
    const pageSize = 20;
    let totalPages = 1;
    let selectedIds = new Set();

    const escapeHtml = (value = '') => String(value)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;').replace(/'/g, '&#039;');

    const loadStats = async () => {
      try {
        const res = await apiClient.getCommentStats();
        if (res.success && res.data) {
          document.getElementById('statTotal').textContent = res.data.total ?? 0;
          document.getElementById('statApproved').textContent = res.data.approved ?? 0;
          document.getElementById('statPending').textContent = res.data.pending ?? 0;
          document.getElementById('statRejected').textContent = res.data.rejected ?? 0;
        }
      } catch (e) { console.error('Failed to load stats', e); }
    };

    const loadComments = async () => {
      const statusFilter = document.getElementById('filterStatus').value;
      const status = statusFilter !== '' ? parseInt(statusFilter) : null;

      try {
        const res = await apiClient.getAdminComments(currentPage, pageSize, status);
        if (res.success && res.data) {
          const { list, total, page, hasNext, hasPrev } = res.data;
          totalPages = Math.ceil(total / pageSize) || 1;
          renderTable(list || []);
          document.getElementById('paginationInfo').textContent = `共 ${total} 条评论`;
          document.getElementById('pageInfo').textContent = `${page} / ${totalPages}`;
          document.getElementById('prevPage').disabled = !hasPrev;
          document.getElementById('nextPage').disabled = !hasNext;
        }
      } catch (e) {
        console.error('Failed to load comments', e);
        document.getElementById('commentsTableBody').innerHTML =
          '<tr><td colspan="7" class="px-4 py-10 text-center text-red-500">加载失败</td></tr>';
      }
    };

    const renderTable = (comments) => {
      const tbody = document.getElementById('commentsTableBody');
      if (!comments.length) {
        tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-10 text-center text-neutral-500">暂无评论</td></tr>';
        return;
      }

      const statusBadge = (s) => {
        if (s === 1) return '<span class="px-2 py-1 text-xs font-bold bg-green-500/10 text-green-600 border border-green-500/20">已通过</span>';
        if (s === 0) return '<span class="px-2 py-1 text-xs font-bold bg-yellow-500/10 text-yellow-600 border border-yellow-500/20">待审核</span>';
        return '<span class="px-2 py-1 text-xs font-bold bg-red-500/10 text-red-600 border border-red-500/20">已拒绝</span>';
      };

      tbody.innerHTML = comments.map(c => `
        <tr class="border-b border-neutral-100 dark:border-neutral-800 hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition">
          <td class="px-4 py-3">
            <input type="checkbox" value="${c.id}" onchange="toggleSelect(${c.id})" ${selectedIds.has(c.id) ? 'checked' : ''} class="rounded-none comment-checkbox" />
          </td>
          <td class="px-4 py-3">
            <div class="flex items-center gap-2">
              <img src="${apiClient.resolveMediaUrl(c.user?.avatar) || '/images/default-avatar.png'}" class="h-8 w-8 rounded-full object-cover" alt="" />
              <div>
                <p class="text-sm font-bold text-neutral-900 dark:text-white">${escapeHtml(c.user?.nickname || c.user?.username || '未知')}</p>
                <p class="text-xs text-neutral-400">${c.parentId ? '回复' : '顶级评论'}</p>
              </div>
            </div>
          </td>
          <td class="px-4 py-3 max-w-xs">
            <p class="text-sm text-neutral-700 dark:text-neutral-300 truncate" title="${escapeHtml(c.content)}">${escapeHtml(c.content?.substring(0, 80))}${c.content?.length > 80 ? '...' : ''}</p>
          </td>
          <td class="px-4 py-3">
            <a href="/blog/${c.postId}" target="_blank" class="text-sm text-brand-red hover:underline">${escapeHtml(c.post?.title || `文章#${c.postId}`)}</a>
          </td>
          <td class="px-4 py-3">${statusBadge(c.status)}</td>
          <td class="px-4 py-3">
            <span class="text-xs text-neutral-500">${new Date(c.createdAt).toLocaleString('zh-CN')}</span>
          </td>
          <td class="px-4 py-3 text-right">
            <div class="flex items-center justify-end gap-2">
              ${c.status !== 1 ? `<button onclick="updateStatus(${c.id}, 1)" class="px-2 py-1 text-xs font-bold text-green-600 border border-green-500/30 hover:bg-green-50 dark:hover:bg-green-500/10 transition">通过</button>` : ''}
              ${c.status !== 0 ? `<button onclick="updateStatus(${c.id}, 0)" class="px-2 py-1 text-xs font-bold text-yellow-600 border border-yellow-500/30 hover:bg-yellow-50 dark:hover:bg-yellow-500/10 transition">待审</button>` : ''}
              ${c.status !== 2 ? `<button onclick="updateStatus(${c.id}, 2)" class="px-2 py-1 text-xs font-bold text-red-500 border border-red-500/30 hover:bg-red-50 dark:hover:bg-red-500/10 transition">拒绝</button>` : ''}
              <button onclick="deleteOne(${c.id})" class="px-2 py-1 text-xs font-bold text-red-500 border border-red-500/30 hover:bg-red-50 dark:hover:bg-red-500/10 transition">删除</button>
            </div>
          </td>
        </tr>
      `).join('');
    };

    window.toggleSelect = (id) => {
      if (selectedIds.has(id)) selectedIds.delete(id);
      else selectedIds.add(id);
      updateBatchUI();
    };

    window.toggleSelectAll = () => {
      const checkboxes = document.querySelectorAll('.comment-checkbox');
      const allChecked = document.getElementById('selectAll').checked;
      checkboxes.forEach(cb => {
        const id = parseInt(cb.value);
        cb.checked = allChecked;
        if (allChecked) selectedIds.add(id);
        else selectedIds.delete(id);
      });
      updateBatchUI();
    };

    const updateBatchUI = () => {
      const batchActions = document.getElementById('batchActions');
      if (selectedIds.size > 0) {
        batchActions.classList.remove('hidden');
        document.getElementById('selectedCount').textContent = `已选 ${selectedIds.size} 条`;
      } else {
        batchActions.classList.add('hidden');
      }
    };

    window.updateStatus = async (commentId, status) => {
      try {
        const res = await apiClient.updateCommentStatus(commentId, status);
        if (res.success) {
          loadComments();
          loadStats();
        }
      } catch (e) { console.error('Status update failed', e); }
    };

    window.deleteOne = async (commentId) => {
      if (!confirm('确定删除此评论？子回复也会被删除。')) return;
      try {
        const res = await apiClient.adminDeleteComment(commentId);
        if (res.success) {
          loadComments();
          loadStats();
        }
      } catch (e) { console.error('Delete failed', e); }
    };

    window.batchAction = async (action) => {
      const ids = Array.from(selectedIds);
      if (!ids.length) return;

      if (action === 'delete') {
        if (!confirm(`确定批量删除 ${ids.length} 条评论？`)) return;
        const res = await apiClient.batchDeleteComments(ids);
        if (res.success) {
          selectedIds.clear();
          updateBatchUI();
          loadComments();
          loadStats();
        }
      } else {
        const status = action === 'approve' ? 1 : 2;
        const res = await apiClient.batchUpdateCommentStatus(ids, status);
        if (res.success) {
          selectedIds.clear();
          updateBatchUI();
          loadComments();
          loadStats();
        }
      }
    };

    window.changePage = (delta) => {
      currentPage += delta;
      if (currentPage < 1) currentPage = 1;
      selectedIds.clear();
      updateBatchUI();
      loadComments();
    };

    document.addEventListener('DOMContentLoaded', () => {
      loadStats();
      loadComments();
    });
  </script>
</AdminLayout>
