---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const title = '音乐管理 - 管理员';
const description = '管理音乐列表';
---

<AdminLayout title={title} description={description}>
  <div class="py-8">
    <!-- Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-black text-neutral-900 dark:text-white">音乐管理</h1>
        <button onclick="openCreateModal()" class="btn-primary flex items-center gap-2">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          添加音乐
        </button>
      </div>
    </div>

    <!-- Music Table -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
      <div class="card p-0 overflow-hidden">
        <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700">
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <input
                type="text"
                id="searchInput"
                placeholder="搜索音乐标题或艺术家..."
                class="w-full max-w-md px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              />
            </div>
          </div>
        </div>

        <div id="loading" class="text-center py-12">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">正在加载...</p>
        </div>

        <table id="musicTable" class="hidden min-w-full">
          <thead class="bg-neutral-50 dark:bg-neutral-800">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-bold text-neutral-500 uppercase tracking-wider">标题</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-neutral-500 uppercase tracking-wider">艺术家</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-neutral-500 uppercase tracking-wider">分类</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-neutral-500 uppercase tracking-wider">排序</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-neutral-500 uppercase tracking-wider">封面</th>
              <th class="px-6 py-4 text-right text-xs font-bold text-neutral-500 uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody id="musicTableBody" class="divide-y divide-neutral-200 dark:divide-neutral-700">
            <!-- Music will be loaded here -->
          </tbody>
        </table>

        <div id="noMusic" class="hidden text-center py-12">
          <p class="text-neutral-500">暂无音乐，添加您的第一首音乐吧！</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Create/Edit Modal -->
  <div id="musicModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="card max-w-md w-full mx-4 p-0">
      <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700 flex items-center justify-between">
        <h3 id="modalTitle" class="text-lg font-bold text-neutral-900 dark:text-white">添加音乐</h3>
        <button onclick="closeModal()" class="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <form id="musicForm" onsubmit="handleSubmit(event)">
        <input type="hidden" id="musicId" />
        <div class="px-6 py-6 space-y-4">
          <div>
            <label for="musicTitle" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              歌曲名称 <span class="text-brand-red">*</span>
            </label>
            <input
              type="text"
              id="musicTitle"
              required
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              placeholder="输入歌曲名称"
            />
          </div>
          <div>
            <label for="musicArtist" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              艺术家
            </label>
            <input
              type="text"
              id="musicArtist"
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              placeholder="输入艺术家名称"
            />
          </div>
          <div>
            <label for="musicYoutubeId" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              YouTube ID <span class="text-brand-red">*</span>
            </label>
            <input
              type="text"
              id="musicYoutubeId"
              required
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              placeholder="输入 YouTube 视频 ID"
            />
          </div>
          <div>
            <label for="musicCategory" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              分类标签
            </label>
            <input
              type="text"
              id="musicCategory"
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              placeholder="例如: R&B, Pop, Rock"
            />
          </div>
          <div>
            <label for="musicSortOrder" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              排序顺序
            </label>
            <input
              type="number"
              id="musicSortOrder"
              min="0"
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              placeholder="数字越小越靠前"
            />
          </div>
          <div>
            <label for="musicCoverImage" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              封面图 URL
            </label>
            <input
              type="url"
              id="musicCoverImage"
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              placeholder="输入封面图 URL（可选）"
            />
          </div>
        </div>
        <div class="px-6 py-5 border-t border-neutral-200 dark:border-neutral-700 flex items-center justify-end gap-3">
          <button type="button" onclick="closeModal()" class="btn-secondary px-6 py-3">
            取消
          </button>
          <button type="submit" class="btn-primary px-6 py-3">
            <span id="submitBtnText">创建</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { apiClient } from '../../../lib/api.js';

    let allMusic = [];

    const checkAdminAccess = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAdminAccess, 100);
        return;
      }

      if (!window.authManager.isAuthenticated) {
        window.location.href = '/login';
        return;
      }

      const user = window.authManager.currentUser;
      if (user.role !== 'ADMIN') {
        window.location.href = '/dashboard';
        return;
      }

      await loadMusic();
    };

    const loadMusic = async () => {
      const loading = document.getElementById('loading');
      const table = document.getElementById('musicTable');
      const noMusic = document.getElementById('noMusic');

      try {
        loading.classList.remove('hidden');
        table.classList.add('hidden');
        noMusic.classList.add('hidden');

        const response = await apiClient.getMusicList();

        if (response.success && response.data) {
          allMusic = response.data;
          renderMusic(allMusic);
        }
      } catch (error) {
        console.error('Failed to load music:', error);
      } finally {
        loading.classList.add('hidden');
      }
    };

    const renderMusic = (musicList) => {
      const table = document.getElementById('musicTable');
      const tbody = document.getElementById('musicTableBody');
      const loading = document.getElementById('loading');
      const noMusic = document.getElementById('noMusic');

      loading.classList.add('hidden');

      if (musicList.length === 0) {
        noMusic.classList.remove('hidden');
        table.classList.add('hidden');
        return;
      }

      noMusic.classList.add('hidden');
      table.classList.remove('hidden');

      let html = '';
      musicList.forEach(music => {
        const firstLetter = music.title ? music.title.charAt(0).toUpperCase() : '?';
        const coverImage = music.coverImage
          ? `<img src="${music.coverImage}" alt="${music.title}" class="h-10 w-10 object-cover rounded" />`
          : `<div class="h-10 w-10 bg-neutral-300 dark:bg-neutral-600 flex items-center justify-center rounded"><svg class="h-5 w-5 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg></div>`;

        html += `
          <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-800 transition">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10 bg-brand-red flex items-center justify-center">
                  <span class="text-white font-black text-lg">${firstLetter}</span>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-bold text-neutral-900 dark:text-white">${music.title}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="text-sm text-neutral-600 dark:text-neutral-400">${music.artist || '未知艺术家'}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              ${music.category ? `<span class="px-2 py-1 text-xs font-bold bg-neutral-200 dark:bg-neutral-700 text-neutral-700 dark:text-neutral-300 rounded">${music.category}</span>` : '<span class="text-neutral-400 text-xs">无</span>'}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-500">
              ${music.sortOrder !== null && music.sortOrder !== undefined ? music.sortOrder : '-'}
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              ${coverImage}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <button onclick="openEditModal(${music.id}, '${escapeJS(music.title)}', '${escapeJS(music.artist || '')}', '${escapeJS(music.youtubeId)}', '${escapeJS(music.category || '')}', ${music.sortOrder !== null ? music.sortOrder : 'null'}, '${escapeJS(music.coverImage || '')}')" class="text-green-600 hover:text-green-900 dark:text-green-400 dark:hover:text-green-300 mr-3 font-bold">编辑</button>
              <button onclick="deleteMusic(${music.id})" class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300 font-bold">删除</button>
            </td>
          </tr>
        `;
      });

      tbody.innerHTML = html;
    };

    const escapeJS = (str) => {
      if (!str) return '';
      return str.replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '\\"');
    };

    const openCreateModal = () => {
      document.getElementById('modalTitle').textContent = '添加音乐';
      document.getElementById('submitBtnText').textContent = '创建';
      document.getElementById('musicId').value = '';
      document.getElementById('musicTitle').value = '';
      document.getElementById('musicArtist').value = '';
      document.getElementById('musicYoutubeId').value = '';
      document.getElementById('musicCategory').value = '';
      document.getElementById('musicSortOrder').value = '';
      document.getElementById('musicCoverImage').value = '';
      document.getElementById('musicModal').classList.remove('hidden');
    };

    const openEditModal = (id, title, artist, youtubeId, category, sortOrder, coverImage) => {
      document.getElementById('modalTitle').textContent = '编辑音乐';
      document.getElementById('submitBtnText').textContent = '保存';
      document.getElementById('musicId').value = id;
      document.getElementById('musicTitle').value = title;
      document.getElementById('musicArtist').value = artist;
      document.getElementById('musicYoutubeId').value = youtubeId;
      document.getElementById('musicCategory').value = category;
      document.getElementById('musicSortOrder').value = sortOrder !== null ? sortOrder : '';
      document.getElementById('musicCoverImage').value = coverImage;
      document.getElementById('musicModal').classList.remove('hidden');
    };

    const closeModal = () => {
      document.getElementById('musicModal').classList.add('hidden');
    };

    const handleSubmit = async (event) => {
      event.preventDefault();

      const id = document.getElementById('musicId').value;
      const title = document.getElementById('musicTitle').value.trim();
      const artist = document.getElementById('musicArtist').value.trim();
      const youtubeId = document.getElementById('musicYoutubeId').value.trim();
      const category = document.getElementById('musicCategory').value.trim();
      const sortOrderInput = document.getElementById('musicSortOrder').value;
      const coverImage = document.getElementById('musicCoverImage').value.trim();

      if (!title || !youtubeId) {
        return;
      }

      const sortOrder = sortOrderInput ? parseInt(sortOrderInput) : null;

      try {
        const musicData = { title, artist, youtubeId, category, sortOrder, coverImage };

        if (id) {
          const response = await apiClient.updateMusic(parseInt(id), musicData);
          if (response.success) {
            closeModal();
            loadMusic();
          }
        } else {
          const response = await apiClient.createMusic(musicData);
          if (response.success) {
            closeModal();
            loadMusic();
          }
        }
      } catch (error) {
        console.error('Failed to save music:', error);
      }
    };

    const deleteMusic = async (musicId) => {
      if (!confirm('确定要删除这首音乐吗？此操作不可恢复。')) {
        return;
      }

      try {
        const response = await apiClient.deleteMusic(musicId);
        if (response.success) {
          loadMusic();
        }
      } catch (error) {
        console.error('Failed to delete music:', error);
      }
    };

    const filterMusic = () => {
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();

      if (searchTerm) {
        const filtered = allMusic.filter(music =>
          (music.title && music.title.toLowerCase().includes(searchTerm)) ||
          (music.artist && music.artist.toLowerCase().includes(searchTerm))
        );
        renderMusic(filtered);
      } else {
        renderMusic(allMusic);
      }
    };

    document.getElementById('searchInput')?.addEventListener('input', filterMusic);

    document.getElementById('musicModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'musicModal') {
        closeModal();
      }
    });

    document.addEventListener('DOMContentLoaded', checkAdminAccess);
  </script>
</AdminLayout>
