---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const title = '分类管理 - 管理员';
const description = '管理文章分类';
---

<AdminLayout title={title} description={description}>
  <div class="py-8">
    <!-- Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-black text-neutral-900 dark:text-white">分类管理</h1>
        <button onclick="openCreateModal()" class="btn-primary flex items-center gap-2">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          新建分类
        </button>
      </div>
    </div>

    <!-- Categories Table -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
      <div class="card p-0 overflow-hidden">
        <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700">
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <input
                type="text"
                id="searchInput"
                placeholder="搜索分类..."
                class="w-full max-w-md px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              />
            </div>
          </div>
        </div>

        <div id="loading" class="text-center py-12">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">正在加载...</p>
        </div>

        <table id="categoriesTable" class="hidden min-w-full">
          <thead class="bg-neutral-50 dark:bg-neutral-800">
            <tr>
              <th class="px-6 py-4 text-left text-xs font-bold text-neutral-500 uppercase tracking-wider">名称</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-neutral-500 uppercase tracking-wider">描述</th>
              <th class="px-6 py-4 text-left text-xs font-bold text-neutral-500 uppercase tracking-wider">创建时间</th>
              <th class="px-6 py-4 text-right text-xs font-bold text-neutral-500 uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody id="categoriesTableBody" class="divide-y divide-neutral-200 dark:divide-neutral-700">
            <!-- Categories will be loaded here -->
          </tbody>
        </table>

        <div id="noCategories" class="hidden text-center py-12">
          <p class="text-neutral-500">暂无分类，创建您的第一个分类吧！</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Create/Edit Modal -->
  <div id="categoryModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50">
    <div class="card max-w-md w-full mx-4 p-0">
      <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700 flex items-center justify-between">
        <h3 id="modalTitle" class="text-lg font-bold text-neutral-900 dark:text-white">新建分类</h3>
        <button onclick="closeModal()" class="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <form id="categoryForm" onsubmit="handleSubmit(event)">
        <input type="hidden" id="categoryId" />
        <div class="px-6 py-6 space-y-4">
          <div>
            <label for="categoryName" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              分类名称 <span class="text-brand-red">*</span>
            </label>
            <input
              type="text"
              id="categoryName"
              required
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              placeholder="输入分类名称"
            />
          </div>
          <div>
            <label for="categoryDescription" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              分类描述
            </label>
            <textarea
              id="categoryDescription"
              rows="3"
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition resize-none rounded-none"
              placeholder="输入分类描述（可选）"
            ></textarea>
          </div>
        </div>
        <div class="px-6 py-5 border-t border-neutral-200 dark:border-neutral-700 flex items-center justify-end gap-3">
          <button type="button" onclick="closeModal()" class="btn-secondary px-6 py-3">
            取消
          </button>
          <button type="submit" class="btn-primary px-6 py-3">
            <span id="submitBtnText">创建</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { apiClient } from '../../../lib/api.js';

    let allCategories = [];

    const checkAdminAccess = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAdminAccess, 100);
        return;
      }

      if (!window.authManager.isAuthenticated) {
        window.location.href = '/login';
        return;
      }

      const user = window.authManager.currentUser;
      if (user.role !== 'ADMIN') {
        window.location.href = '/dashboard';
        return;
      }

      await loadCategories();
    };

    const loadCategories = async () => {
      const loading = document.getElementById('loading');
      const table = document.getElementById('categoriesTable');
      const noCategories = document.getElementById('noCategories');

      try {
        loading.classList.remove('hidden');
        table.classList.add('hidden');
        noCategories.classList.add('hidden');

        const response = await apiClient.getCategories();

        if (response.success && response.data) {
          allCategories = response.data;
          renderCategories(allCategories);
        }
      } catch (error) {
        console.error('Failed to load categories:', error);
      } finally {
        loading.classList.add('hidden');
      }
    };

    const renderCategories = (categories) => {
      const table = document.getElementById('categoriesTable');
      const tbody = document.getElementById('categoriesTableBody');
      const loading = document.getElementById('loading');
      const noCategories = document.getElementById('noCategories');

      loading.classList.add('hidden');

      if (categories.length === 0) {
        noCategories.classList.remove('hidden');
        table.classList.add('hidden');
        return;
      }

      noCategories.classList.add('hidden');
      table.classList.remove('hidden');

      let html = '';
      categories.forEach(category => {
        const isDefault = ['技术', '生活', '旅行', '美食', '其他'].includes(category.name);

        html += `
          <tr class="hover:bg-neutral-50 dark:hover:bg-neutral-800 transition">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-10 bg-brand-red flex items-center justify-center">
                  <span class="text-white font-black text-lg">${category.name.charAt(0)}</span>
                </div>
                <div class="ml-4">
                  <div class="text-sm font-bold text-neutral-900 dark:text-white">${category.name}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-neutral-600 dark:text-neutral-400 max-w-md truncate">${category.description || '暂无描述'}</div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-neutral-500">
              ${new Date(category.createdAt).toLocaleDateString('zh-CN')}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <button onclick="openEditModal(${category.id}, '${category.name.replace(/'/g, "\\'")}', '${category.description ? category.description.replace(/'/g, "\\'") : ''}')" class="text-green-600 hover:text-green-900 dark:text-green-400 dark:hover:text-green-300 mr-3 font-bold">编辑</button>
              ${!isDefault ? `<button onclick="deleteCategory(${category.id})" class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300 font-bold">删除</button>` : '<span class="text-neutral-400 text-xs">默认分类不可删除</span>'}
            </td>
          </tr>
        `;
      });

      tbody.innerHTML = html;
    };

    const openCreateModal = () => {
      document.getElementById('modalTitle').textContent = '新建分类';
      document.getElementById('submitBtnText').textContent = '创建';
      document.getElementById('categoryId').value = '';
      document.getElementById('categoryName').value = '';
      document.getElementById('categoryDescription').value = '';
      document.getElementById('categoryModal').classList.remove('hidden');
    };

    const openEditModal = (id, name, description) => {
      document.getElementById('modalTitle').textContent = '编辑分类';
      document.getElementById('submitBtnText').textContent = '保存';
      document.getElementById('categoryId').value = id;
      document.getElementById('categoryName').value = name;
      document.getElementById('categoryDescription').value = description;
      document.getElementById('categoryModal').classList.remove('hidden');
    };

    const closeModal = () => {
      document.getElementById('categoryModal').classList.add('hidden');
    };

    const handleSubmit = async (event) => {
      event.preventDefault();

      const id = document.getElementById('categoryId').value;
      const name = document.getElementById('categoryName').value.trim();
      const description = document.getElementById('categoryDescription').value.trim();

      if (!name) {
        return;
      }

      try {
        const categoryData = { name, description };

        if (id) {
          const response = await apiClient.updateCategory(parseInt(id), categoryData);
          if (response.success) {
            closeModal();
            loadCategories();
          }
        } else {
          const response = await apiClient.createCategory(categoryData);
          if (response.success) {
            closeModal();
            loadCategories();
          }
        }
      } catch (error) {
        console.error('Failed to save category:', error);
      }
    };

    const deleteCategory = async (categoryId) => {
      if (!confirm('确定要删除这个分类吗？此操作不可恢复。')) {
        return;
      }

      try {
        const response = await apiClient.deleteCategory(categoryId);
        if (response.success) {
          loadCategories();
        }
      } catch (error) {
        console.error('Failed to delete category:', error);
      }
    };

    const filterCategories = () => {
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();

      if (searchTerm) {
        const filtered = allCategories.filter(cat =>
          cat.name.toLowerCase().includes(searchTerm) ||
          (cat.description && cat.description.toLowerCase().includes(searchTerm))
        );
        renderCategories(filtered);
      } else {
        renderCategories(allCategories);
      }
    };

    document.getElementById('searchInput')?.addEventListener('input', filterCategories);

    document.getElementById('categoryModal')?.addEventListener('click', (e) => {
      if (e.target.id === 'categoryModal') {
        closeModal();
      }
    });

    document.addEventListener('DOMContentLoaded', checkAdminAccess);
  </script>
</AdminLayout>
