---
import AdminLayout from '../../layouts/AdminLayout.astro';

const title = '管理仪表盘';
const description = '管理仪表盘';
---

<AdminLayout title={title} description={description}>
  <div class="py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-black text-neutral-900 dark:text-white">管理仪表盘</h1>
        <p class="mt-2 text-neutral-600 dark:text-neutral-400">管理您的博客内容和设置</p>
      </div>

      <!-- Dashboard Content -->
      <div class="space-y-8">
        <!-- Stats Grid -->
        <div class="grid grid-cols-12 gap-6">
          <!-- Total Posts -->
          <div class="col-span-6 lg:col-span-3">
            <div class="card p-6">
              <div class="flex items-center gap-4">
                <div class="p-4 bg-brand-red/10">
                  <svg class="h-6 w-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-neutral-500">文章总数</p>
                  <p id="totalPosts" class="text-3xl font-black text-neutral-900 dark:text-white">-</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Published Posts -->
          <div class="col-span-6 lg:col-span-3">
            <div class="card p-6">
              <div class="flex items-center gap-4">
                <div class="p-4 bg-green-500/10">
                  <svg class="h-6 w-6 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-neutral-500">已发布</p>
                  <p id="publishedPosts" class="text-3xl font-black text-neutral-900 dark:text-white">-</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Draft Posts -->
          <div class="col-span-6 lg:col-span-3">
            <div class="card p-6">
              <div class="flex items-center gap-4">
                <div class="p-4 bg-yellow-500/10">
                  <svg class="h-6 w-6 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-neutral-500">草稿</p>
                  <p id="draftPosts" class="text-3xl font-black text-neutral-900 dark:text-white">-</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Total Views -->
          <div class="col-span-6 lg:col-span-3">
            <div class="card p-6">
              <div class="flex items-center gap-4">
                <div class="p-4 bg-purple-500/10">
                  <svg class="h-6 w-6 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-neutral-500">总浏览量</p>
                  <p id="totalViews" class="text-3xl font-black text-neutral-900 dark:text-white">-</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Actions -->
        <div class="card p-0">
          <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white">快捷操作</h3>
          </div>
          <div class="p-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
            <a href="/admin/posts/create" class="flex items-center gap-4 p-4 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer">
              <div class="p-3 bg-brand-red/10">
                <svg class="h-6 w-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"/>
                </svg>
              </div>
              <span class="font-bold text-neutral-700 dark:text-neutral-300">创建新文章</span>
            </a>

            <a href="/admin/posts" class="flex items-center gap-4 p-4 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer">
              <div class="p-3 bg-brand-red/10">
                <svg class="h-6 w-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
              </div>
              <span class="font-bold text-neutral-700 dark:text-neutral-300">管理文章</span>
            </a>

            <a href="/profile" class="flex items-center gap-4 p-4 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer">
              <div class="p-3 bg-brand-red/10">
                <svg class="h-6 w-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
              </div>
              <span class="font-bold text-neutral-700 dark:text-neutral-300">查看资料</span>
            </a>
          </div>
        </div>

        <!-- Recent Posts -->
        <div class="card p-0 overflow-hidden">
          <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700 flex items-center justify-between">
            <h3 class="text-lg font-bold text-neutral-900 dark:text-white">最新文章</h3>
            <a href="/admin/posts" class="text-sm font-bold text-brand-red hover:text-brand-red-dark">查看全部 →</a>
          </div>
          <div class="p-6">
            <div id="recentPosts" class="space-y-4">
              <!-- Recent posts will be loaded here -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../../lib/api.js';

    const loadDashboardData = async () => {
      try {
        const response = await apiClient.request('/posts/my-posts');

        if (response.success && response.data) {
          const posts = response.data;
          const totalPosts = posts.length;
          const publishedPosts = posts.filter(p => p.status === 'PUBLISHED').length;
          const draftPosts = posts.filter(p => p.status === 'DRAFT').length;
          const totalViews = posts.reduce((sum, p) => sum + (p.viewCount || 0), 0);

          document.getElementById('totalPosts').textContent = totalPosts;
          document.getElementById('publishedPosts').textContent = publishedPosts;
          document.getElementById('draftPosts').textContent = draftPosts;
          document.getElementById('totalViews').textContent = totalViews.toLocaleString();

          renderRecentPosts(posts.slice(0, 5));
        }
      } catch (error) {
        console.error('Failed to load dashboard data:', error);
      }
    };

    const renderRecentPosts = (posts) => {
      const container = document.getElementById('recentPosts');

      if (posts.length === 0) {
        container.innerHTML = '<p class="text-neutral-500 text-center py-4">暂无文章，创建您的第一篇文章吧！</p>';
        return;
      }

      let html = '';
      posts.forEach(post => {
        const statusClass = post.status === 'PUBLISHED'
          ? 'bg-green-500/10 text-green-600 border-green-500/20'
          : 'bg-yellow-500/10 text-yellow-600 border-yellow-500/20';

        html += `
          <div class="flex items-center justify-between p-4 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red transition">
            <div class="flex items-center gap-4 flex-1 min-w-0">
              ${post.featuredImage ? `
                <div class="w-14 h-14 rounded overflow-hidden flex-shrink-0">
                  <img src="${post.featuredImage}" alt="${post.title}" class="w-full h-full object-cover" />
                </div>
              ` : `
                <div class="w-14 h-14 bg-neutral-200 dark:bg-neutral-700 rounded flex items-center justify-center flex-shrink-0">
                  <svg class="h-6 w-6 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
                  </svg>
                </div>
              `}
              <div class="flex-1 min-w-0">
                <h4 class="text-sm font-bold text-neutral-900 dark:text-white truncate">${post.title}</h4>
                <p class="text-xs text-neutral-500">${new Date(post.createdAt).toLocaleDateString()} • ${post.viewCount || 0} 次浏览</p>
              </div>
            </div>
            <span class="px-3 py-1 text-xs font-bold border ${statusClass}">${post.status === 'PUBLISHED' ? '已发布' : '草稿'}</span>
          </div>
        `;
      });

      container.innerHTML = html;
    };

    document.addEventListener('DOMContentLoaded', loadDashboardData);
  </script>
</AdminLayout>
