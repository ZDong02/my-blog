---
import AdminLayout from '../../../../layouts/AdminLayout.astro';

export const prerender = false;
export function getStaticPaths() {
  return [];
}

const title = '编辑文章 - 管理员';
const description = '编辑文章';
---

<AdminLayout title={title} description={description}>
  <div class="py-8">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-6">
        <a href="/admin/posts" class="text-neutral-600 dark:text-neutral-400 hover:text-brand-red flex items-center gap-2 font-bold">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
          返回文章列表
        </a>
      </div>

      <div id="loading" class="text-center py-12">
        <div class="spinner mx-auto mb-6"></div>
        <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">正在加载...</p>
      </div>

      <form id="editPostForm" class="card p-0 hidden">
        <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700 flex items-center justify-between">
          <h2 class="text-xl font-bold text-neutral-900 dark:text-white">编辑文章</h2>
          <span id="postStatus" class="badge-red"></span>
        </div>

        <div class="px-6 py-6 space-y-6">
          <!-- Title -->
          <div>
            <label for="title" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              标题 <span class="text-brand-red">*</span>
            </label>
            <input
              type="text"
              id="title"
              name="title"
              required
              maxlength="200"
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
            />
          </div>

          <!-- Category -->
          <div>
            <label for="categoryId" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              分类
            </label>
            <select
              id="categoryId"
              name="categoryId"
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
            >
              <option value="">选择分类</option>
            </select>
          </div>

          <!-- Featured Image -->
          <div>
            <label for="featuredImageFile" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              文章封面
            </label>
            <div class="space-y-3">
              <input
                type="file"
                id="featuredImageFile"
                accept="image/*"
                class="block w-full text-sm text-neutral-700 dark:text-neutral-300 file:mr-4 file:py-2 file:px-4 file:rounded-none file:border-0 file:bg-neutral-100 dark:file:bg-neutral-700 file:text-neutral-700 dark:file:text-neutral-200 hover:file:bg-neutral-200 dark:hover:file:bg-neutral-600"
              />
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  id="uploadFeaturedImageBtn"
                  class="px-4 py-2 text-sm bg-neutral-800 dark:bg-neutral-700 text-white hover:bg-neutral-900 dark:hover:bg-neutral-600 transition rounded-none font-bold"
                >
                  上传图片
                </button>
                <span id="featuredImageUploadStatus" class="text-xs text-neutral-500">未上传封面图</span>
              </div>
              <img id="featuredImagePreview" class="hidden max-h-48 border border-neutral-200 dark:border-neutral-700" alt="Featured image preview" />
              <input type="hidden" id="featuredImage" name="featuredImage" />
            </div>
          </div>

          <!-- Summary -->
          <div>
            <label for="summary" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              摘要
            </label>
            <textarea
              id="summary"
              name="summary"
              rows="3"
              maxlength="500"
              class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition resize-none rounded-none"
            ></textarea>
          </div>

          <!-- Content -->
          <div>
            <label for="content" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
              内容 <span class="text-brand-red">*</span>
            </label>
            <div class="border border-neutral-200 dark:border-neutral-700">
              <div class="flex border-b border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 px-2 py-1 gap-1">
                <button type="button" onclick="insertMarkdown('**', '**')" class="px-3 py-1 text-xs font-bold hover:bg-neutral-200 dark:hover:bg-neutral-700 transition" title="Bold">B</button>
                <button type="button" onclick="insertMarkdown('*', '*')" class="px-3 py-1 text-xs italic hover:bg-neutral-200 dark:hover:bg-neutral-700 transition" title="Italic">I</button>
                <button type="button" onclick="insertMarkdown('# ', '')" class="px-3 py-1 text-xs font-bold hover:bg-neutral-200 dark:hover:bg-neutral-700 transition" title="Heading">H</button>
                <button type="button" onclick="insertMarkdown('## ', '')" class="px-3 py-1 text-xs hover:bg-neutral-200 dark:hover:bg-neutral-700 transition" title="Subheading">H2</button>
                <button type="button" onclick="insertMarkdown('- ', '')" class="px-3 py-1 text-xs hover:bg-neutral-200 dark:hover:bg-neutral-700 transition" title="List">List</button>
                <button type="button" onclick="insertMarkdown('`', '`')" class="px-3 py-1 text-xs font-mono hover:bg-neutral-200 dark:hover:bg-neutral-700 transition" title="Code">Code</button>
              </div>
              <textarea
                id="content"
                name="content"
                required
                rows="20"
                class="w-full px-4 py-3 border-0 bg-neutral-50 dark:bg-neutral-800 focus:outline-none focus:ring-0 font-mono text-sm text-neutral-900 dark:text-white rounded-none"
              ></textarea>
            </div>
          </div>
        </div>

        <div class="px-6 py-5 border-t border-neutral-200 dark:border-neutral-700 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <button
              type="button"
              id="publishBtn"
              class="btn-primary px-6 py-3 hidden"
            >
              发布
            </button>
            <button
              type="button"
              id="unpublishBtn"
              class="btn-secondary px-6 py-3 hidden"
            >
              取消发布
            </button>
          </div>
          <div class="flex items-center gap-3">
            <button
              type="button"
              onclick="window.history.back()"
              class="btn-secondary px-6 py-3"
            >
              取消
            </button>
            <button
              type="submit"
              class="btn-primary px-6 py-3"
            >
              保存更改
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { apiClient } from '../../../../lib/api.js';

    let postId = null;

    const checkAdminAccess = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAdminAccess, 100);
        return;
      }

      if (!window.authManager.isAuthenticated) {
        window.location.href = '/login';
        return;
      }

      const user = window.authManager.currentUser;
      if (user.role !== 'ADMIN') {
        window.location.href = '/dashboard';
        return;
      }

      const pathParts = window.location.pathname.split('/').filter(Boolean);
      postId = pathParts[pathParts.length - 1];

      if (!postId || isNaN(parseInt(postId))) {
        setTimeout(() => window.history.back(), 1500);
        return;
      }

      loadPost();
      loadCategories();
    };

    const loadPost = async () => {
      try {
        const response = await apiClient.getPost(postId);
        if (response.success && response.data) {
          const post = response.data;

          document.getElementById('title').value = post.title;
          document.getElementById('categoryId').value = post.category?.id || '';
          setFeaturedImage(apiClient.resolveMediaUrl(post.featuredImage || ''));
          document.getElementById('featuredImageFile').value = '';
          document.getElementById('summary').value = post.summary || '';
          document.getElementById('content').value = post.content;

          const statusEl = document.getElementById('postStatus');
          statusEl.textContent = post.status === 'PUBLISHED' ? '已发布' : '草稿';
          statusEl.className = post.status === 'PUBLISHED' ? 'badge-green' : 'badge-yellow';

          const publishBtn = document.getElementById('publishBtn');
          const unpublishBtn = document.getElementById('unpublishBtn');

          if (post.status === 'DRAFT') {
            publishBtn.classList.remove('hidden');
          } else {
            unpublishBtn.classList.remove('hidden');
          }

          publishBtn.onclick = async () => {
            try {
              await apiClient.request(`/posts/${postId}/publish`, { method: 'PUT' });
              loadPost();
            } catch (error) {
              console.error('Failed to publish post:', error);
            }
          };

          unpublishBtn.onclick = async () => {
            try {
              await apiClient.request(`/posts/${postId}/unpublish`, { method: 'PUT' });
              loadPost();
            } catch (error) {
              console.error('Failed to unpublish post:', error);
            }
          };

          document.getElementById('loading').classList.add('hidden');
          document.getElementById('editPostForm').classList.remove('hidden');
        }
      } catch (error) {
        console.error('Failed to load post:', error);
      }
    };

    const setFeaturedImage = (url = '', filename = '') => {
      const hiddenInput = document.getElementById('featuredImage');
      const preview = document.getElementById('featuredImagePreview');
      const status = document.getElementById('featuredImageUploadStatus');

      hiddenInput.value = url;

      if (url) {
        preview.src = url;
        preview.classList.remove('hidden');
        status.textContent = filename ? `已上传: ${filename}` : '已上传封面图';
        return;
      }

      preview.removeAttribute('src');
      preview.classList.add('hidden');
      status.textContent = '未上传封面图';
    };

    const uploadFeaturedImage = async () => {
      const fileInput = document.getElementById('featuredImageFile');
      const uploadButton = document.getElementById('uploadFeaturedImageBtn');
      const status = document.getElementById('featuredImageUploadStatus');
      const file = fileInput.files?.[0];

      if (!file) {
        return;
      }

      uploadButton.disabled = true;
      uploadButton.textContent = '上传中...';
      status.textContent = `正在上传: ${file.name}`;

      try {
        const response = await apiClient.uploadFile(file);
        if (!response.success || !response.data?.url) {
          throw new Error(response.message || '上传失败');
        }

        setFeaturedImage(response.data.url, response.data.filename || file.name);
      } catch (error) {
        console.error('Failed to upload featured image:', error);
        status.textContent = '上传失败，请重试';
      } finally {
        uploadButton.disabled = false;
        uploadButton.textContent = '上传图片';
      }
    };

    const loadCategories = async () => {
      try {
        const response = await apiClient.getCategories();
        if (response.success && response.data) {
          const select = document.getElementById('categoryId');
          response.data.forEach(cat => {
            const option = document.createElement('option');
            option.value = cat.id;
            option.textContent = cat.name;
            select.appendChild(option);
          });
        }
      } catch (error) {
        console.error('Failed to load categories:', error);
      }
    };

    const insertMarkdown = (prefix, suffix) => {
      const textarea = document.getElementById('content');
      const start = textarea.selectionStart;
      const end = textarea.selectionEnd;
      const selectedText = textarea.value.substring(start, end);
      const newText = textarea.value.substring(0, start) + prefix + selectedText + suffix + textarea.value.substring(end);
      textarea.value = newText;
      textarea.focus();
      textarea.selectionStart = start + prefix.length;
      textarea.selectionEnd = start + prefix.length + selectedText.length;
    };

    document.getElementById('editPostForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = {
        title: document.getElementById('title').value,
        content: document.getElementById('content').value,
        summary: document.getElementById('summary').value,
        categoryId: document.getElementById('categoryId').value ? parseInt(document.getElementById('categoryId').value) : null,
        featuredImage: document.getElementById('featuredImage').value
      };

      try {
        const response = await apiClient.updatePost(postId, formData);
        if (response.success) {
        }
      } catch (error) {
        console.error('Failed to update post:', error);
      }
    });

    document.getElementById('uploadFeaturedImageBtn')?.addEventListener('click', uploadFeaturedImage);

    document.getElementById('featuredImageFile')?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      const file = target.files?.[0];
      const status = document.getElementById('featuredImageUploadStatus');
      const featuredImage = document.getElementById('featuredImage') as HTMLInputElement;

      if (!status || !featuredImage) {
        return;
      }

      if (file) {
        status.textContent = `已选择: ${file.name}，点击上传`;
      } else if (!featuredImage.value) {
        status.textContent = '未上传封面图';
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      setFeaturedImage('');
      checkAdminAccess();
    });
  </script>
</AdminLayout>
