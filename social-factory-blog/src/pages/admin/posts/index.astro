---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const title = 'Manage Posts - Admin';
const description = 'Manage all blog posts';
---

<AdminLayout title={title} description={description}>
  <div class="py-8">
    <!-- Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Posts</h1>
        <a href="/admin/posts/create" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg flex items-center gap-2 transition">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          New Post
        </a>
      </div>
    </div>

    <!-- Posts Table -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
      <div class="bg-white dark:bg-zinc-900 shadow rounded-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-zinc-800">
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <input
                type="text"
                id="searchInput"
                placeholder="Search posts..."
                class="w-full max-w-md px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500"
              />
            </div>
            <select id="statusFilter" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500">
              <option value="">All Status</option>
              <option value="PUBLISHED">Published</option>
              <option value="DRAFT">Draft</option>
            </select>
          </div>
        </div>

        <div id="loading" class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
          <p class="mt-4 text-gray-600 dark:text-gray-400">Loading posts...</p>
        </div>

        <table id="postsTable" class="hidden min-w-full divide-y divide-gray-200 dark:divide-zinc-800">
          <thead class="bg-gray-50 dark:bg-zinc-800">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Title</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Category</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Stats</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Created</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody id="postsTableBody" class="bg-white dark:bg-zinc-900 divide-y divide-gray-200 dark:divide-zinc-800">
            <!-- Posts will be loaded here -->
          </tbody>
        </table>

        <div id="noPosts" class="hidden text-center py-12">
          <p class="text-gray-600 dark:text-gray-400">No posts found. Create your first post!</p>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="hidden px-6 py-4 border-t border-gray-200 dark:border-zinc-800 flex items-center justify-between">
          <button id="prevBtn" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed">
            Previous
          </button>
          <span id="pageInfo" class="text-sm text-gray-600 dark:text-gray-400">Page 1</span>
          <button id="nextBtn" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed">
            Next
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../../../lib/api.js';

    let currentPage = 1;
    let totalPages = 1;
    let allPosts = [];

    // Check admin access
    const checkAdminAccess = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAdminAccess, 100);
        return;
      }

      if (!window.authManager.isAuthenticated) {
        window.location.href = '/login';
        return;
      }

      const user = window.authManager.currentUser;
      if (user.role !== 'ADMIN') {
        window.location.href = '/dashboard';
        showWarning('Access denied. Admin only.');
        return;
      }

      loadPosts();
    };

    const loadPosts = async () => {
      try {
        // Get all posts via my-posts endpoint
        const response = await apiClient.request('/posts/my-posts');

        if (response.success && response.data) {
          allPosts = response.data;
          renderPosts(allPosts);
        }
      } catch (error) {
        console.error('Failed to load posts:', error);
        showError('Failed to load posts');
      }
    };

    const renderPosts = (posts) => {
      const table = document.getElementById('postsTable');
      const tbody = document.getElementById('postsTableBody');
      const loading = document.getElementById('loading');
      const noPosts = document.getElementById('noPosts');
      const pagination = document.getElementById('pagination');

      loading.classList.add('hidden');

      if (posts.length === 0) {
        noPosts.classList.remove('hidden');
        table.classList.add('hidden');
        pagination.classList.add('hidden');
        return;
      }

      noPosts.classList.add('hidden');
      table.classList.remove('hidden');
      pagination.classList.remove('hidden');

      let html = '';
      posts.forEach(post => {
        const statusClass = post.status === 'PUBLISHED'
          ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
          : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200';

        html += `
          <tr class="hover:bg-gray-50 dark:hover:bg-zinc-800 transition">
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-16 bg-gray-200 dark:bg-zinc-700 rounded overflow-hidden">
                  ${post.featuredImage ? `<img src="${post.featuredImage}" class="h-full w-full object-cover" />` : ''}
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-gray-900 dark:text-white">${post.title}</div>
                  <div class="text-sm text-gray-500 dark:text-gray-400">By ${post.author?.username}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="text-sm text-gray-600 dark:text-gray-400">${post.category?.name || 'Uncategorized'}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium ${statusClass}">${post.status}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
              <span title="Views">${post.viewCount || 0}</span> ·
              <span title="Likes">${post.likeCount || 0}</span> ·
              <span title="Comments">${post.commentCount || 0}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
              ${new Date(post.createdAt).toLocaleDateString()}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <a href="/blog/${post.id}" class="text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 mr-3">View</a>
              <a href="/admin/posts/edit/${post.id}" class="text-green-600 hover:text-green-900 dark:text-green-400 dark:hover:text-green-300 mr-3">Edit</a>
              <button onclick="deletePost(${post.id})" class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300">Delete</button>
            </td>
          </tr>
        `;
      });

      tbody.innerHTML = html;
    };

    const deletePost = async (postId) => {
      if (!confirm('Are you sure you want to delete this post?')) {
        return;
      }

      try {
        const response = await apiClient.deletePost(postId);
        if (response.success) {
          showSuccess('Post deleted successfully');
          loadPosts();
        }
      } catch (error) {
        console.error('Failed to delete post:', error);
        showError('Failed to delete post');
      }
    };

    // Search and filter
    const filterPosts = () => {
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();
      const statusFilter = document.getElementById('statusFilter').value;

      let filtered = allPosts;

      if (searchTerm) {
        filtered = filtered.filter(post =>
          post.title.toLowerCase().includes(searchTerm) ||
          (post.summary && post.summary.toLowerCase().includes(searchTerm))
        );
      }

      if (statusFilter) {
        filtered = filtered.filter(post => post.status === statusFilter);
      }

      renderPosts(filtered);
    };

    document.getElementById('searchInput')?.addEventListener('input', filterPosts);
    document.getElementById('statusFilter')?.addEventListener('change', filterPosts);

    // Initialize
    document.addEventListener('DOMContentLoaded', checkAdminAccess);
  </script>
</AdminLayout>
