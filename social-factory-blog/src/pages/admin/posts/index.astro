---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const title = '管理文章 - 管理员';
const description = '管理所有文章';
---

<AdminLayout title={title} description={description}>
  <div class="py-8">
    <!-- Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">文章管理</h1>
        <a href="/admin/posts/create" class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg flex items-center gap-2 transition">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          新建文章
        </a>
      </div>
    </div>

    <!-- Posts Table -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
      <div class="bg-white dark:bg-zinc-900 shadow rounded-lg overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-zinc-800">
          <div class="flex items-center gap-4">
            <div class="flex-1">
              <input
                type="text"
                id="searchInput"
                placeholder="搜索文章..."
                class="w-full max-w-md px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500"
              />
            </div>
            <select id="statusFilter" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500">
              <option value="">全部状态</option>
              <option value="PUBLISHED">已发布</option>
              <option value="DRAFT">草稿</option>
            </select>
          </div>
        </div>

        <div id="loading" class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
          <p class="mt-4 text-gray-600 dark:text-gray-400">正在加载文章...</p>
        </div>

        <table id="postsTable" class="hidden min-w-full divide-y divide-gray-200 dark:divide-zinc-800">
          <thead class="bg-gray-50 dark:bg-zinc-800">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">标题</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">分类</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">状态</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">统计</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">创建时间</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">操作</th>
            </tr>
          </thead>
          <tbody id="postsTableBody" class="bg-white dark:bg-zinc-900 divide-y divide-gray-200 dark:divide-zinc-800">
            <!-- Posts will be loaded here -->
          </tbody>
        </table>

        <div id="noPosts" class="hidden text-center py-12">
          <p class="text-gray-600 dark:text-gray-400">暂无文章，创建您的第一篇文章吧！</p>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="hidden px-6 py-4 border-t border-gray-200 dark:border-zinc-800 flex items-center justify-between">
          <div class="text-sm text-gray-600 dark:text-gray-400">
            共 <span id="totalPosts">0</span> 篇文章
          </div>
          <div class="flex items-center gap-2">
            <button id="prevBtn" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
              </svg>
              上一页
            </button>
            <span id="pageInfo" class="text-sm text-gray-600 dark:text-gray-400 px-2">第 1 页</span>
            <button id="nextBtn" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-1">
              下一页
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../../../lib/api.js';

    let currentPage = 1;
    let totalPages = 1;
    let allPosts = [];
    let categories = [];

    // Check admin access
    const checkAdminAccess = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAdminAccess, 100);
        return;
      }

      if (!window.authManager.isAuthenticated) {
        window.location.href = '/login';
        return;
      }

      const user = window.authManager.currentUser;
      if (user.role !== 'ADMIN') {
        window.location.href = '/dashboard';
        if (typeof window.showWarning === 'function') {
          window.showWarning('Access denied. Admin only.');
        }
        return;
      }

      await loadCategories();
      await loadPosts();
    };

    const loadCategories = async () => {
      try {
        const response = await apiClient.getCategories();
        if (response.success && response.data) {
          categories = response.data;
        }
      } catch (error) {
        console.error('Failed to load categories:', error);
      }
    };

    const loadPosts = async () => {
      const loading = document.getElementById('loading');
      const table = document.getElementById('postsTable');
      const noPosts = document.getElementById('noPosts');
      const pagination = document.getElementById('pagination');

      try {
        loading.classList.remove('hidden');
        table.classList.add('hidden');
        noPosts.classList.add('hidden');
        pagination.classList.add('hidden');

        // Get all posts via my-posts endpoint
        const response = await apiClient.request('/posts/my-posts');

        if (response.success && response.data) {
          allPosts = response.data;
          renderPosts(allPosts);
        }
      } catch (error) {
        console.error('Failed to load posts:', error);
        if (typeof window.showError === 'function') {
          window.showError('Failed to load posts');
        }
      } finally {
        loading.classList.add('hidden');
      }
    };

    const renderPosts = (posts) => {
      const table = document.getElementById('postsTable');
      const tbody = document.getElementById('postsTableBody');
      const loading = document.getElementById('loading');
      const noPosts = document.getElementById('noPosts');
      const pagination = document.getElementById('pagination');

      loading.classList.add('hidden');

      if (posts.length === 0) {
        noPosts.classList.remove('hidden');
        table.classList.add('hidden');
        pagination.classList.add('hidden');
        return;
      }

      noPosts.classList.add('hidden');
      table.classList.remove('hidden');
      pagination.classList.remove('hidden');

      document.getElementById('totalPosts').textContent = posts.length;

      let html = '';
      posts.forEach(post => {
        const statusClass = post.status === 'PUBLISHED'
          ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200'
          : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200';

        const categoryName = categories.find(c => c.id === post.categoryId)?.name || post.category?.name || '未分类';

        html += `
          <tr class="hover:bg-gray-50 dark:hover:bg-zinc-800 transition">
            <td class="px-6 py-4">
              <div class="flex items-center">
                <div class="flex-shrink-0 h-10 w-16 bg-gray-200 dark:bg-zinc-700 rounded overflow-hidden">
                  ${post.featuredImage ? `<img src="${post.featuredImage}" class="h-full w-full object-cover" />` : ''}
                </div>
                <div class="ml-4">
                  <div class="text-sm font-medium text-gray-900 dark:text-white">${post.title}</div>
                  <div class="text-xs text-gray-500 dark:text-gray-400">作者：${post.author?.username || 'admin'}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="text-sm text-gray-600 dark:text-gray-400">${categoryName}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium ${statusClass}">${post.status === 'PUBLISHED' ? '已发布' : '草稿'}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
              <span title="浏览数">👁 ${post.viewCount || 0}</span>
              <span title="点赞数" class="ml-2">❤️ ${post.likeCount || 0}</span>
              <span title="评论数" class="ml-2">💬 ${post.commentCount || 0}</span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400">
              ${new Date(post.createdAt).toLocaleDateString('zh-CN')}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
              <a href="/blog/${post.id}" target="_blank" class="text-blue-600 hover:text-blue-900 dark:text-blue-400 dark:hover:text-blue-300 mr-2">查看</a>
              <a href="/admin/posts/edit/${post.id}" class="text-green-600 hover:text-green-900 dark:text-green-400 dark:hover:text-green-300 mr-2">编辑</a>
              ${post.status === 'PUBLISHED'
                ? `<button data-action="toggle-publish" data-id="${post.id}" data-publish="false" class="text-yellow-600 hover:text-yellow-900 dark:text-yellow-400 dark:hover:text-yellow-300 mr-2">撤销发布</button>`
                : `<button data-action="toggle-publish" data-id="${post.id}" data-publish="true" class="text-green-600 hover:text-green-900 dark:text-green-400 dark:hover:text-green-300 mr-2">发布</button>`
              }
              <button data-action="delete" data-id="${post.id}" class="text-red-600 hover:text-red-900 dark:text-red-400 dark:hover:text-red-300">删除</button>
            </td>
          </tr>
        `;
      });

      tbody.innerHTML = html;

      // Bind event listeners after rendering
      bindTableEvents();
    };

    const togglePublish = async (postId, publish) => {
      if (!confirm(publish ? '确定要发布这篇文章吗？' : '确定要撤销发布这篇文章吗？')) {
        return;
      }

      try {
        const endpoint = publish ? `/posts/${postId}/publish` : `/posts/${postId}/unpublish`;
        const response = await apiClient.request(endpoint, { method: 'PUT' });

        if (response.success) {
          if (typeof window.showSuccess === 'function') {
            window.showSuccess(publish ? '文章已发布' : '已撤销发布');
          }
          loadPosts();
        }
      } catch (error) {
        console.error('Failed to toggle publish:', error);
        if (typeof window.showError === 'function') {
          window.showError(error.message || '操作失败');
        }
      }
    };

    const deletePost = async (postId) => {
      if (!confirm('确定要删除这篇文章吗？此操作不可恢复。')) {
        return;
      }

      try {
        const response = await apiClient.deletePost(postId);
        if (response.success) {
          if (typeof window.showSuccess === 'function') {
            window.showSuccess('文章已删除');
          }
          loadPosts();
        }
      } catch (error) {
        console.error('Failed to delete post:', error);
        if (typeof window.showError === 'function') {
          window.showError(error.message || '操作失败');
        }
      }
    };

    // Expose functions to window for onclick handlers
    window.deletePost = deletePost;
    window.togglePublish = togglePublish;

    // Event delegation for action buttons - bind after DOM is ready
    const bindTableEvents = () => {
      const tbody = document.getElementById('postsTableBody');
      if (!tbody) return;

      tbody.addEventListener('click', (e) => {
        const button = e.target.closest('button[data-action]');
        if (!button) return;

        const action = button.dataset.action;
        const id = parseInt(button.dataset.id);

        if (action === 'delete') {
          deletePost(id);
        } else if (action === 'toggle-publish') {
          const publish = button.dataset.publish === 'true';
          togglePublish(id, publish);
        }
      });
    };

    // Search and filter
    const filterPosts = () => {
      const searchTerm = document.getElementById('searchInput').value.toLowerCase();
      const statusFilter = document.getElementById('statusFilter').value;

      let filtered = allPosts;

      if (searchTerm) {
        filtered = filtered.filter(post =>
          post.title.toLowerCase().includes(searchTerm) ||
          (post.summary && post.summary.toLowerCase().includes(searchTerm))
        );
      }

      if (statusFilter) {
        filtered = filtered.filter(post => post.status === statusFilter);
      }

      renderPosts(filtered);
    };

    document.getElementById('searchInput')?.addEventListener('input', filterPosts);
    document.getElementById('statusFilter')?.addEventListener('change', filterPosts);

    // Initialize
    document.addEventListener('DOMContentLoaded', checkAdminAccess);
  </script>
</AdminLayout>
