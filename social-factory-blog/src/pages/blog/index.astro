---
import Layout from '../../layouts/Layout.astro';

const title = 'Blog - Social Factory';
const description = 'Browse all blog posts';
---

<Layout title={title} description={description}>
  <div class="max-w-7xl mx-auto px-8 py-20">
    <h1 class="text-6xl font-black mb-12">BLOG</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Posts list -->
      <div class="md:col-span-2">
        <div id="loading" class="text-center py-12">
          <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
          <p class="mt-4 text-gray-600 dark:text-gray-400">Loading posts...</p>
        </div>

        <div id="posts" class="space-y-12 hidden">
          <!-- Posts will be loaded here -->
        </div>

        <div id="noPosts" class="hidden text-center py-12">
          <p class="text-gray-600 dark:text-gray-400 text-lg">No posts available yet.</p>
          <p class="text-gray-500 dark:text-gray-500 text-sm mt-2">Check back later for new content!</p>
        </div>

        <!-- Pagination -->
        <div id="pagination" class="hidden mt-12 flex items-center justify-between">
          <button id="prevBtn" class="px-6 py-2 border border-zinc-300 dark:border-zinc-700 rounded hover:bg-red-600 hover:border-red-600 transition disabled:opacity-50 disabled:cursor-not-allowed">
            Previous
          </button>
          <span id="pageInfo" class="text-sm text-gray-600 dark:text-gray-400">Page 1</span>
          <button id="nextBtn" class="px-6 py-2 border border-zinc-300 dark:border-zinc-700 rounded hover:bg-red-600 hover:border-red-600 transition disabled:opacity-50 disabled:cursor-not-allowed">
            Next
          </button>
        </div>
      </div>

      <!-- Categories + Tags -->
      <div>
        <h3 class="uppercase tracking-widest text-sm mb-6">Categories</h3>
        <div class="flex flex-wrap gap-2" id="categories">
          <!-- Categories will be loaded here -->
        </div>

        <h3 class="uppercase tracking-widest text-sm mt-12 mb-6">Recent Posts</h3>
        <div id="recentPosts" class="space-y-4">
          <!-- Recent posts will be loaded here -->
        </div>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../../lib/api.js';

    let currentPage = 1;
    let totalPages = 1;
    let allCategories = new Set();

    const loadPosts = async (page = 1) => {
      const loading = document.getElementById('loading');
      const postsContainer = document.getElementById('posts');
      const noPosts = document.getElementById('noPosts');
      const pagination = document.getElementById('pagination');

      try {
        loading.classList.remove('hidden');
        postsContainer.classList.add('hidden');
        noPosts.classList.add('hidden');
        pagination.classList.add('hidden');

        const response = await apiClient.getPosts(page, 10);

        if (response.success && response.data) {
          const { content, total, size, number } = response.data;

          currentPage = number;
          totalPages = Math.ceil(total / size);

          if (content.length === 0) {
            loading.classList.add('hidden');
            noPosts.classList.remove('hidden');
            return;
          }

          // Render posts
          let html = '';
          content.forEach(post => {
            const postDate = new Date(post.createdAt).toLocaleDateString('zh-TW');
            const readingTime = Math.ceil((post.content?.length || 0) / 200);

            // Collect categories
            if (post.category?.name) {
              allCategories.add(post.category.name);
            }

            html += `
              <a href="/blog/${post.id}" class="block group">
                <div class="flex gap-8">
                  <div class="w-40 h-28 bg-zinc-200 dark:bg-zinc-800 rounded overflow-hidden flex-shrink-0">
                    ${post.featuredImage ? `<img src="${post.featuredImage}" class="w-full h-full object-cover" />` : ''}
                  </div>
                  <div class="flex-1">
                    <div class="text-red-600 text-xs uppercase">${post.category?.name || 'Uncategorized'}</div>
                    <h2 class="text-3xl font-medium group-hover:text-red-600 transition">${post.title}</h2>
                    <p class="text-zinc-500 mt-3 line-clamp-2">${post.summary || post.content?.substring(0, 200) || ''}</p>
                    <div class="mt-4 text-xs text-zinc-400">
                      ${postDate} • ${readingTime} min read
                    </div>
                  </div>
                </div>
              </a>
            `;
          });

          postsContainer.innerHTML = html;

          loading.classList.add('hidden');
          postsContainer.classList.remove('hidden');
          pagination.classList.remove('hidden');

          // Update pagination
          document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages}`;
          document.getElementById('prevBtn').disabled = currentPage <= 1;
          document.getElementById('nextBtn').disabled = currentPage >= totalPages;

          // Render categories
          renderCategories();
        }
      } catch (error) {
        console.error('Failed to load posts:', error);
        loading.classList.add('hidden');
        noPosts.classList.remove('hidden');
        noPosts.querySelector('p').textContent = 'Failed to load posts. Please try again later.';
      }
    };

    const renderCategories = () => {
      const container = document.getElementById('categories');
      let html = '';
      allCategories.forEach(cat => {
        html += `
          <button onclick="filterByCategory('${cat.replace(/'/g, "\\'")}')"
                  class="px-4 py-1.5 bg-zinc-100 dark:bg-zinc-800 rounded-full text-sm hover:bg-red-100 dark:hover:bg-red-900 transition">
            ${cat}
          </button>
        `;
      });
      container.innerHTML = html;
    };

    const filterByCategory = (category) => {
      const posts = document.querySelectorAll('#posts > a');
      posts.forEach(post => {
        const postCategory = post.querySelector('.text-red-600.text-xs').textContent;
        post.style.display = postCategory === category ? 'block' : 'none';
      });
    };

    // Pagination handlers
    document.getElementById('prevBtn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        loadPosts(currentPage - 1);
      }
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        loadPosts(currentPage + 1);
      }
    });

    // Initialize
    document.addEventListener('DOMContentLoaded', () => {
      loadPosts(1);
    });
  </script>
</Layout>
