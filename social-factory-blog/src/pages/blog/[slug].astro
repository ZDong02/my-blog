---
import Layout from '../../layouts/Layout.astro';
import { BUILD_API_BASE_URL } from '../../lib/api-config.js';

export async function getStaticPaths() {
  try {
    const response = await fetch(`${BUILD_API_BASE_URL}/posts?page=1&size=1000`);
    const payload = await response.json();
    const posts = payload?.data?.content || payload?.data?.list || [];

    if (Array.isArray(posts) && posts.length > 0) {
      return posts
        .filter((post) => post?.id !== undefined && post?.id !== null)
        .map((post) => ({
          params: { slug: String(post.id) }
        }));
    }
  } catch (error) {
    console.warn('Falling back to numeric blog paths:', error);
  }

  return Array.from({ length: 300 }, (_, index) => ({
    params: { slug: String(index + 1) }
  }));
}

const { slug } = Astro.params;
---

<Layout
  title="文章 - Social Factory"
  description="阅读文章详情"
  type="article"
>
  <div class="min-h-screen pb-20">
    <article class="max-w-4xl mx-auto px-4 sm:px-8">

    <!-- Loading State - Skeleton -->
    <div id="loading" class="hidden">
      <div class="mb-10">
        <div class="flex items-center gap-3 mb-6">
          <div class="skeleton-text w-20"></div>
          <div class="skeleton-text w-16 h-6"></div>
        </div>
        <div class="skeleton-title w-full mb-4"></div>
        <div class="skeleton-title w-3/4 mb-6"></div>
        <div class="flex gap-4 mb-12">
          <div class="skeleton-text w-32"></div>
          <div class="skeleton-text w-24"></div>
        </div>
      </div>
      <div class="skeleton-image w-full aspect-[16/9] mb-12"></div>
      <div class="space-y-4 mb-12">
        <div class="skeleton-text w-full"></div>
        <div class="skeleton-text w-full"></div>
        <div class="skeleton-text w-3/4"></div>
        <div class="skeleton-text w-full"></div>
        <div class="skeleton-text w-2/3"></div>
      </div>
      <div class="flex gap-4 pt-8 border-t border-neutral-200 dark:border-neutral-700">
        <div class="skeleton-text w-24 h-12"></div>
        <div class="skeleton-text w-24 h-12"></div>
        <div class="skeleton-text w-24 h-12"></div>
      </div>
    </div>

    <!-- Article Content (loaded via JS) -->
    <div id="articleContent" class="hidden">
      <!-- Article Header -->
      <div class="mb-10">
        <div class="flex items-center gap-3 mb-6">
          <button onclick="window.history.back()" class="flex items-center gap-2 text-neutral-600 dark:text-neutral-400 hover:text-brand-red transition group">
            <svg class="h-4 w-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            <span class="text-sm font-bold">返回</span>
          </button>
          <span id="category" class="badge-red"></span>
        </div>
        <h1 id="title" class="text-3xl sm:text-4xl lg:text-5xl font-black text-neutral-900 dark:text-white leading-tight mb-6"></h1>
        <div class="flex items-center gap-4 text-sm text-neutral-500">
          <span id="pubDate"></span>
          <span>·</span>
          <span id="readingTime"></span>
        </div>
      </div>

      <!-- Featured Image -->
      <div class="mb-12 overflow-hidden">
        <img id="featuredImage" src="" alt="文章封面图片" class="w-full h-auto object-cover" />
      </div>

      <!-- Article Content -->
      <div id="content" class="prose prose-lg dark:prose-invert max-w-none
                    prose-headings:font-bold prose-headings:text-neutral-900 dark:prose-headings:text-white
                    prose-a:text-brand-red prose-a:no-underline hover:prose-a:underline
                    prose-img:rounded-xl prose-img:shadow-md
                    prose-pre:bg-neutral-900 prose-pre:border prose-pre:border-neutral-800
                    prose-blockquote:border-brand-red prose-blockquote:bg-brand-red/5
                    prose-code:text-brand-red prose-code:bg-neutral-100 dark:prose-code:bg-neutral-800 prose-code:px-1.5 prose-code:rounded">
      </div>

      <!-- Article Footer - Interactions -->
      <div class="mt-16 pt-8 border-t-2 border-neutral-200 dark:border-neutral-700">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-3">
            <!-- Like Button -->
            <button id="likeBtn" class="group flex items-center gap-2 px-5 py-3 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer rounded-none">
              <svg id="likeIcon" class="h-5 w-5 text-neutral-500 group-hover:text-brand-red transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
              <span id="likeCount" class="text-sm font-bold text-neutral-700 dark:text-neutral-300">0</span>
            </button>

            <!-- Bookmark Button -->
            <button id="bookmarkBtn" class="group flex items-center gap-2 px-5 py-3 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer rounded-none">
              <svg id="bookmarkIcon" class="h-5 w-5 text-neutral-500 group-hover:text-brand-red transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
              </svg>
              <span class="text-sm font-bold text-neutral-700 dark:text-neutral-300">收藏</span>
            </button>

            <!-- Share Button -->
            <button onclick="shareArticle()" class="group flex items-center gap-2 px-5 py-3 border border-neutral-200 dark:border-neutral-700 hover:border-brand-red dark:hover:border-brand-red transition cursor-pointer rounded-none">
              <svg class="h-5 w-5 text-neutral-500 group-hover:text-brand-red transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
              <span class="text-sm font-bold text-neutral-700 dark:text-neutral-300">分享</span>
            </button>
          </div>

          <!-- Stats -->
          <div class="flex items-center gap-6 text-sm text-neutral-500">
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <span id="viewCount">0</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <span id="commentCount">0</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Comments Section -->
      <div class="mt-16 pt-10 border-t-2 border-neutral-200 dark:border-neutral-700">
        <h3 class="text-2xl font-black text-neutral-900 dark:text-white mb-8 flex items-center gap-3">
          <span>评论</span>
          <span id="commentsCount" class="badge-red">0</span>
        </h3>

        <!-- Comment Form (for logged in users) -->
        <div id="commentForm" class="hidden mb-10">
          <form id="addCommentForm" class="space-y-4">
            <div>
              <label for="commentContent" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">发表评论</label>
              <textarea
                id="commentContent"
                rows="4"
                class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition resize-none rounded-none"
                placeholder="分享你的想法..."
              ></textarea>
            </div>
            <div class="flex justify-end">
              <button
                type="submit"
                class="btn-primary"
              >发表评论</button>
            </div>
          </form>
        </div>

        <!-- Login Prompt -->
        <div id="loginToComment" class="hidden mb-10 p-6 bg-neutral-50 dark:bg-neutral-800 text-center border border-neutral-200 dark:border-neutral-700">
          <p class="text-neutral-600 dark:text-neutral-400">
            请 <a href="/login" class="text-brand-red hover:underline font-bold">登录</a> 后发表评论
          </p>
        </div>

        <!-- Comments List -->
        <div id="commentsList" class="space-y-6">
          <!-- Comments will be loaded here -->
        </div>
      </div>
    </div>
  </article>
  </div>

  <script>
    import { apiClient } from '../../lib/api.js';

    let postId = null;
    let isLiked = false;
    let isBookmarked = false;
    let postTitle = '';
    let postDescription = '';

    const pathParts = window.location.pathname.split('/').filter(Boolean);
    postId = pathParts[pathParts.length - 1] || '1';

    if (isNaN(parseInt(postId))) {
      postId = '1';
    }

    const renderMarkdown = (md) => {
      // Sanitize: escape raw HTML to prevent XSS
      let text = String(md)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      const lines = text.split('\n');
      const output = [];
      let i = 0;
      let inCodeBlock = false;
      let codeContent = [];
      let codeLang = '';

      while (i < lines.length) {
        const line = lines[i];

        // Fenced code blocks
        if (line.trim().startsWith('```')) {
          if (!inCodeBlock) {
            inCodeBlock = true;
            codeLang = line.trim().slice(3).trim();
            codeContent = [];
          } else {
            output.push(`<pre><code${codeLang ? ` class="language-${codeLang}"` : ''}>${codeContent.join('\n')}</code></pre>`);
            inCodeBlock = false;
            codeLang = '';
          }
          i++;
          continue;
        }

        if (inCodeBlock) {
          codeContent.push(line);
          i++;
          continue;
        }

        // Horizontal rules
        if (/^(\s*[-*_]\s*){3,}$/.test(line)) {
          output.push('<hr>');
          i++;
          continue;
        }

        // Headings
        const headingMatch = line.match(/^(#{1,6})\s+(.+)$/);
        if (headingMatch) {
          const level = headingMatch[1].length;
          output.push(`<h${level}>${headingMatch[2]}</h${level}>`);
          i++;
          continue;
        }

        // Blockquotes
        if (line.startsWith('&gt; ') || line === '&gt;') {
          const quoteLines = [];
          while (i < lines.length && (lines[i].startsWith('&gt; ') || lines[i] === '&gt;')) {
            quoteLines.push(lines[i].replace(/^&gt;\s?/, ''));
            i++;
          }
          output.push(`<blockquote><p>${quoteLines.join(' ')}</p></blockquote>`);
          continue;
        }

        // Unordered lists
        if (/^\s*[-*+]\s+/.test(line)) {
          const listItems = [];
          while (i < lines.length && /^\s*[-*+]\s+/.test(lines[i])) {
            listItems.push(`<li>${lines[i].replace(/^\s*[-*+]\s+/, '')}</li>`);
            i++;
          }
          output.push(`<ul>${listItems.join('')}</ul>`);
          continue;
        }

        // Ordered lists
        if (/^\s*\d+\.\s+/.test(line)) {
          const listItems = [];
          while (i < lines.length && /^\s*\d+\.\s+/.test(lines[i])) {
            listItems.push(`<li>${lines[i].replace(/^\s*\d+\.\s+/, '')}</li>`);
            i++;
          }
          output.push(`<ol>${listItems.join('')}</ol>`);
          continue;
        }

        // Empty lines
        if (line.trim() === '') {
          output.push('');
          i++;
          continue;
        }

        // Paragraphs: collect consecutive non-empty, non-special lines
        const paraLines = [];
        while (i < lines.length &&
          lines[i].trim() !== '' &&
          !lines[i].trim().startsWith('```') &&
          !/^#{1,6}\s+/.test(lines[i]) &&
          !lines[i].startsWith('&gt; ') &&
          !/^\s*[-*+]\s+/.test(lines[i]) &&
          !/^\s*\d+\.\s+/.test(lines[i]) &&
          !/^(\s*[-*_]\s*){3,}$/.test(lines[i])) {
          paraLines.push(lines[i]);
          i++;
        }
        if (paraLines.length > 0) {
          output.push(`<p>${paraLines.join(' ')}</p>`);
        }
      }

      // Close unclosed code block
      if (inCodeBlock) {
        output.push(`<pre><code>${codeContent.join('\n')}</code></pre>`);
      }

      // Apply inline markdown formatting
      let result = output.join('\n');
      // Bold: **text** or __text__
      result = result.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
      result = result.replace(/__(.+?)__/g, '<strong>$1</strong>');
      // Italic: *text* or _text_
      result = result.replace(/\*(.+?)\*/g, '<em>$1</em>');
      result = result.replace(/_(.+?)_/g, '<em>$1</em>');
      // Inline code
      result = result.replace(/`([^`]+)`/g, '<code>$1</code>');
      // Images (before links to avoid conflict)
      result = result.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1">');
      // Links
      result = result.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');

      return result;
    };

    const loadPostData = async () => {
      try {
        const response = await apiClient.getPost(postId);
        if (response.success && response.data) {
          const post = response.data;

          postTitle = post.title || '文章';
          postDescription = post.summary || post.content?.substring(0, 160) || '';
          document.title = `${postTitle} - Social Factory`;

          document.getElementById('title').textContent = post.title;
          document.getElementById('category').textContent = post.category?.name || 'Uncategorized';

          const pubDate = new Date(post.publishedAt || post.createdAt);
          document.getElementById('pubDate').textContent = pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });

          const readingTime = Math.ceil((post.content?.length || 0) / 200);
          document.getElementById('readingTime').textContent = `${readingTime} 分钟阅读`;

          const featuredImage = document.getElementById('featuredImage');
          if (post.featuredImage) {
            featuredImage.onerror = () => {
              featuredImage.style.display = 'none';
            };
            featuredImage.src = apiClient.resolveMediaUrl(post.featuredImage);
            featuredImage.alt = post.title;
          } else {
            featuredImage.style.display = 'none';
          }

          const contentDiv = document.getElementById('content');
          if (post.content) {
            contentDiv.innerHTML = renderMarkdown(post.content);
          }

          document.getElementById('viewCount').textContent = post.viewCount || 0;
          document.getElementById('likeCount').textContent = post.likeCount || 0;
          document.getElementById('commentCount').textContent = post.commentCount || 0;

          document.getElementById('loading').classList.add('hidden');
          document.getElementById('articleContent').classList.remove('hidden');
        } else {
          document.getElementById('loading').innerHTML = `
            <div class="text-center py-16">
              <p class="text-neutral-500">文章未找到</p>
            </div>
          `;
        }
      } catch (error) {
        console.error('Failed to load post data:', error);
        document.getElementById('loading').innerHTML = `
          <div class="text-center py-16">
            <p class="text-neutral-500">加载文章失败，请稍后再试</p>
          </div>
        `;
      }
    };

    const checkAuthAndSetup = async (retryCount = 0) => {
      const MAX_RETRIES = 10;

      if (window.authManager.isLoading && retryCount < MAX_RETRIES) {
        setTimeout(() => checkAuthAndSetup(retryCount + 1), 100);
        return;
      }

      if (retryCount >= MAX_RETRIES) {
        console.warn('Auth check timed out, proceeding without auth state');
      }

      if (window.authManager.isAuthenticated) {
        await checkInteractionStatus();
        document.getElementById('commentForm').classList.remove('hidden');
      } else {
        document.getElementById('loginToComment').classList.remove('hidden');
      }

      setupInteractionHandlers();
      await loadComments();
    };

    const checkInteractionStatus = async () => {
      try {
        const [likeResponse, bookmarkResponse] = await Promise.all([
          apiClient.checkLikeStatus(postId),
          apiClient.checkBookmarkStatus(postId)
        ]);

        if (likeResponse.success) {
          isLiked = likeResponse.data;
          updateLikeButton();
        }

        if (bookmarkResponse.success) {
          isBookmarked = bookmarkResponse.data;
          updateBookmarkButton();
        }
      } catch (error) {
        console.error('Failed to check interaction status:', error);
      }
    };

    const updateLikeButton = () => {
      const likeBtn = document.getElementById('likeBtn');
      const likeIcon = document.getElementById('likeIcon');
      const likeCount = document.getElementById('likeCount');

      if (isLiked) {
        likeIcon.setAttribute('fill', 'currentColor');
        likeIcon.classList.add('text-brand-red');
        likeIcon.classList.remove('text-neutral-500');
        likeCount.classList.add('text-brand-red');
        likeCount.classList.remove('text-neutral-700');
      } else {
        likeIcon.setAttribute('fill', 'none');
        likeIcon.classList.remove('text-brand-red');
        likeIcon.classList.add('text-neutral-500');
        likeCount.classList.remove('text-brand-red');
        likeCount.classList.add('text-neutral-700');
      }
    };

    const updateBookmarkButton = () => {
      const bookmarkIcon = document.getElementById('bookmarkIcon');

      if (isBookmarked) {
        bookmarkIcon.setAttribute('fill', 'currentColor');
        bookmarkIcon.classList.add('text-brand-red');
        bookmarkIcon.classList.remove('text-neutral-500');
      } else {
        bookmarkIcon.setAttribute('fill', 'none');
        bookmarkIcon.classList.remove('text-brand-red');
        bookmarkIcon.classList.add('text-neutral-500');
      }
    };

    const setupInteractionHandlers = () => {
      document.getElementById('likeBtn').addEventListener('click', async () => {
        if (!window.authManager.isAuthenticated) {
          window.location.href = '/login';
          return;
        }

        try {
          if (isLiked) {
            await apiClient.unlikePost(postId);
            isLiked = false;
            const count = parseInt(document.getElementById('likeCount').textContent) - 1;
            document.getElementById('likeCount').textContent = String(count);
          } else {
            await apiClient.likePost(postId);
            isLiked = true;
            const count = parseInt(document.getElementById('likeCount').textContent) + 1;
            document.getElementById('likeCount').textContent = String(count);
          }
          updateLikeButton();
        } catch (error) {
          console.error('Failed to toggle like:', error);
        }
      });

      document.getElementById('bookmarkBtn').addEventListener('click', async () => {
        if (!window.authManager.isAuthenticated) {
          window.location.href = '/login';
          return;
        }

        try {
          if (isBookmarked) {
            await apiClient.removeBookmark(postId);
            isBookmarked = false;
          } else {
            await apiClient.bookmarkPost(postId);
            isBookmarked = true;
          }
          updateBookmarkButton();
        } catch (error) {
          console.error('Failed to toggle bookmark:', error);
        }
      });

      document.getElementById('addCommentForm')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const content = document.getElementById('commentContent')?.value.trim();
        if (!content) return;

        try {
          const response = await apiClient.addComment(postId, { content });
          if (response.success) {
            document.getElementById('commentContent').value = '';
            await loadComments();
          }
        } catch (error) {
          console.error('Failed to add comment:', error);
        }
      });
    };

    const countAllComments = (comments = []) => comments.reduce((total, comment) => {
      const replyCount = Array.isArray(comment.replies) ? comment.replies.length : 0;
      return total + 1 + replyCount;
    }, 0);

    const escapeHtml = (value = '') => String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

    const formatCommentDate = (value) => {
      if (!value) return '';
      const date = new Date(value);
      return Number.isNaN(date.getTime()) ? '' : date.toLocaleDateString('zh-TW');
    };

    const getCurrentUserId = () => {
      try {
        const token = localStorage.getItem('auth_token');
        if (!token) return null;
        const payload = JSON.parse(atob(token.split('.')[1]));
        return payload.id || payload.sub;
      } catch { return null; }
    };

    const canEditComment = (comment) => {
      if (!window.authManager.isAuthenticated) return false;
      const currentUserId = getCurrentUserId();
      if (String(comment.userId) !== String(currentUserId)) return false;
      const created = new Date(comment.createdAt);
      const now = new Date();
      const diffMinutes = (now.getTime() - created.getTime()) / (1000 * 60);
      return diffMinutes <= 5;
    };

    const renderReplies = (replies = []) => {
      if (!Array.isArray(replies) || replies.length === 0) {
        return '';
      }

      return `
        <div class="mt-4 pl-4 border-l-2 border-neutral-200 dark:border-neutral-700 space-y-3">
          ${replies.map((reply) => `
            <div class="flex gap-3 p-4 bg-neutral-50 dark:bg-neutral-800" id="comment-${reply.id}">
              <img
                src="${apiClient.resolveMediaUrl(reply.user?.avatar) || '/images/default-avatar.png'}"
                alt="${escapeHtml(reply.user?.nickname || reply.user?.username || 'User')}"
                class="h-8 w-8 rounded-full object-cover flex-shrink-0"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 mb-1">
                  <h5 class="text-sm font-bold text-neutral-900 dark:text-white truncate">
                    ${escapeHtml(reply.user?.nickname || reply.user?.username || 'User')}
                  </h5>
                  <span class="text-xs text-neutral-500">${formatCommentDate(reply.createdAt)}</span>
                  ${reply.updatedAt && new Date(reply.updatedAt) > new Date(new Date(reply.createdAt).getTime() + 60000) ? '<span class="text-xs text-neutral-400">(已编辑)</span>' : ''}
                </div>
                <p class="text-sm text-neutral-700 dark:text-neutral-300 break-words" id="reply-content-${reply.id}">${escapeHtml(reply.content || '')}</p>
                <div class="mt-2 flex items-center gap-3">
                  ${canEditComment(reply) ? `
                    <button onclick="showEditForm(${reply.id}, '${escapeHtml(reply.content).replace(/'/g, "\\'")}')" class="text-xs font-bold text-neutral-400 hover:text-brand-red transition">编辑</button>
                  ` : ''}
                  ${window.authManager.isAuthenticated && String(reply.userId) === String(getCurrentUserId()) ? `
                    <button onclick="deleteCommentById(${reply.id})" class="text-xs font-bold text-neutral-400 hover:text-red-500 transition">删除</button>
                  ` : ''}
                </div>
              </div>
            </div>
          `).join('')}
        </div>
      `;
    };

    const loadComments = async () => {
      try {
        const response = await apiClient.getComments(postId);
        if (response.success && response.data) {
          renderComments(response.data);
          const totalComments = countAllComments(response.data);
          document.getElementById('commentsCount').textContent = totalComments;
          document.getElementById('commentCount').textContent = totalComments;

          // Handle anchor link scroll
          if (window.location.hash && window.location.hash.startsWith('#comment-')) {
            setTimeout(() => {
              const target = document.querySelector(window.location.hash);
              if (target) {
                target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                target.classList.add('ring-2', 'ring-brand-red');
                setTimeout(() => target.classList.remove('ring-2', 'ring-brand-red'), 3000);
              }
            }, 300);
          }
        }
      } catch (error) {
        console.error('Failed to load comments:', error);
      }
    };

    const renderComments = (comments) => {
      const container = document.getElementById('commentsList');

      if (!comments || comments.length === 0) {
        container.innerHTML = '<p class="text-neutral-500 text-center py-10">暂无评论，快来发表第一条评论吧</p>';
        return;
      }

      const currentUserId = getCurrentUserId();
      let html = '';
      comments.forEach(comment => {
        const isOwner = window.authManager.isAuthenticated && String(comment.userId) === String(currentUserId);
        html += `
          <div class="flex gap-4 p-6 bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700" id="comment-${comment.id}">
            <img
              src="${apiClient.resolveMediaUrl(comment.user?.avatar) || '/images/default-avatar.png'}"
              alt="${escapeHtml(comment.user?.nickname || comment.user?.username || 'User')}"
              class="h-10 w-10 rounded-full object-cover flex-shrink-0"
            />
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-3 mb-2">
                <h4 class="font-bold text-neutral-900 dark:text-white truncate">${escapeHtml(comment.user?.nickname || comment.user?.username || 'User')}</h4>
                <span class="text-xs text-neutral-500">${formatCommentDate(comment.createdAt)}</span>
                ${comment.updatedAt && new Date(comment.updatedAt) > new Date(new Date(comment.createdAt).getTime() + 60000) ? '<span class="text-xs text-neutral-400">(已编辑)</span>' : ''}
              </div>
              <p class="text-neutral-700 dark:text-neutral-300 text-sm leading-relaxed break-words" id="comment-content-${comment.id}">${escapeHtml(comment.content || '')}</p>
              <div class="mt-3 flex items-center gap-4">
                <button onclick="showReplyForm(${comment.id})" class="text-xs font-bold text-neutral-500 hover:text-brand-red transition flex items-center gap-1">
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                  </svg>
                  回复
                </button>
                ${canEditComment(comment) ? `
                  <button onclick="showEditForm(${comment.id}, '${escapeHtml(comment.content).replace(/'/g, "\\'")}')" class="text-xs font-bold text-neutral-500 hover:text-brand-red transition flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    编辑
                  </button>
                ` : ''}
                ${isOwner ? `
                  <button onclick="deleteCommentById(${comment.id})" class="text-xs font-bold text-neutral-500 hover:text-red-500 transition flex items-center gap-1">
                    <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    删除
                  </button>
                ` : ''}
              </div>
              ${renderReplies(comment.replies)}
              <div id="reply-form-${comment.id}" class="reply-form-container hidden mt-4">
                <div class="flex gap-2">
                  <textarea
                    id="reply-content-${comment.id}"
                    rows="2"
                    placeholder="写下你的回复..."
                    class="flex-1 px-3 py-2 text-sm border border-neutral-200 dark:border-neutral-700 rounded-none bg-white dark:bg-neutral-900 focus:outline-none focus:border-brand-red resize-none"
                  ></textarea>
                  <button
                    onclick="submitReply(${comment.id})"
                    class="btn-primary px-4 py-2 text-xs self-end"
                  >
                    发送
                  </button>
                </div>
              </div>
              <div id="edit-form-${comment.id}" class="edit-form-container hidden mt-4">
                <div class="flex gap-2">
                  <textarea
                    id="edit-content-${comment.id}"
                    rows="3"
                    class="flex-1 px-3 py-2 text-sm border border-neutral-200 dark:border-neutral-700 rounded-none bg-white dark:bg-neutral-900 focus:outline-none focus:border-brand-red resize-none"
                  ></textarea>
                  <div class="flex flex-col gap-2 self-end">
                    <button onclick="submitEdit(${comment.id})" class="btn-primary px-4 py-2 text-xs">保存</button>
                    <button onclick="cancelEdit(${comment.id})" class="px-4 py-2 text-xs border border-neutral-200 dark:border-neutral-700 text-neutral-500 hover:text-neutral-700 dark:hover:text-neutral-300 transition">取消</button>
                  </div>
                </div>
                <p class="text-xs text-neutral-400 mt-1">发布后 5 分钟内可编辑</p>
              </div>
            </div>
          </div>
        `;
      });

      container.innerHTML = html;
    };

    window.showReplyForm = (commentId) => {
      if (!window.authManager.isAuthenticated) {
        window.location.href = '/login';
        return;
      }

      document.querySelectorAll('.reply-form-container').forEach(form => {
        if (form.id !== `reply-form-${commentId}`) {
          form.classList.add('hidden');
        }
      });
      document.querySelectorAll('.edit-form-container').forEach(form => form.classList.add('hidden'));

      const replyForm = document.getElementById(`reply-form-${commentId}`);
      if (replyForm) {
        replyForm.classList.toggle('hidden');
        const input = document.getElementById(`reply-content-${commentId}`);
        if (input && !replyForm.classList.contains('hidden')) {
          input.focus();
        }
      }
    };

    window.showEditForm = (commentId, currentContent) => {
      document.querySelectorAll('.edit-form-container').forEach(form => {
        if (form.id !== `edit-form-${commentId}`) form.classList.add('hidden');
      });
      document.querySelectorAll('.reply-form-container').forEach(form => form.classList.add('hidden'));

      const editForm = document.getElementById(`edit-form-${commentId}`);
      const editInput = document.getElementById(`edit-content-${commentId}`);
      if (editForm && editInput) {
        editInput.value = currentContent.replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#039;/g, "'");
        editForm.classList.remove('hidden');
        editInput.focus();
        editInput.setSelectionRange(editInput.value.length, editInput.value.length);
      }
    };

    window.cancelEdit = (commentId) => {
      const editForm = document.getElementById(`edit-form-${commentId}`);
      if (editForm) editForm.classList.add('hidden');
    };

    window.submitEdit = async (commentId) => {
      const content = document.getElementById(`edit-content-${commentId}`)?.value.trim();
      if (!content) return;

      try {
        const response = await apiClient.editComment(commentId, content);
        if (response.success) {
          document.getElementById(`edit-form-${commentId}`).classList.add('hidden');
          await loadComments();
          if (window.showToast) window.showToast('评论已更新', 'success');
        } else {
          if (window.showToast) window.showToast(response.message || '编辑失败', 'error');
        }
      } catch (error) {
        console.error('Failed to edit comment:', error);
        if (window.showToast) window.showToast('编辑失败，请稍后重试', 'error');
      }
    };

    window.deleteCommentById = async (commentId) => {
      if (!confirm('确定要删除这条评论吗？')) return;

      try {
        const response = await apiClient.deleteComment(commentId);
        if (response.success) {
          await loadComments();
          if (window.showToast) window.showToast('评论已删除', 'success');
        } else {
          if (window.showToast) window.showToast(response.message || '删除失败', 'error');
        }
      } catch (error) {
        console.error('Failed to delete comment:', error);
        if (window.showToast) window.showToast('删除失败，请稍后重试', 'error');
      }
    };

    window.submitReply = async (commentId) => {
      if (!window.authManager.isAuthenticated) {
        window.location.href = '/login';
        return;
      }

      const content = document.getElementById(`reply-content-${commentId}`)?.value.trim();
      if (!content) {
        return;
      }

      try {
        const response = await apiClient.addComment(postId, { content, parentId: commentId });
        if (response.success) {
          document.getElementById(`reply-content-${commentId}`).value = '';
          document.getElementById(`reply-form-${commentId}`).classList.add('hidden');
          await loadComments();
        }
      } catch (error) {
        console.error('Failed to add reply:', error);
      }
    };

    const shareArticle = async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href
          });
        } catch (error) {
          // Share cancelled
        }
      } else {
        try {
          await navigator.clipboard.writeText(window.location.href);
        } catch (error) {
          // Clipboard access denied
        }
      }
    };

    const init = () => {
      loadPostData();
      checkAuthAndSetup();
    };

    document.addEventListener('DOMContentLoaded', init);
  </script>
</Layout>
