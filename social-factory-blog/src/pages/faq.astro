---
import Layout from "../layouts/Layout.astro";
---

<Layout title="FAQ - Social Factory">
  <div class="min-h-screen bg-white dark:bg-zinc-950 pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h1 class="text-5xl md:text-7xl font-black text-zinc-900 dark:text-white mb-6 tracking-tight">
          FAQ
        </h1>
        <div class="w-24 h-1 bg-red-600 mx-auto mb-8"></div>
        <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
          Frequently asked questions about Social Factory.
          Can't find what you're looking for? <a href="/contact" class="text-red-600 hover:underline">Contact us</a>.
        </p>
      </div>

      <!-- FAQ Categories -->
      <div class="space-y-12">
        <!-- General Questions -->
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center gap-3">
            <span class="w-8 h-8 bg-red-600 text-white rounded flex items-center justify-center text-sm font-bold">G</span>
            General
          </h2>
          <div class="space-y-4">
            <!-- FAQ Item 1 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  What is Social Factory?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                Social Factory is a blogging platform dedicated to promoting social awareness and compassion.
                We provide a space for individuals to share stories, raise awareness about social issues,
                and connect with others who care about making a positive impact in the world.
              </div>
            </details>

            <!-- FAQ Item 2 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  What does "No Favouritism" mean?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                "No Favouritism" is our core principle. It means we treat all voices equally,
                regardless of background, status, or popularity. Every story deserves to be heard,
                and every person deserves a fair chance to share their perspective. We believe
                in judging content by its merit and impact, not by who created it.
              </div>
            </details>

            <!-- FAQ Item 3 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  Is Social Factory free to use?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                Yes! Social Factory is completely free to use. Anyone can create an account,
                read articles, and engage with the community at no cost. We believe that
                access to information and the ability to share ideas should be available to everyone.
              </div>
            </details>

            <!-- FAQ Item 4 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  Who can create an account?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                Anyone can create an account! Simply click on the "Register" button,
                fill in your details, and you'll be ready to join our community.
                We welcome individuals from all backgrounds who share our values of
                compassion and equality.
              </div>
            </details>
          </div>
        </div>

        <!-- Account & Profile -->
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center gap-3">
            <span class="w-8 h-8 bg-red-600 text-white rounded flex items-center justify-center text-sm font-bold">A</span>
            Account & Profile
          </h2>
          <div class="space-y-4">
            <!-- FAQ Item 5 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  How do I reset my password?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                If you've forgotten your password, click on "Forgot Password" on the login page.
                Enter your email address, and we'll send you a link to reset your password.
                If you continue to experience issues, please contact our support team.
              </div>
            </details>

            <!-- FAQ Item 6 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  Can I change my username?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                Usernames are permanent and cannot be changed after account creation.
                However, you can change your display name (nickname) at any time from
                your profile settings. The display name is what other users see on your posts and comments.
              </div>
            </details>

            <!-- FAQ Item 7 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  How do I delete my account?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                To delete your account, go to your Profile settings and scroll to the
                "Delete Account" section. Please note that this action is permanent and
                will remove all your posts, comments, and personal data. If you need
                assistance, contact our support team.
              </div>
            </details>
          </div>
        </div>

        <!-- Content & Posting -->
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center gap-3">
            <span class="w-8 h-8 bg-red-600 text-white rounded flex items-center justify-center text-sm font-bold">C</span>
            Content & Posting
          </h2>
          <div class="space-y-4">
            <!-- FAQ Item 8 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  How do I publish a post?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                Once logged in, navigate to your Dashboard and click on "Create New Post".
                Fill in the title, content, and optionally add a featured image.
                Choose a category for your post, then click "Publish". Your post will
                be immediately visible to other users.
              </div>
            </details>

            <!-- FAQ Item 9 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  What content is allowed?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                We encourage diverse perspectives and creative expression. However, we do not
                allow content that promotes hate speech, harassment, violence, or misinformation.
                Posts should be respectful and contribute positively to the community.
                Violations may result in content removal or account suspension.
              </div>
            </details>

            <!-- FAQ Item 10 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  Can I edit or delete my posts?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                Yes! You can edit or delete your own posts at any time. Go to your Dashboard,
                find the post you want to modify, and click "Edit" or "Delete".
                Deleted posts cannot be recovered, so please be certain before confirming.
              </div>
            </details>
          </div>
        </div>

        <!-- Features & Interaction -->
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6 flex items-center gap-3">
            <span class="w-8 h-8 bg-red-600 text-white rounded flex items-center justify-center text-sm font-bold">F</span>
            Features & Interaction
          </h2>
          <div class="space-y-4">
            <!-- FAQ Item 11 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  How do I like or bookmark a post?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                While reading a post, you'll see a heart icon (♡) to like it and a
                bookmark icon (📑) to save it for later. Click the heart to show
                appreciation, and click the bookmark to add it to your "My Bookmarks"
                page for easy access.
              </div>
            </details>

            <!-- FAQ Item 12 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  How do comments work?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                At the bottom of each post, you'll find a comment section. Logged-in users
                can leave comments, reply to others, and engage in discussions.
                Comments should be respectful and relevant. Report inappropriate comments
                using the flag icon.
              </div>
            </details>

            <!-- FAQ Item 13 -->
            <details class="group bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 select-none">
                <h3 class="text-lg font-semibold text-zinc-900 dark:text-white pr-4">
                  Can I search for specific topics?
                </h3>
                <span class="text-red-600 transform group-open:rotate-45 transition-transform duration-200 text-2xl font-bold">+</span>
              </summary>
              <div class="px-6 pb-6 text-zinc-600 dark:text-zinc-400 leading-relaxed">
                Yes! Use the search bar in the navigation menu to find posts by keyword,
                author, or category. You can also browse posts by category or view
                the latest posts on the homepage.
              </div>
            </details>
          </div>
        </div>
      </div>

      <!-- Still Have Questions CTA -->
      <div class="mt-16 text-center py-12 bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800">
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white mb-4">
          Still Have Questions?
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 mb-8 max-w-2xl mx-auto">
          Can't find the answer you're looking for? Our team is here to help.
        </p>
        <a href="/contact" class="inline-block px-8 py-3 bg-red-600 text-white uppercase tracking-widest hover:bg-red-700 transition font-semibold">
          Contact Support
        </a>
      </div>
    </div>
  </div>
</Layout>
