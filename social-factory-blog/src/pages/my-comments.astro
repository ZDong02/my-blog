---
import Layout from '../layouts/Layout.astro';

const title = '我的评论';
const description = '您的评论历史';
---

<Layout title={title} description={description}>
  <main class="min-h-screen pt-24 pb-12">
    <!-- Hero Section -->
    <section class="py-12 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-4">
          <a href="/dashboard" class="p-2 text-neutral-600 dark:text-neutral-400 hover:text-white hover:bg-brand-red transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <span class="text-neutral-500">仪表盘</span>
        </div>
        <h1 class="text-3xl font-black text-neutral-900 dark:text-white">我的评论</h1>
        <p class="text-neutral-600 dark:text-neutral-400 mt-2">您的评论历史和回复</p>
      </div>
    </section>

    <section class="py-12 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Loading -->
        <div id="loading" class="text-center py-16">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">正在加载...</p>
        </div>

        <!-- Not authenticated -->
        <div id="notAuthenticated" class="hidden card p-12 text-center">
          <div class="w-20 h-20 mx-auto mb-6 bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center">
            <svg class="h-10 w-10 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <p class="text-neutral-600 dark:text-neutral-400 mb-6">请登录以查看您的评论。</p>
          <a href="/login" class="btn-primary">登录</a>
        </div>

        <!-- No comments -->
        <div id="noComments" class="hidden card p-12 text-center">
          <div class="w-20 h-20 mx-auto mb-6 bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center">
            <svg class="h-10 w-10 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <p class="text-neutral-600 dark:text-neutral-400 mb-6">您还没有发布任何评论。</p>
          <a href="/blog" class="btn-primary">浏览文章</a>
        </div>

        <!-- Comments list -->
        <div id="commentsList" class="hidden space-y-4"></div>

        <!-- Pagination -->
        <div id="pagination" class="hidden mt-8 flex items-center justify-center gap-4">
          <button id="prevBtn" class="btn-secondary px-6 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
            上一页
          </button>
          <span id="pageInfo" class="text-sm font-bold text-neutral-500 px-4">第 1 页</span>
          <button id="nextBtn" class="btn-secondary px-6 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
            下一页
          </button>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { apiClient } from '../lib/api.js';

    const escapeHtml = (value = '') => String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');

    let currentPage = 1;
    let totalPages = 1;

    const checkAuthAndLoad = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAuthAndLoad, 100);
        return;
      }

      const loading = document.getElementById('loading');
      const notAuthenticated = document.getElementById('notAuthenticated');

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      loadComments();
    };

    const loadComments = async () => {
      const commentsList = document.getElementById('commentsList');
      const noComments = document.getElementById('noComments');
      const pagination = document.getElementById('pagination');

      try {
        const response = await apiClient.getMyComments(currentPage, 10);

        if (response.success && response.data) {
          const { content, total, size, number } = response.data;
          currentPage = number;
          totalPages = Math.ceil(total / size);

          if (!content || content.length === 0) {
            commentsList.classList.add('hidden');
            pagination.classList.add('hidden');
            noComments.classList.remove('hidden');
            return;
          }

          noComments.classList.add('hidden');
          commentsList.classList.remove('hidden');
          pagination.classList.remove('hidden');

          let html = '';
          content.forEach(comment => {
            const post = comment.post;
            html += `
              <div class="card p-0 overflow-hidden">
                <div class="p-6">
                  <div class="flex items-start justify-between mb-4">
                    <div class="flex items-center gap-3">
                      <div class="p-3 bg-brand-red/10">
                        <svg class="h-5 w-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                        </svg>
                      </div>
                      <span class="text-xs text-neutral-500">
                        ${new Date(comment.createdAt).toLocaleDateString('zh-TW', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit'
                        })}
                      </span>
                    </div>
                    <a href="/blog/${post?.id}#comment-${comment.id}" class="text-sm font-bold text-brand-red hover:text-brand-red-dark flex items-center gap-1">
                      查看评论
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>
                  </div>

                  ${post ? `
                    <div class="mb-4 pb-4 border-b border-neutral-200 dark:border-neutral-700">
                      <a href="/blog/${post.id}" class="text-sm font-bold text-neutral-600 dark:text-neutral-400 hover:text-brand-red transition-colors">
                        文章：${post.title}
                      </a>
                    </div>
                  ` : ''}

                  <div class="bg-neutral-50 dark:bg-neutral-800 p-4 border-l-4 border-brand-red">
                    <p class="text-neutral-700 dark:text-neutral-300 leading-relaxed">${escapeHtml(comment.content)}</p>
                  </div>

                  ${comment.replies && comment.replies.length > 0 ? `
                    <div class="mt-4 pl-4 border-l-2 border-neutral-200 dark:border-neutral-700 space-y-3">
                      ${comment.replies.map(reply => `
                        <div class="bg-neutral-50 dark:bg-neutral-800 p-4">
                          <div class="flex items-center gap-2 mb-2">
                            <span class="text-sm font-bold text-neutral-700 dark:text-neutral-300">${reply.user?.nickname || reply.user?.username}</span>
                            <span class="text-xs text-neutral-500">${new Date(reply.createdAt).toLocaleDateString()}</span>
                          </div>
                          <p class="text-sm text-neutral-600 dark:text-neutral-400">${escapeHtml(reply.content)}</p>
                        </div>
                      `).join('')}
                    </div>
                  ` : ''}
                </div>
              </div>
            `;
          });

          commentsList.innerHTML = html;
          document.getElementById('pageInfo').textContent = `第 ${currentPage} 页，共 ${totalPages} 页`;
          document.getElementById('prevBtn').disabled = currentPage <= 1;
          document.getElementById('nextBtn').disabled = currentPage >= totalPages;
        }
      } catch (error) {
        console.error('Failed to load comments:', error);
      }
    };

    document.getElementById('prevBtn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        loadComments();
      }
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        loadComments();
      }
    });

    document.addEventListener('DOMContentLoaded', checkAuthAndLoad);
  </script>
</Layout>
