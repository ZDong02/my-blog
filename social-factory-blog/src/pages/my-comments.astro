---
import Layout from '../layouts/Layout.astro';

const title = 'My Comments';
const description = 'Your comment history';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gray-50 dark:bg-zinc-950 py-12 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <a href="/dashboard" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white">My Comments</h1>
        </div>
        <p class="text-gray-600 dark:text-gray-400">Your comment history and replies</p>
      </div>

      <!-- Loading -->
      <div id="loading" class="text-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
        <p class="mt-4 text-gray-600 dark:text-gray-400">Loading your comments...</p>
      </div>

      <!-- Not authenticated -->
      <div id="notAuthenticated" class="hidden bg-white dark:bg-zinc-900 shadow rounded-lg p-8 text-center">
        <p class="text-gray-600 dark:text-gray-400 mb-4">Please log in to view your comments.</p>
        <a href="/login" class="inline-block bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg transition">Login</a>
      </div>

      <!-- No comments -->
      <div id="noComments" class="hidden bg-white dark:bg-zinc-900 shadow rounded-lg p-12 text-center">
        <svg class="h-16 w-16 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <p class="mt-4 text-gray-600 dark:text-gray-400">You haven't posted any comments yet.</p>
        <a href="/blog" class="inline-block mt-4 text-red-600 hover:text-red-700">Browse Posts →</a>
      </div>

      <!-- Comments list -->
      <div id="commentsList" class="hidden space-y-4">
        <!-- Comments will be loaded here -->
      </div>

      <!-- Pagination -->
      <div id="pagination" class="hidden mt-8 flex items-center justify-center gap-4">
        <button id="prevBtn" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed">
          Previous
        </button>
        <span id="pageInfo" class="text-sm text-gray-600 dark:text-gray-400">Page 1</span>
        <button id="nextBtn" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed">
          Next
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../lib/api.js';

    let currentPage = 1;
    let totalPages = 1;

    const checkAuthAndLoad = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAuthAndLoad, 100);
        return;
      }

      const loading = document.getElementById('loading');
      const notAuthenticated = document.getElementById('notAuthenticated');

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      loadComments();
    };

    const loadComments = async () => {
      const commentsList = document.getElementById('commentsList');
      const noComments = document.getElementById('noComments');
      const pagination = document.getElementById('pagination');

      try {
        const response = await apiClient.getMyComments(currentPage, 10);

        if (response.success && response.data) {
          const { content, total, size, number } = response.data;
          currentPage = number;
          totalPages = Math.ceil(total / size);

          if (content.length === 0) {
            commentsList.classList.add('hidden');
            pagination.classList.add('hidden');
            noComments.classList.remove('hidden');
            return;
          }

          noComments.classList.add('hidden');
          commentsList.classList.remove('hidden');
          pagination.classList.remove('hidden');

          let html = '';
          content.forEach(comment => {
            const post = comment.post;
            html += `
              <div class="bg-white dark:bg-zinc-900 shadow rounded-lg p-6">
                <div class="flex items-start justify-between mb-3">
                  <div class="flex items-center gap-2">
                    <span class="text-xs text-gray-500 dark:text-gray-400">
                      ${new Date(comment.createdAt).toLocaleDateString('zh-TW', {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      })}
                    </span>
                  </div>
                  <a href="/blog/${post?.id}#comment-${comment.id}" class="text-xs text-red-600 hover:text-red-700 flex items-center gap-1">
                    View Post
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                </div>

                ${post ? `
                  <div class="mb-3">
                    <a href="/blog/${post.id}" class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-red-600">
                      ${post.title}
                    </a>
                  </div>
                ` : ''}

                <div class="border-l-4 border-red-200 dark:border-red-800 pl-4 py-2">
                  <p class="text-gray-700 dark:text-gray-300">${comment.content}</p>
                </div>

                ${comment.replies && comment.replies.length > 0 ? `
                  <div class="mt-4 pl-4 border-l-2 border-gray-200 dark:border-zinc-700 space-y-3">
                    ${comment.replies.map(reply => `
                      <div class="text-sm">
                        <span class="text-gray-500 dark:text-gray-400">${reply.user?.nickname || reply.user?.username}</span>
                        <span class="mx-2 text-gray-400">·</span>
                        <span class="text-xs text-gray-500">${new Date(reply.createdAt).toLocaleDateString()}</span>
                        <p class="mt-1 text-gray-700 dark:text-gray-300">${reply.content}</p>
                      </div>
                    `).join('')}
                  </div>
                ` : ''}
              </div>
            `;
          });

          commentsList.innerHTML = html;
          document.getElementById('pageInfo').textContent = `Page ${currentPage} of ${totalPages}`;
          document.getElementById('prevBtn').disabled = currentPage <= 1;
          document.getElementById('nextBtn').disabled = currentPage >= totalPages;
        }
      } catch (error) {
        console.error('Failed to load comments:', error);
        showError('Failed to load comments');
      }
    };

    // Pagination
    document.getElementById('prevBtn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        loadComments();
      }
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        loadComments();
      }
    });

    document.addEventListener('DOMContentLoaded', checkAuthAndLoad);
  </script>
</Layout>
