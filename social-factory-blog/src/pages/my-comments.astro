---
import Layout from '../layouts/Layout.astro';

const title = '我的评论';
const description = '您的评论历史';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-zinc-950 dark:to-zinc-900 pt-24 pb-12 px-4">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <a href="/dashboard" class="p-2 text-gray-600 dark:text-gray-400 hover:text-white hover:bg-red-600 rounded-lg transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <div>
            <h1 class="text-3xl font-bold text-gray-900 dark:text-white">我的评论</h1>
            <p class="text-gray-600 dark:text-gray-400 mt-1">您的评论历史和回复</p>
          </div>
        </div>
      </div>

      <!-- Loading -->
      <div id="loading" class="text-center py-16">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
        <p class="mt-4 text-gray-600 dark:text-gray-400">正在加载您的评论...</p>
      </div>

      <!-- Not authenticated -->
      <div id="notAuthenticated" class="hidden bg-white dark:bg-zinc-900 shadow-xl rounded-2xl p-12 text-center border border-gray-100 dark:border-zinc-800">
        <svg class="h-16 w-16 mx-auto text-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <p class="text-gray-600 dark:text-gray-400 mb-4">请登录以查看您的评论。</p>
        <a href="/login" class="inline-block bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg transition shadow-lg shadow-red-600/20">登录</a>
      </div>

      <!-- No comments -->
      <div id="noComments" class="hidden bg-white dark:bg-zinc-900 shadow-xl rounded-2xl p-12 text-center border border-gray-100 dark:border-zinc-800">
        <svg class="h-16 w-16 mx-auto text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
        </svg>
        <p class="mt-4 text-gray-600 dark:text-gray-400">您还没有发布任何评论。</p>
        <a href="/blog" class="inline-block mt-4 text-red-600 hover:text-red-700 font-medium">浏览文章 →</a>
      </div>

      <!-- Comments list -->
      <div id="commentsList" class="hidden space-y-4">
        <!-- Comments will be loaded here -->
      </div>

      <!-- Pagination -->
      <div id="pagination" class="hidden mt-8 flex items-center justify-center gap-4">
        <button id="prevBtn" class="px-5 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed font-medium">
          上一页
        </button>
        <span id="pageInfo" class="text-sm font-medium text-gray-600 dark:text-gray-400 px-4">第 1 页</span>
        <button id="nextBtn" class="px-5 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition disabled:opacity-50 disabled:cursor-not-allowed font-medium">
          下一页
        </button>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../lib/api.js';

    let currentPage = 1;
    let totalPages = 1;

    const checkAuthAndLoad = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAuthAndLoad, 100);
        return;
      }

      const loading = document.getElementById('loading');
      const notAuthenticated = document.getElementById('notAuthenticated');

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      loadComments();
    };

    const loadComments = async () => {
      const commentsList = document.getElementById('commentsList');
      const noComments = document.getElementById('noComments');
      const pagination = document.getElementById('pagination');

      try {
        const response = await apiClient.getMyComments(currentPage, 10);

        if (response.success && response.data) {
          const { content, total, size, number } = response.data;
          currentPage = number;
          totalPages = Math.ceil(total / size);

          if (content.length === 0) {
            commentsList.classList.add('hidden');
            pagination.classList.add('hidden');
            noComments.classList.remove('hidden');
            return;
          }

          noComments.classList.add('hidden');
          commentsList.classList.remove('hidden');
          pagination.classList.remove('hidden');

          let html = '';
          content.forEach(comment => {
            const post = comment.post;
            html += `
              <div class="group bg-white dark:bg-zinc-900 shadow-lg rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-100 dark:border-zinc-800">
                <div class="p-5">
                  <div class="flex items-start justify-between mb-3">
                    <div class="flex items-center gap-3">
                      <div class="p-2 bg-green-100 dark:bg-green-900/30 rounded-xl">
                        <svg class="h-4 w-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/>
                        </svg>
                      </div>
                      <span class="text-xs text-gray-500 dark:text-gray-400">
                        ${new Date(comment.createdAt).toLocaleDateString('zh-TW', {
                          year: 'numeric',
                          month: 'long',
                          day: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit'
                        })}
                      </span>
                    </div>
                    <a href="/blog/${post?.id}#comment-${comment.id}" class="text-xs text-red-600 hover:text-red-700 flex items-center gap-1 font-medium">
                      查看评论
                      <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>
                  </div>

                  ${post ? `
                    <div class="mb-3 pb-3 border-b border-gray-100 dark:border-zinc-800">
                      <a href="/blog/${post.id}" class="text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-red-600 transition-colors">
                        文章：${post.title}
                      </a>
                    </div>
                  ` : ''}

                  <div class="bg-gradient-to-r from-green-50 to-transparent dark:from-zinc-800 rounded-xl p-4 border-l-4 border-green-500 dark:border-green-600">
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed">${comment.content}</p>
                  </div>

                  ${comment.replies && comment.replies.length > 0 ? `
                    <div class="mt-4 pl-4 border-l-2 border-gray-200 dark:border-zinc-700 space-y-3">
                      ${comment.replies.map(reply => `
                        <div class="bg-gray-50 dark:bg-zinc-800/50 rounded-xl p-4">
                          <div class="flex items-center gap-2 mb-2">
                            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">${reply.user?.nickname || reply.user?.username}</span>
                            <span class="text-xs text-gray-400">${new Date(reply.createdAt).toLocaleDateString()}</span>
                          </div>
                          <p class="text-gray-600 dark:text-gray-400 text-sm">${reply.content}</p>
                        </div>
                      `).join('')}
                    </div>
                  ` : ''}
                </div>
              </div>
            `;
          });

          commentsList.innerHTML = html;
          document.getElementById('pageInfo').textContent = `第 ${currentPage} 页，共 ${totalPages} 页`;
          document.getElementById('prevBtn').disabled = currentPage <= 1;
          document.getElementById('nextBtn').disabled = currentPage >= totalPages;
        }
      } catch (error) {
        console.error('Failed to load comments:', error);
        showError('加载评论失败');
      }
    };

    // Pagination
    document.getElementById('prevBtn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        loadComments();
      }
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        currentPage++;
        loadComments();
      }
    });

    document.addEventListener('DOMContentLoaded', checkAuthAndLoad);
  </script>
</Layout>
