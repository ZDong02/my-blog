---
import Layout from '../layouts/Layout.astro';

const title = '个人设置';
const description = '编辑您的个人资料';
---

<Layout title={title} description={description}>
  <main class="min-h-screen pt-24 pb-12">
    <!-- Hero Section -->
    <section class="py-12 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3 mb-4">
          <a href="/dashboard" class="text-neutral-600 dark:text-neutral-400 hover:text-brand-red transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <span class="text-neutral-500">仪表盘</span>
        </div>
        <h1 class="text-3xl font-black text-neutral-900 dark:text-white">个人设置</h1>
        <p class="text-neutral-600 dark:text-neutral-400 mt-2">管理您的账户信息</p>
      </div>
    </section>

    <section class="py-12 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Loading state -->
        <div id="loading" class="text-center py-12">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">正在加载...</p>
        </div>

        <!-- Not authenticated -->
        <div id="notAuthenticated" class="hidden card p-12 text-center">
          <div class="w-20 h-20 mx-auto mb-6 bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center">
            <svg class="h-10 w-10 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
          </div>
          <p class="text-neutral-600 dark:text-neutral-400 mb-6">请登录以编辑您的个人资料。</p>
          <a href="/login" class="btn-primary">登录</a>
        </div>

        <!-- Profile form -->
        <form id="profileForm" class="hidden card overflow-hidden p-0">
          <div class="px-8 py-6 border-b border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50">
            <h2 class="text-xl font-bold text-neutral-900 dark:text-white flex items-center gap-2">
              <svg class="h-5 w-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              账户信息
            </h2>
          </div>

          <div class="px-8 py-6 space-y-6">
            <!-- Avatar -->
            <div class="flex items-center gap-6">
              <img id="currentAvatar" src="" alt="Avatar" class="h-24 w-24 rounded-full object-cover border-4 border-white dark:border-neutral-700 shadow-lg" />
              <div class="flex-1 space-y-3">
                <label for="avatarFile" class="block text-sm font-bold text-neutral-900 dark:text-white">
                  上传头像
                </label>
                <input
                  type="file"
                  id="avatarFile"
                  accept="image/*"
                  class="block w-full text-sm text-neutral-700 dark:text-neutral-300 file:mr-4 file:py-2 file:px-4 file:rounded-none file:border-0 file:bg-neutral-100 dark:file:bg-neutral-700 file:text-neutral-700 dark:file:text-neutral-200 hover:file:bg-neutral-200 dark:hover:file:bg-neutral-600"
                />
                <div class="flex items-center gap-3">
                  <button
                    type="button"
                    id="uploadAvatarBtn"
                    class="px-4 py-2 text-sm bg-neutral-800 dark:bg-neutral-700 text-white hover:bg-neutral-900 dark:hover:bg-neutral-600 transition rounded-none"
                  >
                    上传头像
                  </button>
                  <span id="avatarUploadStatus" class="text-xs text-neutral-500">未上传头像</span>
                </div>
                <input type="hidden" id="avatar" name="avatar" />
                <p class="text-xs text-neutral-500">头像上传后点击"保存更改"生效</p>
              </div>
            </div>

            <!-- Username (read-only) -->
            <div>
              <label for="username" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                用户名
              </label>
              <input
                type="text"
                id="username"
                name="username"
                readonly
                class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 cursor-not-allowed rounded-none"
              />
              <p class="mt-1 text-xs text-neutral-500">用户名无法更改</p>
            </div>

            <!-- Email (read-only) -->
            <div>
              <label for="email" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                邮箱
              </label>
              <input
                type="email"
                id="email"
                name="email"
                readonly
                class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 text-neutral-500 dark:text-neutral-400 cursor-not-allowed rounded-none"
              />
              <p class="mt-1 text-xs text-neutral-500">邮箱无法更改</p>
            </div>

            <!-- Nickname -->
            <div>
              <label for="nickname" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                显示名称
              </label>
              <input
                type="text"
                id="nickname"
                name="nickname"
                maxlength="50"
                class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
                placeholder="您希望如何显示您的名字？"
              />
            </div>

            <!-- Bio -->
            <div>
              <label for="bio" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                个人简介
              </label>
              <textarea
                id="bio"
                name="bio"
                rows="4"
                maxlength="500"
                class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition resize-none rounded-none"
                placeholder="介绍一下您自己..."
              ></textarea>
              <p class="mt-1 text-xs text-neutral-500">最多 500 个字符</p>
            </div>
          </div>

          <div class="px-8 py-5 border-t border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50 flex items-center justify-end gap-3">
            <a href="/dashboard" class="btn-secondary">取消</a>
            <button type="submit" class="btn-primary">保存更改</button>
          </div>
        </form>

        <!-- Change Password Section -->
        <div id="passwordSection" class="hidden card overflow-hidden p-0 mt-8">
          <div class="px-8 py-6 border-b border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800/50">
            <h2 class="text-xl font-bold text-neutral-900 dark:text-white flex items-center gap-2">
              <svg class="h-5 w-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
              修改密码
            </h2>
          </div>

          <form id="passwordForm" class="px-8 py-6 space-y-6">
            <div>
              <label for="currentPassword" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                当前密码
              </label>
              <input
                type="password"
                id="currentPassword"
                name="currentPassword"
                required
                class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              />
            </div>

            <div>
              <label for="newPassword" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                新密码
              </label>
              <input
                type="password"
                id="newPassword"
                name="newPassword"
                required
                minlength="6"
                class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              />
            </div>

            <div>
              <label for="confirmPassword" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                确认新密码
              </label>
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
                minlength="6"
                class="w-full px-4 py-3 border border-neutral-200 dark:border-neutral-700 bg-white dark:bg-neutral-800 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
              />
            </div>

            <div class="flex items-center justify-end gap-3 pt-4">
              <button type="submit" class="btn-primary">修改密码</button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>

  <script>
    import { apiClient } from '../lib/api.js';

    const checkAuthAndLoad = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAuthAndLoad, 100);
        return;
      }

      const loading = document.getElementById('loading');
      const notAuthenticated = document.getElementById('notAuthenticated');
      const profileForm = document.getElementById('profileForm');
      const passwordSection = document.getElementById('passwordSection');

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      profileForm.classList.remove('hidden');
      passwordSection.classList.remove('hidden');

      loadProfile();
    };

    const loadProfile = async () => {
      try {
        const response = await apiClient.getProfile();
        if (response.success && response.data) {
          const user = response.data;

          document.getElementById('username').value = user.username;
          document.getElementById('email').value = user.email;
          document.getElementById('nickname').value = user.nickname || '';
          document.getElementById('bio').value = user.bio || '';
          setAvatar(apiClient.resolveMediaUrl(user.avatar || ''));
          document.getElementById('avatarFile').value = '';
        }
      } catch (error) {
        console.error('Failed to load profile:', error);
      }
    };

    const setAvatar = (url = '', filename = '') => {
      const hiddenInput = document.getElementById('avatar');
      const avatar = document.getElementById('currentAvatar');
      const status = document.getElementById('avatarUploadStatus');

      hiddenInput.value = url;

      if (url) {
        avatar.src = url;
        status.textContent = filename ? `已上传: ${filename}` : '已上传头像';
        return;
      }

      avatar.src = '/images/default-avatar.png';
      status.textContent = '未上传头像';
    };

    const uploadAvatar = async () => {
      const fileInput = document.getElementById('avatarFile');
      const uploadButton = document.getElementById('uploadAvatarBtn');
      const status = document.getElementById('avatarUploadStatus');
      const file = fileInput.files?.[0];

      if (!file) {
        return;
      }

      uploadButton.disabled = true;
      uploadButton.textContent = '上传中...';
      status.textContent = `正在上传: ${file.name}`;

      try {
        const response = await apiClient.uploadFile(file);
        if (!response.success || !response.data?.url) {
          throw new Error(response.message || '上传失败');
        }

        setAvatar(response.data.url, response.data.filename || file.name);
      } catch (error) {
        console.error('Failed to upload avatar:', error);
        status.textContent = '上传失败，请重试';
      } finally {
        uploadButton.disabled = false;
        uploadButton.textContent = '上传头像';
      }
    };

    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = {
        nickname: document.getElementById('nickname').value,
        avatar: document.getElementById('avatar').value,
        bio: document.getElementById('bio').value
      };

      try {
        const response = await apiClient.updateProfile(formData);
        if (response.success) {
          if (formData.avatar) {
            document.getElementById('currentAvatar').src = formData.avatar;
          }
        }
      } catch (error) {
        console.error('Failed to update profile:', error);
      }
    });

    document.getElementById('passwordForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const currentPassword = document.getElementById('currentPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (newPassword !== confirmPassword) {
        return;
      }

      if (newPassword.length < 6) {
        return;
      }

      try {
        const response = await apiClient.changePassword({
          currentPassword,
          newPassword
        });
        if (response.success) {
          document.getElementById('currentPassword').value = '';
          document.getElementById('newPassword').value = '';
          document.getElementById('confirmPassword').value = '';
        }
      } catch (error) {
        console.error('Failed to change password:', error);
      }
    });

    document.getElementById('uploadAvatarBtn')?.addEventListener('click', uploadAvatar);

    document.getElementById('avatarFile')?.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      const status = document.getElementById('avatarUploadStatus');

      if (file) {
        status.textContent = `已选择: ${file.name}，点击上传`;
      } else if (!document.getElementById('avatar').value) {
        status.textContent = '未上传头像';
      }
    });

    document.addEventListener('DOMContentLoaded', () => {
      setAvatar('');
      checkAuthAndLoad();
    });
  </script>
</Layout>
