---
import Layout from '../layouts/Layout.astro';

const title = 'Profile Settings';
const description = 'Edit your profile';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gray-50 dark:bg-zinc-950 py-12 px-4">
    <div class="max-w-2xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Profile Settings</h1>
        <p class="mt-2 text-gray-600 dark:text-gray-400">Manage your account information</p>
      </div>

      <!-- Loading state -->
      <div id="loading" class="text-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
        <p class="mt-4 text-gray-600 dark:text-gray-400">Loading profile...</p>
      </div>

      <!-- Not authenticated -->
      <div id="notAuthenticated" class="hidden bg-white dark:bg-zinc-900 shadow rounded-lg p-8 text-center">
        <p class="text-gray-600 dark:text-gray-400 mb-4">Please log in to edit your profile.</p>
        <a href="/login" class="inline-block bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg transition">Login</a>
      </div>

      <!-- Profile form -->
      <form id="profileForm" class="hidden bg-white dark:bg-zinc-900 shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-zinc-800">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Account Information</h2>
        </div>

        <div class="px-6 py-6 space-y-6">
          <!-- Avatar -->
          <div class="flex items-center gap-6">
            <img id="currentAvatar" src="" alt="Avatar" class="h-20 w-20 rounded-full object-cover border-2 border-gray-200 dark:border-zinc-700" />
            <div class="flex-1">
              <label for="avatar" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                Avatar URL
              </label>
              <input
                type="url"
                id="avatar"
                name="avatar"
                class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500"
                placeholder="https://example.com/avatar.jpg"
              />
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Enter a URL for your profile picture</p>
            </div>
          </div>

          <!-- Username (read-only) -->
          <div>
            <label for="username" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Username
            </label>
            <input
              type="text"
              id="username"
              name="username"
              readonly
              class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-gray-50 dark:bg-zinc-800 text-gray-500 dark:text-gray-400 cursor-not-allowed"
            />
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Username cannot be changed</p>
          </div>

          <!-- Email (read-only) -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Email
            </label>
            <input
              type="email"
              id="email"
              name="email"
              readonly
              class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-gray-50 dark:bg-zinc-800 text-gray-500 dark:text-gray-400 cursor-not-allowed"
            />
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Email cannot be changed</p>
          </div>

          <!-- Nickname -->
          <div>
            <label for="nickname" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Display Name
            </label>
            <input
              type="text"
              id="nickname"
              name="nickname"
              maxlength="50"
              class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500"
              placeholder="How should we display your name?"
            />
          </div>

          <!-- Bio -->
          <div>
            <label for="bio" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Bio
            </label>
            <textarea
              id="bio"
              name="bio"
              rows="4"
              maxlength="500"
              class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500"
              placeholder="Tell us about yourself..."
            ></textarea>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">Max 500 characters</p>
          </div>
        </div>

        <div class="px-6 py-4 border-t border-gray-200 dark:border-zinc-800 flex items-center justify-end gap-3">
          <a href="/dashboard" class="px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition">Cancel</a>
          <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium">Save Changes</button>
        </div>
      </form>

      <!-- Change Password Section -->
      <div id="passwordSection" class="hidden mt-8 bg-white dark:bg-zinc-900 shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-zinc-800">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white">Change Password</h2>
        </div>

        <form id="passwordForm" class="px-6 py-6 space-y-6">
          <div>
            <label for="currentPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Current Password
            </label>
            <input
              type="password"
              id="currentPassword"
              name="currentPassword"
              required
              class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500"
            />
          </div>

          <div>
            <label for="newPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              New Password
            </label>
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              required
              minlength="6"
              class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500"
            />
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              Confirm New Password
            </label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              minlength="6"
              class="w-full px-4 py-2 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500"
            />
          </div>

          <div class="flex items-center justify-end gap-3 pt-4">
            <button type="submit" class="px-6 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium">Change Password</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../lib/api.js';

    const checkAuthAndLoad = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAuthAndLoad, 100);
        return;
      }

      const loading = document.getElementById('loading');
      const notAuthenticated = document.getElementById('notAuthenticated');
      const profileForm = document.getElementById('profileForm');
      const passwordSection = document.getElementById('passwordSection');

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      profileForm.classList.remove('hidden');
      passwordSection.classList.remove('hidden');

      // Load user data
      loadProfile();
    };

    const loadProfile = async () => {
      try {
        const response = await apiClient.getProfile();
        if (response.success && response.data) {
          const user = response.data;

          document.getElementById('username').value = user.username;
          document.getElementById('email').value = user.email;
          document.getElementById('nickname').value = user.nickname || '';
          document.getElementById('bio').value = user.bio || '';
          document.getElementById('avatar').value = user.avatar || '';
          document.getElementById('currentAvatar').src = user.avatar || '/images/default-avatar.png';
        }
      } catch (error) {
        console.error('Failed to load profile:', error);
        showError('Failed to load profile');
      }
    };

    // Profile update
    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = {
        nickname: document.getElementById('nickname').value,
        avatar: document.getElementById('avatar').value,
        bio: document.getElementById('bio').value
      };

      try {
        const response = await apiClient.updateProfile(formData);
        if (response.success) {
          showSuccess('Profile updated successfully!');
          // Update avatar preview
          if (formData.avatar) {
            document.getElementById('currentAvatar').src = formData.avatar;
          }
        }
      } catch (error) {
        console.error('Failed to update profile:', error);
        showError(error.message || 'Failed to update profile');
      }
    });

    // Password change
    document.getElementById('passwordForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (newPassword !== confirmPassword) {
        showError('Passwords do not match');
        return;
      }

      // Note: Backend needs a password change endpoint
      // For now, show a message
      showWarning('Password change feature coming soon. Please contact support.');
    });

    // Avatar preview update
    document.getElementById('avatar').addEventListener('input', (e) => {
      const avatar = document.getElementById('currentAvatar');
      if (e.target.value) {
        avatar.src = e.target.value;
      } else {
        avatar.src = '/images/default-avatar.png';
      }
    });

    document.addEventListener('DOMContentLoaded', checkAuthAndLoad);
  </script>
</Layout>
