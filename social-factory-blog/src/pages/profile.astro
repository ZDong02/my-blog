---
import Layout from '../layouts/Layout.astro';

const title = '个人设置';
const description = '编辑您的个人资料';
---

<Layout title={title} description={description}>
  <div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100 dark:from-zinc-950 dark:to-zinc-900 pt-24 pb-12 px-4">
    <div class="max-w-3xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-4">
          <a href="/dashboard" class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
          </a>
          <h1 class="text-3xl font-bold text-gray-900 dark:text-white">个人设置</h1>
        </div>
        <p class="text-gray-600 dark:text-gray-400">管理您的账户信息</p>
      </div>

      <!-- Loading state -->
      <div id="loading" class="text-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-red-600 mx-auto"></div>
        <p class="mt-4 text-gray-600 dark:text-gray-400">正在加载个人资料...</p>
      </div>

      <!-- Not authenticated -->
      <div id="notAuthenticated" class="hidden bg-white dark:bg-zinc-900 shadow-xl rounded-2xl p-8 text-center border border-gray-100 dark:border-zinc-800">
        <p class="text-gray-600 dark:text-gray-400 mb-4">请登录以编辑您的个人资料。</p>
        <a href="/login" class="inline-block bg-red-600 hover:bg-red-700 text-white px-6 py-2 rounded-lg transition shadow-lg shadow-red-600/20">登录</a>
      </div>

      <!-- Profile form -->
      <form id="profileForm" class="hidden bg-white dark:bg-zinc-900 shadow-xl rounded-2xl border border-gray-100 dark:border-zinc-800 overflow-hidden">
        <div class="px-8 py-5 border-b border-gray-200 dark:border-zinc-800 bg-gradient-to-r from-gray-50 to-white dark:from-zinc-900/50 dark:to-zinc-900">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white flex items-center gap-2">
            <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            账户信息
          </h2>
        </div>

        <div class="px-8 py-6 space-y-6">
          <!-- Avatar -->
          <div class="flex items-center gap-6">
            <img id="currentAvatar" src="" alt="Avatar" class="h-24 w-24 rounded-full object-cover border-4 border-white dark:border-zinc-700 shadow-lg" />
            <div class="flex-1">
              <label for="avatar" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                头像 URL
              </label>
              <input
                type="url"
                id="avatar"
                name="avatar"
                class="w-full px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500 transition"
                placeholder="https://example.com/avatar.jpg"
              />
              <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">输入您的头像图片链接</p>
            </div>
          </div>

          <!-- Username (read-only) -->
          <div>
            <label for="username" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              用户名
            </label>
            <input
              type="text"
              id="username"
              name="username"
              readonly
              class="w-full px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg bg-gray-50 dark:bg-zinc-800 text-gray-500 dark:text-gray-400 cursor-not-allowed"
            />
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">用户名无法更改</p>
          </div>

          <!-- Email (read-only) -->
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              邮箱
            </label>
            <input
              type="email"
              id="email"
              name="email"
              readonly
              class="w-full px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg bg-gray-50 dark:bg-zinc-800 text-gray-500 dark:text-gray-400 cursor-not-allowed"
            />
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">邮箱无法更改</p>
          </div>

          <!-- Nickname -->
          <div>
            <label for="nickname" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              显示名称
            </label>
            <input
              type="text"
              id="nickname"
              name="nickname"
              maxlength="50"
              class="w-full px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500 transition"
              placeholder="您希望如何显示您的名字？"
            />
          </div>

          <!-- Bio -->
          <div>
            <label for="bio" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              个人简介
            </label>
            <textarea
              id="bio"
              name="bio"
              rows="4"
              maxlength="500"
              class="w-full px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500 transition"
              placeholder="介绍一下您自己..."
            ></textarea>
            <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">最多 500 个字符</p>
          </div>
        </div>

        <div class="px-8 py-5 border-t border-gray-200 dark:border-zinc-800 bg-gray-50 dark:bg-zinc-900/50 flex items-center justify-end gap-3">
          <a href="/dashboard" class="px-5 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg hover:bg-gray-100 dark:hover:bg-zinc-800 transition">取消</a>
          <button type="submit" class="px-6 py-2.5 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium shadow-lg shadow-red-600/20 hover:shadow-red-600/30">保存更改</button>
        </div>
      </form>

      <!-- Change Password Section -->
      <div id="passwordSection" class="hidden mt-8 bg-white dark:bg-zinc-900 shadow-xl rounded-2xl border border-gray-100 dark:border-zinc-800 overflow-hidden">
        <div class="px-8 py-5 border-b border-gray-200 dark:border-zinc-800 bg-gradient-to-r from-gray-50 to-white dark:from-zinc-900/50 dark:to-zinc-900">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-white flex items-center gap-2">
            <svg class="h-5 w-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            修改密码
          </h2>
        </div>

        <form id="passwordForm" class="px-8 py-6 space-y-6">
          <div>
            <label for="currentPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              当前密码
            </label>
            <input
              type="password"
              id="currentPassword"
              name="currentPassword"
              required
              class="w-full px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500 transition"
            />
          </div>

          <div>
            <label for="newPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              新密码
            </label>
            <input
              type="password"
              id="newPassword"
              name="newPassword"
              required
              minlength="6"
              class="w-full px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500 transition"
            />
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
              确认新密码
            </label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              minlength="6"
              class="w-full px-4 py-2.5 border border-gray-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-red-500 transition"
            />
          </div>

          <div class="flex items-center justify-end gap-3 pt-4">
            <button type="submit" class="px-6 py-2.5 bg-red-600 text-white rounded-lg hover:bg-red-700 transition font-medium shadow-lg shadow-red-600/20 hover:shadow-red-600/30">修改密码</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    import { apiClient } from '../lib/api.js';

    const checkAuthAndLoad = async () => {
      if (window.authManager.isLoading) {
        setTimeout(checkAuthAndLoad, 100);
        return;
      }

      const loading = document.getElementById('loading');
      const notAuthenticated = document.getElementById('notAuthenticated');
      const profileForm = document.getElementById('profileForm');
      const passwordSection = document.getElementById('passwordSection');

      if (!window.authManager.isAuthenticated) {
        loading.classList.add('hidden');
        notAuthenticated.classList.remove('hidden');
        return;
      }

      loading.classList.add('hidden');
      profileForm.classList.remove('hidden');
      passwordSection.classList.remove('hidden');

      // Load user data
      loadProfile();
    };

    const loadProfile = async () => {
      try {
        const response = await apiClient.getProfile();
        if (response.success && response.data) {
          const user = response.data;

          document.getElementById('username').value = user.username;
          document.getElementById('email').value = user.email;
          document.getElementById('nickname').value = user.nickname || '';
          document.getElementById('bio').value = user.bio || '';
          document.getElementById('avatar').value = user.avatar || '';
          document.getElementById('currentAvatar').src = user.avatar || '/images/default-avatar.png';
        }
      } catch (error) {
        console.error('Failed to load profile:', error);
        showError('加载个人资料失败');
      }
    };

    // Profile update
    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = {
        nickname: document.getElementById('nickname').value,
        avatar: document.getElementById('avatar').value,
        bio: document.getElementById('bio').value
      };

      try {
        const response = await apiClient.updateProfile(formData);
        if (response.success) {
          showSuccess('个人资料更新成功！');
          // Update avatar preview
          if (formData.avatar) {
            document.getElementById('currentAvatar').src = formData.avatar;
          }
        }
      } catch (error) {
        console.error('Failed to update profile:', error);
        showError(error.message || '更新个人资料失败');
      }
    });

    // Password change
    document.getElementById('passwordForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const currentPassword = document.getElementById('currentPassword').value;
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      if (newPassword !== confirmPassword) {
        showError('密码不匹配');
        return;
      }

      if (newPassword.length < 6) {
        showError('密码长度至少为 6 个字符');
        return;
      }

      try {
        const response = await apiClient.changePassword({
          currentPassword,
          newPassword
        });
        if (response.success) {
          showSuccess('密码已修改！');
          // Clear password fields
          document.getElementById('currentPassword').value = '';
          document.getElementById('newPassword').value = '';
          document.getElementById('confirmPassword').value = '';
        }
      } catch (error) {
        console.error('Failed to change password:', error);
        showError(error.message || '修改密码失败');
      }
    });

    // Avatar preview update
    document.getElementById('avatar').addEventListener('input', (e) => {
      const avatar = document.getElementById('currentAvatar');
      if (e.target.value) {
        avatar.src = e.target.value;
      } else {
        avatar.src = '/images/default-avatar.png';
      }
    });

    document.addEventListener('DOMContentLoaded', checkAuthAndLoad);
  </script>
</Layout>
