---
import Layout from "../layouts/Layout.astro";
---

<Layout title="联系 - Social Factory">
  <div class="min-h-screen bg-white dark:bg-zinc-950 pt-24 pb-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-8 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-16">
        <h1 class="text-5xl md:text-7xl font-black text-zinc-900 dark:text-white mb-6 tracking-tight">
          联系我们
        </h1>
        <div class="w-24 h-1 bg-red-600 mx-auto mb-8"></div>
        <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
          请与我们联系。我们很乐意听到您的声音。
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">
            给我们留言
          </h2>
          <form id="contactForm" class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">
                姓名 <span class="text-red-600">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 border border-zinc-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                placeholder="您的姓名"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">
                邮箱 <span class="text-red-600">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 border border-zinc-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
                placeholder="your@email.com"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">
                主题 <span class="text-red-600">*</span>
              </label>
              <select
                id="subject"
                name="subject"
                required
                class="w-full px-4 py-3 border border-zinc-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition"
              >
                <option value="">请选择主题</option>
                <option value="general">一般咨询</option>
                <option value="support">技术支持</option>
                <option value="feedback">反馈与建议</option>
                <option value="partnership">合作机会</option>
                <option value="report">报告问题</option>
                <option value="other">其他</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">
                留言 <span class="text-red-600">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                class="w-full px-4 py-3 border border-zinc-300 dark:border-zinc-700 rounded-lg bg-white dark:bg-zinc-900 text-zinc-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-red-500 focus:border-transparent transition resize-none"
                placeholder="您的留言..."
              ></textarea>
            </div>

            <button
              type="submit"
              id="submitBtn"
              class="w-full px-8 py-4 bg-red-600 text-white uppercase tracking-widest font-semibold rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-zinc-950 transition disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <span id="submitBtnText">发送留言</span>
              <span id="submitBtnLoading" class="hidden flex items-center justify-center gap-2">
                <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                发送中...
              </span>
            </button>

            <div id="formMessage" class="hidden p-4 rounded-lg text-center"></div>
          </form>
        </div>

        <!-- Contact Info -->
        <div>
          <h2 class="text-2xl font-bold text-zinc-900 dark:text-white mb-6">
            联系方式
          </h2>

          <div class="space-y-6 mb-10">
            <!-- Email -->
            <div class="flex items-start gap-4 p-4 bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800">
              <div class="w-12 h-12 bg-red-600/10 dark:bg-red-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-zinc-900 dark:text-white mb-1">电子邮件</h3>
                <a href="mailto:contact@socialfactory.com" class="text-zinc-600 dark:text-zinc-400 hover:text-red-600 transition">
                  contact@socialfactory.com
                </a>
                <p class="text-sm text-zinc-500 dark:text-zinc-500 mt-1">我们将在 24-48 小时内回复</p>
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-4 p-4 bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800">
              <div class="w-12 h-12 bg-red-600/10 dark:bg-red-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-zinc-900 dark:text-white mb-1">所在地</h3>
                <p class="text-zinc-600 dark:text-zinc-400">
                  远程优先<br>
                  全球运营
                </p>
              </div>
            </div>

            <!-- Social -->
            <div class="flex items-start gap-4 p-4 bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800">
              <div class="w-12 h-12 bg-red-600/10 dark:bg-red-600/20 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-zinc-900 dark:text-white mb-1">关注我们</h3>
                <div class="flex gap-4 mt-2">
                  <a href="#" class="text-zinc-600 dark:text-zinc-400 hover:text-red-600 transition text-sm uppercase tracking-wider">Facebook</a>
                  <a href="#" class="text-zinc-600 dark:text-zinc-400 hover:text-red-600 transition text-sm uppercase tracking-wider">Twitter</a>
                  <a href="#" class="text-zinc-600 dark:text-zinc-400 hover:text-red-600 transition text-sm uppercase tracking-wider">Instagram</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Business Hours -->
          <div class="p-6 bg-zinc-50 dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800">
            <h3 class="font-bold text-zinc-900 dark:text-white mb-4 flex items-center gap-2">
              <svg class="w-5 h-5 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              响应时间
            </h3>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between text-zinc-600 dark:text-zinc-400">
                <span>工作日</span>
                <span>24-48 小时</span>
              </div>
              <div class="flex justify-between text-zinc-600 dark:text-zinc-400">
                <span>周末</span>
                <span>48-72 小时</span>
              </div>
              <div class="pt-2 mt-2 border-t border-zinc-200 dark:border-zinc-800 text-zinc-500 dark:text-zinc-500">
                <p>我们努力尽快回复所有询问。</p>
              </div>
            </div>
          </div>

          <!-- FAQ Link -->
          <div class="mt-6 p-6 bg-gradient-to-br from-red-600/10 to-zinc-50 dark:from-red-900/10 dark:to-zinc-900 rounded-lg border border-red-200 dark:border-red-900">
            <h3 class="font-bold text-zinc-900 dark:text-white mb-2">
              寻找快速答案？
            </h3>
            <p class="text-zinc-600 dark:text-zinc-400 text-sm mb-4">
              查看我们的常见问题页面，找到常见问题的答案。
            </p>
            <a href="/faq" class="inline-flex items-center gap-2 text-red-600 hover:text-red-700 font-semibold text-sm uppercase tracking-wider">
              查看常见问题
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contactForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const submitBtnText = document.getElementById('submitBtnText') as HTMLElement;
    const submitBtnLoading = document.getElementById('submitBtnLoading') as HTMLElement;
    const formMessage = document.getElementById('formMessage') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Get form values
      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        subject: formData.get('subject'),
        message: formData.get('message')
      };

      // Set loading state
      submitBtn.disabled = true;
      submitBtnText.classList.add('hidden');
      submitBtnLoading.classList.remove('hidden');
      formMessage.classList.add('hidden');

      // Simulate API call (replace with actual API endpoint)
      try {
        await new Promise(resolve => setTimeout(resolve, 1500));

        // Success
        formMessage.textContent = '感谢您的留言！我们将尽快回复您。';
        formMessage.className = 'hidden p-4 rounded-lg text-center bg-green-50 dark:bg-green-900/20 text-green-600 dark:text-green-400 border border-green-200 dark:border-green-800';
        formMessage.classList.remove('hidden');
        form.reset();
      } catch (error) {
        formMessage.textContent = '抱歉，发送留言时出错。请重试。';
        formMessage.className = 'hidden p-4 rounded-lg text-center bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800';
        formMessage.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtnText.classList.remove('hidden');
        submitBtnLoading.classList.add('hidden');
      }
    });
  </script>
</Layout>
