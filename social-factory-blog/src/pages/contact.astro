---
import Layout from "../layouts/Layout.astro";
---

<Layout title="联系 - 社会工厂">
  <main class="min-h-screen">

    <!-- Hero Section -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="section-subtitle mb-4">Contact</p>
        <h1 class="text-display text-neutral-900 dark:text-white mb-8">
          联系<br/><span class="gradient-text">我们</span>
        </h1>
        <div class="w-16 h-1 bg-brand-red mx-auto mb-8"></div>
        <p class="text-subtitle text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
          请与我们联系。我们很乐意听到您的声音。
        </p>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-20 lg:py-32 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-12 gap-8 lg:gap-12">

          <!-- Contact Form -->
          <div class="col-span-12 lg:col-span-7">
            <div class="card p-8 lg:p-10">
              <h2 class="text-xl font-bold text-neutral-900 dark:text-white mb-6">给我们留言</h2>
              <form id="contactForm" class="space-y-6">
                <div class="grid grid-cols-12 gap-4">
                  <div class="col-span-12 sm:col-span-6">
                    <label for="name" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                      姓名 <span class="text-brand-red">*</span>
                    </label>
                    <input
                      type="text"
                      id="name"
                      name="name"
                      required
                      class="w-full px-4 py-3 bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
                      placeholder="您的姓名"
                    />
                  </div>
                  <div class="col-span-12 sm:col-span-6">
                    <label for="email" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                      邮箱 <span class="text-brand-red">*</span>
                    </label>
                    <input
                      type="email"
                      id="email"
                      name="email"
                      required
                      class="w-full px-4 py-3 bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
                      placeholder="your@email.com"
                    />
                  </div>
                </div>

                <div>
                  <label for="subject" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                    主题 <span class="text-brand-red">*</span>
                  </label>
                  <select
                    id="subject"
                    name="subject"
                    required
                    class="w-full px-4 py-3 bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none"
                  >
                    <option value="">请选择主题</option>
                    <option value="general">一般咨询</option>
                    <option value="support">技术支持</option>
                    <option value="feedback">反馈与建议</option>
                    <option value="partnership">合作机会</option>
                    <option value="report">报告问题</option>
                    <option value="other">其他</option>
                  </select>
                </div>

                <div>
                  <label for="message" class="block text-sm font-bold text-neutral-900 dark:text-white mb-2">
                    留言 <span class="text-brand-red">*</span>
                  </label>
                  <textarea
                    id="message"
                    name="message"
                    rows="6"
                    required
                    class="w-full px-4 py-3 bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition resize-none rounded-none"
                    placeholder="您的留言..."
                  ></textarea>
                </div>

                <button
                  type="submit"
                  id="submitBtn"
                  class="btn-primary w-full"
                >
                  <span id="submitBtnText">发送留言</span>
                  <span id="submitBtnLoading" class="hidden flex items-center justify-center gap-2">
                    <svg class="animate-spin h-5 w-5" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    发送中...
                  </span>
                </button>

                <div id="formMessage" class="hidden p-4 text-center"></div>
              </form>
            </div>
          </div>

          <!-- Contact Info -->
          <div class="col-span-12 lg:col-span-5 space-y-6">
            <div class="card p-8">
              <h2 class="text-xl font-bold text-neutral-900 dark:text-white mb-6">联系方式</h2>

              <div class="space-y-6">
                <!-- Email -->
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-brand-red/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-neutral-900 dark:text-white mb-1">电子邮件</h3>
                    <a href="mailto:contact@socialfactory.com" class="text-neutral-600 dark:text-neutral-400 hover:text-brand-red transition">
                      contact@socialfactory.com
                    </a>
                    <p class="text-sm text-neutral-500 mt-1">我们将在 24-48 小时内回复</p>
                  </div>
                </div>

                <!-- Location -->
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-brand-red/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-neutral-900 dark:text-white mb-1">所在地</h3>
                    <p class="text-neutral-600 dark:text-neutral-400">
                      远程优先<br/>
                      全球运营
                    </p>
                  </div>
                </div>

                <!-- Social -->
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 bg-brand-red/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-neutral-900 dark:text-white mb-2">关注我们</h3>
                    <div class="flex gap-4">
                      <a href="#" class="text-neutral-600 dark:text-neutral-400 hover:text-brand-red transition text-sm font-bold uppercase tracking-wider">Facebook</a>
                      <a href="#" class="text-neutral-600 dark:text-neutral-400 hover:text-brand-red transition text-sm font-bold uppercase tracking-wider">Twitter</a>
                      <a href="#" class="text-neutral-600 dark:text-neutral-400 hover:text-brand-red transition text-sm font-bold uppercase tracking-wider">Instagram</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Business Hours -->
            <div class="card p-8">
              <h3 class="font-bold text-neutral-900 dark:text-white mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                响应时间
              </h3>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between text-neutral-600 dark:text-neutral-400">
                  <span>工作日</span>
                  <span>24-48 小时</span>
                </div>
                <div class="flex justify-between text-neutral-600 dark:text-neutral-400">
                  <span>周末</span>
                  <span>48-72 小时</span>
                </div>
                <div class="pt-2 mt-2 border-t border-neutral-200 dark:border-neutral-700 text-neutral-500">
                  <p>我们努力尽快回复所有询问。</p>
                </div>
              </div>
            </div>

            <!-- FAQ Link -->
            <div class="card p-8 bg-gradient-to-br from-brand-red/5 to-neutral-50 dark:from-brand-red/10 dark:to-neutral-900 border border-brand-red/20">
              <h3 class="font-bold text-neutral-900 dark:text-white mb-2">寻找快速答案？</h3>
              <p class="text-neutral-600 dark:text-neutral-400 text-sm mb-4">
                查看我们的常见问题页面，找到常见问题的答案。
              </p>
              <a href="/faq" class="inline-flex items-center gap-2 text-brand-red hover:text-brand-red-dark font-bold text-sm uppercase tracking-wider">
                查看常见问题
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>

  <script>
    const form = document.getElementById('contactForm') as HTMLFormElement;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
    const submitBtnText = document.getElementById('submitBtnText') as HTMLElement;
    const submitBtnLoading = document.getElementById('submitBtnLoading') as HTMLElement;
    const formMessage = document.getElementById('formMessage') as HTMLElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        email: formData.get('email'),
        subject: formData.get('subject'),
        message: formData.get('message')
      };

      submitBtn.disabled = true;
      submitBtnText.classList.add('hidden');
      submitBtnLoading.classList.remove('hidden');
      formMessage.classList.add('hidden');

      try {
        await new Promise(resolve => setTimeout(resolve, 1500));

        formMessage.textContent = '感谢您的留言！我们将尽快回复您。';
        formMessage.className = 'p-4 text-center bg-green-500/10 text-green-600 dark:text-green-400 border border-green-500/20';
        formMessage.classList.remove('hidden');
        form.reset();
      } catch (error) {
        formMessage.textContent = '抱歉，发送留言时出错。请重试。';
        formMessage.className = 'p-4 text-center bg-red-500/10 text-red-600 dark:text-red-400 border border-red-500/20';
        formMessage.classList.remove('hidden');
      } finally {
        submitBtn.disabled = false;
        submitBtnText.classList.remove('hidden');
        submitBtnLoading.classList.add('hidden');
      }
    });
  </script>
</Layout>
