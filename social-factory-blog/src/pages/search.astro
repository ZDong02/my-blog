---
import Layout from '../layouts/Layout.astro';

const title = '搜索';
const description = '搜索文章';
---

<Layout title={title} description={description}>
  <main class="min-h-screen">

    <!-- Hero Section -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="section-subtitle mb-4">Search</p>
        <h1 class="text-display text-neutral-900 dark:text-white mb-8">
          搜索<br/><span class="gradient-text">文章</span>
        </h1>
        <div class="w-16 h-1 bg-brand-red mx-auto mb-8"></div>

        <!-- Search Box -->
        <div class="max-w-2xl mx-auto">
          <div class="relative">
            <input
              type="text"
              id="searchInput"
              placeholder="输入搜索词..."
              class="w-full px-6 py-4 pr-16 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white text-lg focus:outline-none focus:border-brand-red transition rounded-none"
            />
            <button
              id="searchBtn"
              class="absolute right-2 top-1/2 -translate-y-1/2 p-3 bg-brand-red hover:bg-brand-red-dark text-white transition"
            >
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </button>
          </div>

          <!-- Category Filter -->
          <div class="mt-4 flex items-center justify-center gap-4">
            <label class="text-sm font-bold text-neutral-600 dark:text-neutral-400">分类:</label>
            <select id="categoryFilter" class="px-4 py-2 bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white focus:outline-none focus:border-brand-red transition rounded-none">
              <option value="">全部分类</option>
            </select>
          </div>
        </div>
      </div>
    </section>

    <!-- Results Section -->
    <section class="py-20 lg:py-32 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Initial state -->
        <div id="initialState" class="text-center py-20">
          <div class="w-32 h-32 bg-neutral-800 dark:bg-neutral-200 mx-auto mb-8 flex items-center justify-center">
            <svg class="h-16 w-16 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-white dark:text-neutral-900 mb-4">输入搜索词以查找文章</h3>
          <p class="text-neutral-500">输入关键词并按回车或点击搜索按钮</p>
        </div>

        <!-- Loading state -->
        <div id="loading" class="hidden text-center py-20">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">正在搜索...</p>
        </div>

        <!-- No results -->
        <div id="noResults" class="hidden text-center py-20">
          <div class="w-32 h-32 bg-neutral-800 dark:bg-neutral-200 mx-auto mb-8 flex items-center justify-center">
            <svg class="h-16 w-16 text-neutral-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-white dark:text-neutral-900 mb-4">未找到结果</h3>
          <p class="text-neutral-500 mb-8">未找到关于 "<span id="searchTerm" class="text-brand-red"></span>" 的结果</p>
          <p class="text-sm text-neutral-600">请尝试其他关键词</p>
        </div>

        <!-- Search Results -->
        <div id="searchResults" class="hidden space-y-6"></div>

        <!-- Pagination -->
        <div id="pagination" class="hidden mt-12 flex items-center justify-center gap-4">
          <button id="prevBtn" class="btn-secondary px-6 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
            上一页
          </button>
          <span id="pageInfo" class="text-sm font-bold text-neutral-500 px-4">第 1 页</span>
          <button id="nextBtn" class="btn-secondary px-6 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
            下一页
          </button>
        </div>
      </div>
    </section>

  </main>

  <script>
    import { apiClient } from '../lib/api.js';

    let currentPage = 1;
    let totalPages = 1;
    let currentSearchTerm = '';
    let currentCategoryId = '';
    let debounceTimer = null;
    let allCategories = [];

    const loadCategories = async () => {
      try {
        const response = await apiClient.getCategories();
        if (response.success && response.data) {
          allCategories = response.data;
          renderCategoryFilter();
        }
      } catch (error) {
        console.error('Failed to load categories:', error);
      }
    };

    const renderCategoryFilter = () => {
      const select = document.getElementById('categoryFilter');
      if (!select) return;

      let options = '<option value="">全部分类</option>';
      allCategories.forEach(cat => {
        options += `<option value="${cat.id}">${cat.name}</option>`;
      });
      select.innerHTML = options;
    };

    const performSearch = async (term, page = 1) => {
      if (!term || term.trim().length === 0) {
        showInitialState();
        return;
      }

      currentSearchTerm = term.trim();
      const loading = document.getElementById('loading');
      const initialState = document.getElementById('initialState');
      const noResults = document.getElementById('noResults');
      const searchResults = document.getElementById('searchResults');
      const pagination = document.getElementById('pagination');

      initialState.classList.add('hidden');
      noResults.classList.add('hidden');
      searchResults.classList.add('hidden');
      pagination.classList.add('hidden');
      loading.classList.remove('hidden');

      try {
        const response = await apiClient.searchPosts(currentSearchTerm, currentCategoryId || null, page, 10);

        if (response.success && response.data) {
          const { content, total, size, number } = response.data;
          currentPage = number;
          totalPages = Math.ceil(total / size);

          loading.classList.add('hidden');

          if (!content || content.length === 0) {
            noResults.classList.remove('hidden');
            document.getElementById('searchTerm').textContent = currentSearchTerm;
            return;
          }

          searchResults.classList.remove('hidden');
          pagination.classList.remove('hidden');

          renderResults(content);
          document.getElementById('pageInfo').textContent = `第 ${currentPage} 页，共 ${totalPages} 页 - 共 ${total} 条结果`;
          document.getElementById('prevBtn').disabled = currentPage <= 1;
          document.getElementById('nextBtn').disabled = currentPage >= totalPages;
        }
      } catch (error) {
        console.error('Search failed:', error);
        loading.classList.add('hidden');
      }
    };

    const escapeRegex = (str) => str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    const renderResults = (results) => {
      const container = document.getElementById('searchResults');
      let html = '';

      results.forEach(post => {
        const searchTerms = currentSearchTerm.split(' ').filter(t => t.length > 0);
        let title = post.title;
        let summary = post.summary || post.content?.substring(0, 200) || '';

        searchTerms.forEach(term => {
          const regex = new RegExp(`(${escapeRegex(term)})`, 'gi');
          title = title.replace(regex, '<mark class="bg-brand-red/30 text-brand-red px-1">$1</mark>');
          summary = summary.replace(regex, '<mark class="bg-brand-red/30 text-brand-red px-1">$1</mark>');
        });

        html += `
          <a href="/blog/${post.id}" class="group block card p-6 hover:border-brand-red transition cursor-pointer">
            <div class="flex gap-4">
              ${post.featuredImage ? `
                <div class="w-32 h-24 flex-shrink-0 overflow-hidden">
                  <img src="${post.featuredImage}" alt="${post.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
                </div>
              ` : ''}
              <div class="flex-1 min-w-0">
                <span class="badge-red mb-2 inline-block">${post.category?.name || '未分类'}</span>
                <h3 class="text-xl font-black text-neutral-900 dark:text-white line-clamp-1 group-hover:text-brand-red transition mb-2">${title}</h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2">${summary}${summary.length >= 200 ? '...' : ''}</p>
                <div class="flex items-center gap-4 mt-3 text-xs text-neutral-500">
                  <span>${new Date(post.createdAt).toLocaleDateString()}</span>
                  <span class="flex items-center gap-1">
                    <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                    </svg>
                    ${post.likeCount || 0}
                  </span>
                  <span class="flex items-center gap-1">
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                    </svg>
                    ${post.commentCount || 0}
                  </span>
                </div>
              </div>
            </div>
          </a>
        `;
      });

      container.innerHTML = html;
    };

    const showInitialState = () => {
      document.getElementById('initialState').classList.remove('hidden');
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('searchResults').classList.add('hidden');
      document.getElementById('noResults').classList.add('hidden');
      document.getElementById('pagination').classList.add('hidden');
    };

    document.getElementById('categoryFilter')?.addEventListener('change', (e) => {
      currentCategoryId = e.target.value;
      performSearch(currentSearchTerm, 1);
    });

    document.getElementById('searchInput')?.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        performSearch(e.target.value, 1);
      }, 500);
    });

    document.getElementById('searchBtn')?.addEventListener('click', () => {
      const term = document.getElementById('searchInput').value;
      performSearch(term, 1);
    });

    document.getElementById('searchInput')?.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        const term = e.target.value;
        performSearch(term, 1);
      }
    });

    document.getElementById('prevBtn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        performSearch(currentSearchTerm, currentPage - 1);
      }
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        performSearch(currentSearchTerm, currentPage + 1);
      }
    });

    const urlParams = new URLSearchParams(window.location.search);
    const query = urlParams.get('q');
    if (query) {
      document.getElementById('searchInput').value = query;
      performSearch(query, 1);
    }

    loadCategories();
  </script>
</Layout>
