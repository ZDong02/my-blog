---
import Layout from '../layouts/Layout.astro';
---

<Layout title="音乐 - 社会工厂" description="我喜欢的音乐">
  <div class="pt-32 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-3 mb-6">
          <svg class="h-8 w-8 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
          </svg>
          <span class="text-sm font-bold uppercase tracking-widest text-neutral-500">My Music</span>
        </div>
        <h1 class="text-headline text-neutral-900 dark:text-white mb-4">我的音乐收藏</h1>
        <p class="text-body text-neutral-500 max-w-lg mx-auto">
          记录那些打动我的旋律，有些歌一听前奏就知道是对的
        </p>
      </div>

      <!-- Music Player Embed -->
      <div class="card p-0 mb-12 overflow-hidden">
        <div class="aspect-video relative">
          <!-- YouTube Player -->
          <iframe
            id="playerIframe"
            style="border-radius: 12px;"
            src=""
            width="100%"
            height="100%"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
            class="absolute inset-0 w-full h-full"
          ></iframe>
          <!-- HTML5 Audio Player -->
          <audio
            id="audioPlayer"
            controls
            autoplay
            class="absolute inset-0 w-full h-full hidden"
          ></audio>
          <!-- Audio placeholder when no source -->
          <div id="audioPlaceholder" class="absolute inset-0 flex items-center justify-center bg-neutral-100 dark:bg-neutral-800 hidden">
            <p class="text-neutral-500 text-sm">加载中...</p>
          </div>
        </div>
      </div>

      <!-- Favorite Songs List -->
      <div class="card p-0">
        <div class="px-6 py-5 border-b border-neutral-200 dark:border-neutral-700">
          <h2 class="text-lg font-bold text-neutral-900 dark:text-white flex items-center gap-3">
            <svg class="h-5 w-5 text-brand-red" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            心水单曲
          </h2>
        </div>

        <!-- Loading State -->
        <div id="loadingState" class="p-6">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="skeleton-item h-20 rounded-lg"></div>
            <div class="skeleton-item h-20 rounded-lg"></div>
            <div class="skeleton-item h-20 rounded-lg"></div>
            <div class="skeleton-item h-20 rounded-lg"></div>
          </div>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden p-12 text-center">
          <svg class="h-12 w-12 text-neutral-300 dark:text-neutral-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/>
          </svg>
          <p class="text-neutral-500">暂无音乐</p>
        </div>

        <!-- Songs Grid -->
        <div id="songsList" class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-neutral-200 dark:divide-neutral-700">
          <!-- Songs will be dynamically loaded -->
        </div>
      </div>

      <!-- Music Platforms -->
      <div class="mt-12 text-center">
        <p class="text-sm text-neutral-500 mb-4">在以下平台找到我</p>
        <div class="flex items-center justify-center gap-6">
          <a href="#" class="w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-500 hover:text-brand-red hover:bg-brand-red/10 transition">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
            </svg>
          </a>
          <a href="#" class="w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-500 hover:text-brand-red hover:bg-brand-red/10 transition">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 14.5c-2.49 0-4.5-2.01-4.5-4.5S9.51 7.5 12 7.5s4.5 2.01 4.5 4.5-2.01 4.5-4.5 4.5zm0-5.5c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1z"/>
            </svg>
          </a>
          <a href="#" class="w-12 h-12 rounded-full bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-500 hover:text-brand-red hover:bg-brand-red/10 transition">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.376 0 0 5.376 0 12c0 4.236 2.208 7.92 5.472 9.72L3.72 8.976C2.784 7.92 2.16 6.624 2.16 5.232 2.16 2.64 4.176.648 6.768.648c1.584 0 3.024.744 3.936 1.896C11.544 1.392 12.984.648 14.568.648c2.592 0 4.608 1.992 4.608 4.584 0 1.392-.624 2.688-1.56 3.744L14.568 21.72c3.264-1.8 5.472-5.484 5.472-9.72C21.12 5.376 16.128.384 12 0z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .skeleton-item {
    background: linear-gradient(90deg, var(--color-neutral-200) 25%, var(--color-neutral-100) 50%, var(--color-neutral-200) 75%);
    background-size: 200% 100%;
    animation: skeleton-loading 1.5s infinite;
  }

  :global(.dark) .skeleton-item {
    background: linear-gradient(90deg, var(--color-neutral-700) 25%, var(--color-neutral-600) 50%, var(--color-neutral-700) 75%);
    background-size: 200% 100%;
  }

  @keyframes skeleton-loading {
    0% { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }
</style>

<script>
  import { apiClient } from '../lib/api.js';

  // Gradient colors for music item placeholders
  const gradientColors = [
    { from: 'from-brand-red/20', to: 'to-purple-500/20', text: 'text-brand-red' },
    { from: 'from-blue-500/20', to: 'to-cyan-500/20', text: 'text-blue-500' },
    { from: 'from-pink-500/20', to: 'to-rose-500/20', text: 'text-pink-500' },
    { from: 'from-yellow-500/20', to: 'to-orange-500/20', text: 'text-yellow-500' },
    { from: 'from-green-500/20', to: 'to-emerald-500/20', text: 'text-green-500' },
    { from: 'from-neutral-500/20', to: 'to-neutral-600/20', text: 'text-neutral-500' },
  ];

  function getGradientStyle(index) {
    return gradientColors[index % gradientColors.length];
  }

  function getYouTubeId(youtubeId) {
    // Handle full YouTube URLs
    if (youtubeId.includes('youtube.com') || youtubeId.includes('youtu.be')) {
      const match = youtubeId.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&?/]+)/);
      return match ? match[1] : youtubeId;
    }
    return youtubeId;
  }

  function updatePlayer(music) {
    const playerIframe = document.getElementById('playerIframe');
    const audioPlayer = document.getElementById('audioPlayer');
    const audioPlaceholder = document.getElementById('audioPlaceholder');

    if (!music) return;

    // If music has audioUrl, use HTML5 audio player
    if (music.audioUrl) {
      playerIframe.classList.add('hidden');
      audioPlaceholder.classList.remove('hidden');
      audioPlayer.classList.remove('hidden');
      audioPlayer.src = music.audioUrl;
      audioPlayer.play().catch(() => {});
      updateURL('');
    } else {
      // Use YouTube embed
      audioPlayer.classList.add('hidden');
      audioPlayer.pause();
      audioPlayer.src = '';
      audioPlaceholder.classList.add('hidden');
      playerIframe.classList.remove('hidden');
      if (music.youtubeId) {
        const cleanId = getYouTubeId(music.youtubeId);
        playerIframe.src = `https://www.youtube.com/embed/${cleanId}`;
        updateURL(music.youtubeId);
      }
    }
  }

  function updateURL(youtubeId) {
    const url = new URL(window.location.href);
    if (youtubeId) {
      url.searchParams.set('play', youtubeId);
    } else {
      url.searchParams.delete('play');
    }
    window.history.pushState({}, '', url);
  }

  function renderMusicItem(music, index) {
    const gradient = getGradientStyle(index);
    const firstLetter = music.title ? music.title.charAt(0).toUpperCase() : '?';
    const coverImage = music.coverImage
      ? `<img src="${music.coverImage}" alt="${music.title}" class="w-full h-full object-cover" />`
      : `<span class="text-2xl font-bold ${gradient.text}">${firstLetter}</span>`;

    const hasAudio = !!music.audioUrl;
    const audioIcon = hasAudio
      ? `<span class="ml-1 px-1.5 py-0.5 text-[10px] font-bold bg-green-500/20 text-green-600 rounded">MP3</span>`
      : '';

    return `
      <div class="song-item flex items-center gap-4 p-4 hover:bg-neutral-50 dark:hover:bg-neutral-800/50 transition cursor-pointer group" data-music='${JSON.stringify(music).replace(/'/g, "\\'")}'>
        <div class="relative flex-shrink-0">
          <div class="w-14 h-14 rounded-lg bg-gradient-to-br ${gradient.from} ${gradient.to} flex items-center justify-center overflow-hidden">
            ${coverImage}
          </div>
          <div class="absolute inset-0 bg-black/40 rounded-lg opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
            ${hasAudio
              ? `<svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`
              : `<svg class="h-6 w-6 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>`
            }
          </div>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="text-sm font-bold text-neutral-900 dark:text-white truncate group-hover:text-brand-red transition flex items-center gap-1">${music.title}${audioIcon}</h3>
          <p class="text-xs text-neutral-500 truncate">${music.artist || '未知艺术家'}</p>
        </div>
        <div class="hidden sm:flex items-center gap-2 text-xs text-neutral-400">
          ${music.category ? `<span class="px-2 py-1 bg-neutral-100 dark:bg-neutral-800 rounded">${music.category}</span>` : ''}
        </div>
      </div>
    `;
  }

  async function loadMusic() {
    const songsList = document.getElementById('songsList');
    const loadingState = document.getElementById('loadingState');
    const emptyState = document.getElementById('emptyState');

    try {
      const response = await apiClient.getMusicList();

      loadingState.classList.add('hidden');

      if (response.success && response.data && response.data.length > 0) {
        allMusic = response.data;
        const musicList = allMusic;

        // Check for play URL parameter
        const urlParams = new URLSearchParams(window.location.search);
        const playParam = urlParams.get('play');

        // Render music items
        let html = '';
        musicList.forEach((music, index) => {
          html += renderMusicItem(music, index);
        });
        songsList.innerHTML = html;

        // Set initial player - use play param or first item
        const initialMusic = playParam
          ? musicList.find(m => m.youtubeId === playParam)
          : (musicList.length > 0 ? musicList[0] : null);
        if (initialMusic) {
          updatePlayer(initialMusic);
        }

        // Add click handlers
        document.querySelectorAll('.song-item').forEach(item => {
          item.addEventListener('click', () => {
            const music = JSON.parse(item.dataset.music);
            updatePlayer(music);
          });
        });
      } else {
        emptyState.classList.remove('hidden');
      }
    } catch (error) {
      console.error('Failed to load music:', error);
      loadingState.classList.add('hidden');
      emptyState.classList.remove('hidden');
    }
  }

  let allMusic = [];

  // Handle browser back/forward navigation
  window.addEventListener('popstate', () => {
    const urlParams = new URLSearchParams(window.location.search);
    const playParam = urlParams.get('play');
    if (playParam) {
      // Find the music with this youtubeId and play it
      const music = allMusic.find(m => m.youtubeId === playParam);
      if (music) {
        updatePlayer(music);
      }
    } else {
      // Just refresh the player for the current state
      const currentAudio = document.getElementById('audioPlayer');
      if (!currentAudio.src && allMusic.length > 0) {
        updatePlayer(allMusic[0]);
      }
    }
  });

  // Load music on page load
  document.addEventListener('DOMContentLoaded', loadMusic);
</script>
