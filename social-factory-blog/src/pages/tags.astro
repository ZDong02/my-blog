---
import Layout from '../layouts/Layout.astro';
---

<Layout title="标签 - 社会工厂">
  <main class="min-h-screen">

    <!-- Hero Section -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="section-subtitle mb-4">Tags</p>
        <h1 class="text-display text-neutral-900 dark:text-white mb-8">
          标签<br/><span class="gradient-text">总览</span>
        </h1>
        <div class="w-16 h-1 bg-brand-red mx-auto mb-8"></div>
        <p class="text-subtitle text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
          浏览所有标签，查找感兴趣的内容
        </p>
      </div>
    </section>

    <!-- Tags Section -->
    <section class="py-20 lg:py-32 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Loading State -->
        <div id="loading" class="text-center py-20">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">加载中...</p>
        </div>

        <!-- Tags Grid -->
        <div id="tagsGrid" class="hidden">
          <div class="grid grid-cols-12 gap-4" id="tagsContainer">
            <!-- Tags will be loaded here -->
          </div>
        </div>

        <!-- Empty State -->
        <div id="noTags" class="hidden text-center py-20">
          <div class="w-32 h-32 bg-neutral-200 dark:bg-neutral-800 mx-auto mb-8 flex items-center justify-center">
            <svg class="w-16 h-16 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-neutral-900 dark:text-white mb-4">暂无标签</h3>
          <p class="text-neutral-500">标签将在文章发布后自动生成</p>
        </div>

        <!-- Hot Tags Section -->
        <div id="hotTagsSection" class="hidden mt-16">
          <div class="border-t-2 border-neutral-800 dark:border-neutral-200 pt-12 mb-8">
            <h2 class="text-xl font-bold text-white dark:text-neutral-900 mb-6">热门标签</h2>
          </div>
          <div id="hotTags" class="flex flex-wrap gap-3">
            <!-- Hot tags will be loaded here -->
          </div>
        </div>

      </div>
    </section>

  </main>

  <script>
    import { apiClient } from '../lib/api.js';

    const renderTags = (tags: any[]) => {
      const container = document.getElementById('tagsContainer');
      const tagsGrid = document.getElementById('tagsGrid');
      const loading = document.getElementById('loading');
      if (!container) return;

      let html = '';
      tags.forEach(tag => {
        const postCount = tag.postCount || 0;
        const sizeClass = postCount > 10 ? 'text-lg font-semibold' : postCount > 5 ? 'text-base' : 'text-sm';
        const bgClass = postCount > 10 ? 'bg-brand-red/20 border-brand-red/30' :
                        postCount > 5 ? 'bg-orange-500/20 border-orange-500/30' :
                        'bg-neutral-800 border-neutral-700';

        html += `
          <div class="col-span-6 sm:col-span-4 lg:col-span-3">
            <a href="/tag/${tag.slug}" class="group block p-6 border ${bgClass} hover:border-brand-red transition card">
              <div class="flex items-center justify-between mb-2">
                <span class="text-2xl font-black text-neutral-100 dark:text-neutral-900 group-hover:text-brand-red transition">#</span>
                <span class="text-xs text-neutral-500">${postCount} 篇</span>
              </div>
              <div class="font-bold text-white dark:text-neutral-900 ${sizeClass}">${tag.name}</div>
            </a>
          </div>
        `;
      });

      container.innerHTML = html;
      if (loading) loading.classList.add('hidden');
      if (tagsGrid) tagsGrid.classList.remove('hidden');
    };

    const renderHotTags = (tags: any[]) => {
      const container = document.getElementById('hotTags');
      const section = document.getElementById('hotTagsSection');
      if (!container) return;

      let html = '';
      tags.forEach((tag, index) => {
        const postCount = tag.postCount || 0;
        html += `
          <a href="/tag/${tag.slug}" class="group inline-flex items-center gap-2 px-5 py-2.5 bg-neutral-800 dark:bg-neutral-200 border border-neutral-700 dark:border-neutral-300 hover:border-brand-red dark:hover:border-brand-red transition">
            <span class="text-xs font-black text-brand-red">#${index + 1}</span>
            <span class="font-bold text-white dark:text-neutral-900 group-hover:text-brand-red transition">${tag.name}</span>
            <span class="text-xs text-neutral-500">(${postCount})</span>
          </a>
        `;
      });

      container.innerHTML = html;
      if (section) section.classList.remove('hidden');
    };

    const loadTags = async () => {
      const loading = document.getElementById('loading');
      const tagsGrid = document.getElementById('tagsGrid');
      const noTags = document.getElementById('noTags');

      try {
        const [tagsResponse, hotTagsResponse] = await Promise.all([
          apiClient.getTags(),
          apiClient.getHotTags(15)
        ]);

        if (loading) loading.classList.add('hidden');

        if (tagsResponse.success && tagsResponse.data && tagsResponse.data.length > 0) {
          renderTags(tagsResponse.data);
        } else {
          if (tagsGrid) tagsGrid.classList.add('hidden');
          if (noTags) noTags.classList.remove('hidden');
        }

        if (hotTagsResponse.success && hotTagsResponse.data && hotTagsResponse.data.length > 0) {
          renderHotTags(hotTagsResponse.data);
        }
      } catch (error) {
        console.error('Failed to load tags:', error);
        if (loading) loading.classList.add('hidden');
        if (tagsGrid) tagsGrid.classList.add('hidden');
        if (noTags) noTags.classList.remove('hidden');
      }
    };

    document.addEventListener('DOMContentLoaded', loadTags);
  </script>
</Layout>
