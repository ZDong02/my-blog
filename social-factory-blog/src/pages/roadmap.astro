---
import Layout from "../layouts/Layout.astro";
---

<Layout title="发展路线 - Social Factory">
  <div class="min-h-screen bg-white dark:bg-zinc-950 pt-24 pb-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-8 py-16">
      <!-- Hero Section -->
      <div class="text-center mb-20">
        <h1 class="text-5xl md:text-7xl font-black text-zinc-900 dark:text-white mb-6 tracking-tight">
          发展路线
        </h1>
        <div class="w-24 h-1 bg-red-600 mx-auto mb-8"></div>
        <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 max-w-3xl mx-auto leading-relaxed">
          我们构建更富同情心的数字世界的历程。
          以下是我们正在工作和即将推出的内容。
        </p>
      </div>

      <!-- Timeline -->
      <div class="relative">
        <!-- Center Line -->
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-zinc-200 dark:bg-zinc-800 md:-ml-0.5"></div>

        <!-- Q1 2026 - Completed -->
        <div class="relative mb-12 md:mb-16">
          <div class="md:flex items-center justify-between group">
            <!-- Left Content (Desktop) -->
            <div class="md:w-1/2 md:pr-12 md:text-right">
              <div class="bg-zinc-50 dark:bg-zinc-900 p-6 rounded-lg border border-zinc-200 dark:border-zinc-800 ml-12 md:ml-0">
                <div class="flex items-center justify-between md:justify-end gap-3 mb-3">
                  <span class="text-xs font-bold uppercase tracking-widest text-green-600">已完成</span>
                  <span class="text-xs text-zinc-500">2026 年第一季度</span>
                </div>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">基础与发布</h3>
                <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="text-green-500">✓</span>
                    <span>核心平台架构</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="text-green-500">✓</span>
                    <span>用户认证系统</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="text-green-500">✓</span>
                    <span>博客与内容管理</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="text-green-500">✓</span>
                    <span>深色模式支持</span>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Center Dot -->
            <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-green-500 rounded-full -ml-2 md:-ml-2 border-4 border-white dark:border-zinc-950 shadow"></div>

            <!-- Right Content (Desktop) -->
            <div class="md:w-1/2 md:pl-12 ml-12 md:ml-0"></div>
          </div>
        </div>

        <!-- Q2 2026 - In Progress -->
        <div class="relative mb-12 md:mb-16">
          <div class="md:flex items-center justify-between group">
            <!-- Left Content (Desktop) -->
            <div class="md:w-1/2 md:pr-12 ml-12 md:ml-0"></div>

            <!-- Center Dot -->
            <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-red-500 rounded-full -ml-2 md:-ml-2 border-4 border-white dark:border-zinc-950 shadow animate-pulse"></div>

            <!-- Right Content (Desktop) -->
            <div class="md:w-1/2 md:pl-12">
              <div class="bg-zinc-50 dark:bg-zinc-900 p-6 rounded-lg border border-zinc-200 dark:border-zinc-800 ml-12 md:ml-0">
                <div class="flex items-center justify-between md:justify-start gap-3 mb-3">
                  <span class="text-xs font-bold uppercase tracking-widest text-red-600">进行中</span>
                  <span class="text-xs text-zinc-500">2026 年第二季度</span>
                </div>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">社区功能</h3>
                <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
                  <li class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
                    <span>评论系统增强</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
                    <span>用户资料与自定义</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-green-500">✓</span>
                    <span>点赞与收藏功能</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-zinc-300 dark:bg-zinc-700 rounded-full"></span>
                    <span>关注系统</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Q3 2026 - Planned -->
        <div class="relative mb-12 md:mb-16">
          <div class="md:flex items-center justify-between group">
            <!-- Left Content (Desktop) -->
            <div class="md:w-1/2 md:pr-12 md:text-right">
              <div class="bg-zinc-50 dark:bg-zinc-900 p-6 rounded-lg border border-zinc-200 dark:border-zinc-800 ml-12 md:ml-0">
                <div class="flex items-center justify-between md:justify-end gap-3 mb-3">
                  <span class="text-xs font-bold uppercase tracking-widest text-zinc-500">计划中</span>
                  <span class="text-xs text-zinc-500">2026 年第三季度</span>
                </div>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">高级功能</h3>
                <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="w-2 h-2 bg-zinc-400 dark:bg-zinc-600 rounded-full"></span>
                    <span>实时通知</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="w-2 h-2 bg-zinc-400 dark:bg-zinc-600 rounded-full"></span>
                    <span>内容推荐引擎</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="w-2 h-2 bg-zinc-400 dark:bg-zinc-600 rounded-full"></span>
                    <span>高级搜索与过滤</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="w-2 h-2 bg-zinc-400 dark:bg-zinc-600 rounded-full"></span>
                    <span>移动应用 (React Native)</span>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Center Dot -->
            <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-zinc-400 dark:bg-zinc-600 rounded-full -ml-2 md:-ml-2 border-4 border-white dark:border-zinc-950"></div>

            <!-- Right Content (Desktop) -->
            <div class="md:w-1/2 md:pl-12 ml-12 md:ml-0"></div>
          </div>
        </div>

        <!-- Q4 2026 - Planned -->
        <div class="relative mb-12 md:mb-16">
          <div class="md:flex items-center justify-between group">
            <!-- Left Content (Desktop) -->
            <div class="md:w-1/2 md:pr-12 ml-12 md:ml-0"></div>

            <!-- Center Dot -->
            <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-zinc-400 dark:bg-zinc-600 rounded-full -ml-2 md:-ml-2 border-4 border-white dark:border-zinc-950"></div>

            <!-- Right Content (Desktop) -->
            <div class="md:w-1/2 md:pl-12">
              <div class="bg-zinc-50 dark:bg-zinc-900 p-6 rounded-lg border border-zinc-200 dark:border-zinc-800 ml-12 md:ml-0">
                <div class="flex items-center justify-between md:justify-start gap-3 mb-3">
                  <span class="text-xs font-bold uppercase tracking-widest text-zinc-500">计划中</span>
                  <span class="text-xs text-zinc-500">2026 年第四季度</span>
                </div>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">规模与影响</h3>
                <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
                  <li class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-zinc-400 dark:bg-zinc-600 rounded-full"></span>
                    <span>多语言支持</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-zinc-400 dark:bg-zinc-600 rounded-full"></span>
                    <span>合作伙伴集成</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-zinc-400 dark:bg-zinc-600 rounded-full"></span>
                    <span>分析仪表盘</span>
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="w-2 h-2 bg-zinc-400 dark:bg-zinc-600 rounded-full"></span>
                    <span>社区管理工具</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Future - Vision -->
        <div class="relative">
          <div class="md:flex items-center justify-between group">
            <!-- Left Content (Desktop) -->
            <div class="md:w-1/2 md:pr-12 md:text-right">
              <div class="bg-gradient-to-br from-red-600/10 to-zinc-50 dark:from-red-900/10 dark:to-zinc-900 p-6 rounded-lg border border-red-200 dark:border-red-900 ml-12 md:ml-0">
                <div class="flex items-center justify-between md:justify-end gap-3 mb-3">
                  <span class="text-xs font-bold uppercase tracking-widest text-red-600">愿景</span>
                  <span class="text-xs text-zinc-500">2027+</span>
                </div>
                <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">长期目标</h3>
                <ul class="space-y-2 text-sm text-zinc-600 dark:text-zinc-400">
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="text-red-500">✦</span>
                    <span>全球社区网络</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="text-red-500">✦</span>
                    <span>非营利组织合作</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="text-red-500">✦</span>
                    <span>影响力测量与报告</span>
                  </li>
                  <li class="flex items-center md:justify-end gap-2">
                    <span class="text-red-500">✦</span>
                    <span>开源计划</span>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Center Dot -->
            <div class="absolute left-4 md:left-1/2 w-4 h-4 bg-red-600 rounded-full -ml-2 md:-ml-2 border-4 border-white dark:border-zinc-950 shadow-lg"></div>

            <!-- Right Content (Desktop) -->
            <div class="md:w-1/2 md:pl-12 ml-12 md:ml-0"></div>
          </div>
        </div>
      </div>

      <!-- CTA Section -->
      <div class="text-center mt-20 pt-12 border-t border-zinc-200 dark:border-zinc-800">
        <h2 class="text-2xl md:text-3xl font-bold text-zinc-900 dark:text-white mb-4">
          塑造我们的未来
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 mb-8 max-w-2xl mx-auto">
          有建议想看到的功能？我们很乐意听取您的意见。
        </p>
        <a href="/contact" class="inline-block px-8 py-3 bg-red-600 text-white uppercase tracking-widest hover:bg-red-700 transition font-semibold">
          分享您的想法
        </a>
      </div>
    </div>
  </div>
</Layout>
