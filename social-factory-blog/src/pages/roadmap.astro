---
import Layout from "../layouts/Layout.astro";
---

<Layout title="发展路线 - 社会工厂">
  <main class="min-h-screen">

    <!-- Hero Section -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="section-subtitle mb-4">Roadmap</p>
        <h1 class="text-display text-neutral-900 dark:text-white mb-8">
          发展<br/><span class="gradient-text">路线</span>
        </h1>
        <div class="w-16 h-1 bg-brand-red mx-auto mb-8"></div>
        <p class="text-subtitle text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
          我们构建更富同情心的数字世界的历程。以下是我们正在工作和即将推出的内容。
        </p>
      </div>
    </section>

    <!-- Timeline Section -->
    <section class="py-20 lg:py-32 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Q1 2026 - Completed -->
        <div class="grid grid-cols-12 gap-8 items-center mb-20">
          <div class="col-span-12 lg:col-span-5 lg:text-right">
            <div class="card p-8 lg:p-10">
              <div class="flex items-center justify-between lg:justify-end gap-3 mb-6">
                <span class="badge-green">已完成</span>
                <span class="text-xs font-bold uppercase tracking-widest text-neutral-500">2026 Q1</span>
              </div>
              <h3 class="text-title text-neutral-900 dark:text-white mb-6">基础与发布</h3>
              <ul class="space-y-4">
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="text-green-500">✓</span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">核心平台架构</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="text-green-500">✓</span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">用户认证系统</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="text-green-500">✓</span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">博客与内容管理</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="text-green-500">✓</span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">深色模式支持</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="hidden lg:flex col-span-2 items-center justify-center">
            <div class="w-4 h-4 bg-green-500 rounded-full border-4 border-neutral-900 dark:border-white"></div>
          </div>
          <div class="col-span-12 lg:col-span-5">
          </div>
        </div>

        <!-- Q2 2026 - In Progress -->
        <div class="grid grid-cols-12 gap-8 items-center mb-20">
          <div class="col-span-12 lg:col-span-5">
          </div>
          <div class="hidden lg:flex col-span-2 items-center justify-center">
            <div class="w-4 h-4 bg-brand-red rounded-full border-4 border-neutral-900 dark:border-white animate-pulse"></div>
          </div>
          <div class="col-span-12 lg:col-span-5">
            <div class="card p-8 lg:p-10">
              <div class="flex items-center justify-start gap-3 mb-6">
                <span class="badge-red">进行中</span>
                <span class="text-xs font-bold uppercase tracking-widest text-neutral-500">2026 Q2</span>
              </div>
              <h3 class="text-title text-neutral-900 dark:text-white mb-6">社区功能</h3>
              <ul class="space-y-4">
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 bg-brand-red rounded-full animate-pulse"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">评论系统增强</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 bg-brand-red rounded-full animate-pulse"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">用户资料与自定义</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="text-green-500">✓</span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">点赞与收藏功能</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">关注系统</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Q3 2026 - Planned -->
        <div class="grid grid-cols-12 gap-8 items-center mb-20">
          <div class="col-span-12 lg:col-span-5 lg:text-right">
            <div class="card p-8 lg:p-10">
              <div class="flex items-center justify-between lg:justify-end gap-3 mb-6">
                <span class="badge">计划中</span>
                <span class="text-xs font-bold uppercase tracking-widest text-neutral-500">2026 Q3</span>
              </div>
              <h3 class="text-title text-neutral-900 dark:text-white mb-6">高级功能</h3>
              <ul class="space-y-4">
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">实时通知</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">内容推荐引擎</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">高级搜索与过滤</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">移动应用</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="hidden lg:flex col-span-2 items-center justify-center">
            <div class="w-4 h-4 bg-neutral-400 rounded-full border-4 border-neutral-900 dark:border-white"></div>
          </div>
          <div class="col-span-12 lg:col-span-5">
          </div>
        </div>

        <!-- Q4 2026 - Planned -->
        <div class="grid grid-cols-12 gap-8 items-center mb-20">
          <div class="col-span-12 lg:col-span-5">
          </div>
          <div class="hidden lg:flex col-span-2 items-center justify-center">
            <div class="w-4 h-4 bg-neutral-400 rounded-full border-4 border-neutral-900 dark:border-white"></div>
          </div>
          <div class="col-span-12 lg:col-span-5">
            <div class="card p-8 lg:p-10">
              <div class="flex items-center justify-start gap-3 mb-6">
                <span class="badge">计划中</span>
                <span class="text-xs font-bold uppercase tracking-widest text-neutral-500">2026 Q4</span>
              </div>
              <h3 class="text-title text-neutral-900 dark:text-white mb-6">规模与影响</h3>
              <ul class="space-y-4">
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">多语言支持</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">合作伙伴集成</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">分析仪表盘</span>
                </li>
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 bg-neutral-400 rounded-full"></span>
                  <span class="text-body text-neutral-600 dark:text-neutral-400">社区管理工具</span>
                </li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Future Vision -->
        <div class="grid grid-cols-12 gap-8 items-center">
          <div class="col-span-12 lg:col-span-5 lg:text-right">
            <div class="card p-8 lg:p-10 bg-brand-red border-none text-white">
              <div class="flex items-center justify-between lg:justify-end gap-3 mb-6">
                <span class="badge bg-white text-brand-red">愿景</span>
                <span class="text-xs font-bold uppercase tracking-widest text-red-200">2027+</span>
              </div>
              <h3 class="text-title mb-6">长期目标</h3>
              <ul class="space-y-4">
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="text-white">✦</span>
                  <span class="text-body text-red-100">全球社区网络</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="text-white">✦</span>
                  <span class="text-body text-red-100">非营利组织合作</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="text-white">✦</span>
                  <span class="text-body text-red-100">影响力测量与报告</span>
                </li>
                <li class="flex items-center lg:justify-end gap-3">
                  <span class="text-white">✦</span>
                  <span class="text-body text-red-100">开源计划</span>
                </li>
              </ul>
            </div>
          </div>
          <div class="hidden lg:flex col-span-2 items-center justify-center">
            <div class="w-4 h-4 bg-brand-red rounded-full border-4 border-neutral-900 dark:border-white shadow-lg"></div>
          </div>
          <div class="col-span-12 lg:col-span-5">
          </div>
        </div>

      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="card p-12 lg:p-16">
          <h2 class="text-title text-neutral-900 dark:text-white mb-6">塑造我们的未来</h2>
          <p class="text-body text-neutral-600 dark:text-neutral-400 mb-8 max-w-xl mx-auto">
            有建议想看到的功能？我们很乐意听取您的意见。
          </p>
          <a href="/contact" class="btn-primary">分享您的想法</a>
        </div>
      </div>
    </section>

  </main>
</Layout>
