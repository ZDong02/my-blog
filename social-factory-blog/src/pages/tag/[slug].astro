---
import Layout from '../../layouts/Layout.astro';

const { slug } = Astro.params;
const title = '标签';
const description = '标签下的文章';

// 预构建常见标签页面
export async function getStaticPaths() {
  const defaultTags = [
    { slug: 'java', params: { slug: 'java' } },
    { slug: 'spring-boot', params: { slug: 'spring-boot' } },
    { slug: 'frontend', params: { slug: 'frontend' } },
    { slug: 'astro', params: { slug: 'astro' } },
    { slug: 'mysql', params: { slug: 'mysql' } },
    { slug: 'tutorial', params: { slug: 'tutorial' } },
    { slug: 'sharing', params: { slug: 'sharing' } },
    { slug: 'life', params: { slug: 'life' } },
  ];

  return defaultTags.map(tag => ({
    params: { slug: tag.params.slug },
    props: { defaultSlug: tag.slug },
  }));
}
---

<Layout title={title} description={description}>
  <main class="min-h-screen">

    <!-- Hero Section -->
    <section class="py-20 lg:py-32 bg-neutral-50 dark:bg-neutral-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <a href="/tags" class="inline-flex items-center gap-2 text-sm font-bold text-brand-red hover:text-brand-red-dark mb-6 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          返回标签列表
        </a>
        <p class="section-subtitle mb-4">Tag</p>
        <h1 id="tagName" class="text-display text-neutral-900 dark:text-white mb-4">
          <span class="gradient-text">标签</span>
        </h1>
        <p id="tagDescription" class="text-subtitle text-neutral-600 dark:text-neutral-400"></p>
      </div>
    </section>

    <!-- Articles Section -->
    <section class="py-20 lg:py-32 bg-neutral-900 dark:bg-neutral-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Loading state -->
        <div id="loading" class="text-center py-20">
          <div class="spinner mx-auto mb-6"></div>
          <p class="text-neutral-500 font-bold uppercase tracking-widest text-sm">正在加载...</p>
        </div>

        <!-- No articles -->
        <div id="noArticles" class="hidden text-center py-20">
          <div class="w-32 h-32 bg-neutral-200 dark:bg-neutral-800 mx-auto mb-8 flex items-center justify-center">
            <svg class="w-16 h-16 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
          </div>
          <h3 class="text-2xl font-black text-neutral-900 dark:text-white mb-4">该标签下暂无文章</h3>
          <p class="text-neutral-500 mb-8">标签将在文章发布后自动生成</p>
          <a href="/blog" class="btn-primary">浏览博客</a>
        </div>

        <!-- Articles -->
        <div id="articles" class="hidden space-y-6"></div>

        <!-- Pagination -->
        <div id="pagination" class="hidden mt-12 flex items-center justify-center gap-4">
          <button id="prevBtn" class="btn-secondary px-6 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
            上一页
          </button>
          <span id="pageInfo" class="text-sm font-bold text-neutral-500 px-4">第 1 页</span>
          <button id="nextBtn" class="btn-secondary px-6 py-3 disabled:opacity-50 disabled:cursor-not-allowed">
            下一页
          </button>
        </div>
      </div>
    </section>

  </main>

  <script>
    import { apiClient } from '../../lib/api.js';

    const pathParts = window.location.pathname.split('/');
    const currentSlug = pathParts[pathParts.length - 2] || pathParts[pathParts.length - 1];
    let currentPage = 1;
    let totalPages = 1;
    let currentTag = null;

    const loadTagAndPosts = async (page = 1) => {
      const loading = document.getElementById('loading');
      const noArticles = document.getElementById('noArticles');
      const articles = document.getElementById('articles');
      const pagination = document.getElementById('pagination');

      loading.classList.remove('hidden');
      noArticles.classList.add('hidden');
      articles.classList.add('hidden');
      pagination.classList.add('hidden');

      try {
        const tagResponse = await apiClient.getTagBySlug(currentSlug);
        if (tagResponse.success && tagResponse.data) {
          currentTag = tagResponse.data;
          document.getElementById('tagName').textContent = `#${currentTag.name}`;
          document.getElementById('tagDescription').textContent = currentTag.description || `查看 "${currentTag.name}" 标签下的所有文章`;
        }

        const postsResponse = await apiClient.getPostsByTag(currentTag?.id || currentSlug, page, 10);
        if (postsResponse.success && postsResponse.data) {
          const { content, total, size, number } = postsResponse.data;
          currentPage = number;
          totalPages = Math.ceil(total / size);

          loading.classList.add('hidden');

          if (!content || content.length === 0) {
            noArticles.classList.remove('hidden');
            return;
          }

          articles.classList.remove('hidden');
          pagination.classList.remove('hidden');

          renderArticles(content);
          document.getElementById('pageInfo').textContent = `第 ${currentPage} 页，共 ${totalPages} 页`;
          document.getElementById('prevBtn').disabled = currentPage <= 1;
          document.getElementById('nextBtn').disabled = currentPage >= totalPages;
        }
      } catch (error) {
        console.error('Failed to load:', error);
        loading.classList.add('hidden');
      }
    };

    const renderArticles = (posts) => {
      const container = document.getElementById('articles');
      let html = '';

      posts.forEach(post => {
        const date = new Date(post.createdAt).toLocaleDateString('zh-TW', {
          year: 'numeric',
          month: 'long',
          day: 'numeric'
        });

        html += `
          <a href="/blog/${post.id}" class="group block card p-6 hover:border-brand-red transition cursor-pointer">
            <div class="flex items-center gap-3 mb-4">
              <span class="badge-red">${post.category?.name || '未分类'}</span>
              <span class="text-xs text-neutral-500">${date}</span>
            </div>
            <h2 class="text-2xl font-black text-neutral-900 dark:text-white mb-3 line-clamp-1 group-hover:text-brand-red transition">${post.title}</h2>
            <p class="text-neutral-600 dark:text-neutral-400 line-clamp-2 mb-4">${post.summary || post.content?.substring(0, 150) || ''}</p>
            <div class="flex items-center gap-6 text-sm text-neutral-500">
              <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                </svg>
                ${post.likeCount || 0}
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
                ${post.commentCount || 0}
              </span>
              <span class="flex items-center gap-1.5">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                </svg>
                ${post.viewCount || 0}
              </span>
            </div>
          </a>
        `;
      });

      container.innerHTML = html;
    };

    document.getElementById('prevBtn')?.addEventListener('click', () => {
      if (currentPage > 1) {
        loadTagAndPosts(currentPage - 1);
      }
    });

    document.getElementById('nextBtn')?.addEventListener('click', () => {
      if (currentPage < totalPages) {
        loadTagAndPosts(currentPage + 1);
      }
    });

    loadTagAndPosts();
  </script>
</Layout>
