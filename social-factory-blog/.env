# =====================================================
# API 配置（本地开发）
# =====================================================
# PUBLIC_API_BASE_URL 保持不设置：
#   前端将使用相对路径 /api，由 astro.config.mjs 的
#   vite.server.proxy 转发到本机后端，无需处理跨域。
#
# SITE_URL（站点地址）默认取 astro.config.mjs，
#   本地为 http://localhost:4321
# =====================================================

# 构建期（SSG）拉取数据用的接口地址，仅 astro build 时使用
BUILD_API_BASE_URL=http://localhost:8080/api
