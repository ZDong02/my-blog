FROM eclipse-temurin:17-jre-alpine

RUN apk add --no-cache tzdata fontconfig freetype ttf-dejavu curl && \
    ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app

RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup

RUN mkdir -p /var/www/blog/uploads && \
    chown -R appuser:appgroup /var/www/blog/uploads

COPY backend.jar app.jar

USER appuser

EXPOSE 8080

ENV JAVA_OPTS="-Xmx768m -Xms256m -XX:+UseG1GC"

ENTRYPOINT ["sh", "-c", "java ${JAVA_OPTS} -jar app.jar"]
