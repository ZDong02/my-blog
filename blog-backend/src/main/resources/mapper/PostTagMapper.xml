<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.blog.mapper.PostTagMapper">

    <!-- 批量插入文章标签关联 -->
    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO post_tags (post_id, tag_id) VALUES
        <foreach collection="postTags" item="postTag" separator=",">
            (#{postTag.postId}, #{postTag.tagId})
        </foreach>
    </insert>

    <!-- 根据文章 ID 删除关联 -->
    <delete id="deleteByPostId">
        DELETE FROM post_tags WHERE post_id = #{postId}
    </delete>

    <!-- 根据标签 ID 删除关联 -->
    <delete id="deleteByTagId">
        DELETE FROM post_tags WHERE tag_id = #{tagId}
    </delete>

    <!-- 统计标签使用次数 -->
    <select id="countByTagId" resultType="int">
        SELECT COUNT(*) FROM post_tags WHERE tag_id = #{tagId}
    </select>

</mapper>
