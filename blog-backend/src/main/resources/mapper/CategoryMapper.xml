<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.blog.mapper.CategoryMapper">

    <resultMap id="CategoryResultMap" type="com.example.blog.entity.Category">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

        <!-- 文章数量统计 -->
        <result property="postCount" column="post_count"/>
    </resultMap>

    <!-- 按名称查询分类 -->
    <select id="selectByName" resultType="com.example.blog.entity.Category">
        SELECT * FROM categories WHERE name = #{name}
    </select>

    <!-- 查询所有分类及文章数量 -->
    <select id="findAllWithPostCount" resultMap="CategoryResultMap">
        SELECT c.*, COUNT(p.id) as post_count
        FROM categories c
        LEFT JOIN posts p ON c.id = p.category_id AND p.status = 'PUBLISHED'
        GROUP BY c.id, c.name, c.description, c.created_at, c.updated_at
        ORDER BY c.name
    </select>

    <!-- 查询分类及文章数量 -->
    <select id="selectWithPostCount" resultMap="CategoryResultMap">
        SELECT c.*, COUNT(p.id) as post_count
        FROM categories c
        LEFT JOIN posts p ON c.id = p.category_id AND p.status = 'PUBLISHED'
        WHERE c.id = #{id}
        GROUP BY c.id, c.name, c.description, c.created_at, c.updated_at
    </select>

</mapper>
